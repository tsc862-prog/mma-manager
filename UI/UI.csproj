<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UI framework not finalised (Avalonia vs WPF — see PROJECT.md Open
         Decisions). Until then this is a plain console host so the solution
         builds with no premature framework dependency. It references everything
         and is referenced by nothing. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MmaManager.UI</RootNamespace>
    <AssemblyName>MmaManager.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Model\Core.Model.csproj" />
    <ProjectReference Include="..\Core.Sim\Core.Sim.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
  </ItemGroup>

</Project>
