<UserControl x:Class="MmaManager.Wpf.Shell.AppWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="OnAnyMouseDown">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="{Binding W}" />
            <Setter Property="Height" Value="{Binding H}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                    <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <!-- Windows arrive, they don't teleport -->
        <Grid.RenderTransform>
            <ScaleTransform x:Name="OpenScale" ScaleX="0.97" ScaleY="0.97" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetName="OpenScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetName="OpenScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Border Background="{StaticResource Bg}" CornerRadius="6" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <!-- the active window wears its APP's colour -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Title bar: drag surface + the window controls -->
                <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource Header}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <!-- The app's identity stripe -->
                        <Border DockPanel.Dock="Left" Width="3" Background="{Binding AccentBrush}" CornerRadius="6,0,0,0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="─" Command="{Binding MinimizeCommand}" Style="{StaticResource ChromeButton}" ToolTip="Minimize" />
                            <Button Command="{Binding MaximizeCommand}" Style="{StaticResource ChromeButton}" ToolTip="Maximize / restore">
                                <Button.Content>❐</Button.Content>
                            </Button>
                            <Button Content="✕" Command="{Binding CloseCommand}" Style="{StaticResource ChromeCloseButton}" ToolTip="Close" />
                        </StackPanel>
                        <Grid>
                            <Thumb DragDelta="OnDragTitle" MouseDoubleClick="OnTitleDoubleClick">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Glyph}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- The app itself -->
                <ContentPresenter Content="{Binding Content}" />
            </DockPanel>
        </Border>

        <!-- Resize grip (floating windows only) -->
        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" DragDelta="OnDragResize">
            <Thumb.Style>
                <Style TargetType="Thumb">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Thumb.Style>
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Path Data="M14,6 L6,14 M14,10 L10,14" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Margin="0,0,2,2" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
