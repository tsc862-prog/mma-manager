<UserControl x:Class="MmaManager.Wpf.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
    <!-- INBOX: the promoter's correspondence. Folders as plain filters on top; letters on the
         left (a face or a desk, the subject, the opening line); the open letter on the right,
         with what can be done about it right inside it. -->
    <Grid DataContext="{Binding Mail}" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,12,16,6">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding HasMail, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource Button.Link}" Content="Mark digests read" Command="{Binding MarkDigestsReadCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasDigestUnread, Converter={StaticResource BoolToVis}}" ToolTip="The weekly digests and wire round-ups" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Mark these read" Command="{Binding MarkShownReadCommand}" Margin="0,0,8,0" Padding="12,4" FontSize="12.5" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Mark all read" Command="{Binding MarkAllReadCommand}" Padding="12,4" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Inbox" Style="{StaticResource Text.Title}" FontSize="22" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" Margin="0,10,0,0"
                         Visibility="{Binding HasMail, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" />
                                <Border x:Name="n" CornerRadius="8" Background="{StaticResource SurfaceSunken}" Padding="6,0" Margin="7,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="nt" Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource TextSoft}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasCount}" Value="True"><Setter TargetName="n" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding HasUnread}" Value="True"><Setter TargetName="nt" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- a founder's first day: no post yet -->
        <controls:EmptyState Grid.Row="1" Icon="Envelope" Title="Your desk is clear."
                             Message="Letters from your staff, your fighters, the board and the sponsors land here as the weeks go by. Anything that needs an answer will say so, and you can answer it right in the letter."
                             Visibility="{Binding NoMail, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="1" Margin="10,0,16,12" Visibility="{Binding HasMail, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.42*" MinWidth="290" MaxWidth="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the letters -->
            <ListBox ItemsSource="{Binding Letters}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                     ItemTemplate="{StaticResource LetterRowTemplate}" ItemContainerStyle="{StaticResource LetterListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
            <controls:EmptyState Icon="Check" Title="Nothing here." Message="No letters in this folder. Everything else is under Everything."
                                 Visibility="{Binding ListEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- the open letter -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="0" Margin="8,0,0,0">
                <Grid>
                    <!-- nothing open: what's waiting on you, one click from the answer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" MaxWidth="560" Margin="0,24">
                            <controls:EmptyState Icon="Envelope" Title="Pick a letter to read it." Message="{Binding Summary}" Margin="0" />
                            <StackPanel Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <TextBlock Text="WAITING ON YOU" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" Margin="16,0,0,6" />
                                <ListBox ItemsSource="{Binding Waiting}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                                         ItemTemplate="{StaticResource LetterRowTemplate}" ItemContainerStyle="{StaticResource LetterListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="28,22,28,24" MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding Selected}">
                            <!-- letterhead -->
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left" Style="{StaticResource Avatar}" Content="{Binding}" Width="56" Height="56" Margin="0,0,14,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FullDate}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="12,4,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Sender}" Style="{StaticResource Text.Heading}" />
                                    <TextBlock Text="{Binding SenderRole}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Subject}" Style="{StaticResource Text.Title}" FontSize="22" Margin="0,18,0,0" />
                            <Border Height="1" Background="{StaticResource PanelEdge}" Margin="0,14,0,14" />
                            <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Body}" LineHeight="22" />

                            <!-- what you can do about it -->
                            <Border CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource CardFill}" BorderBrush="{DynamicResource OrgAccentDim}"
                                    BorderThickness="1" Padding="16,12,16,14" Margin="0,20,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasActions}" Value="False" />
                                                    <Condition Binding="{Binding HasActionNote}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DueText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneWarn}" FontWeight="SemiBold" />
                                        <TextBlock Text="WHAT YOU CAN DO" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ActionNote}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                                               Visibility="{Binding HasActionNote, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0" Focusable="False"
                                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:Name="b" Content="{Binding Text}" Command="{Binding Command}" CommandParameter="{Binding Parameter}"
                                                        Style="{StaticResource Button.Ghost}" Margin="0,0,8,6" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                        <Setter TargetName="b" Property="Style" Value="{StaticResource Button.Primary}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- follow it to who/what it's about -->
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource Button.Chip}" Visibility="{Binding HasFighter, Converter={StaticResource BoolToVis}}" Padding="0" Margin="0,0,8,6"
                                        Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding FighterId}"
                                        ToolTip="Open the profile">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="22" Height="22" Margin="-6,0,7,0">
                                            <Ellipse.Fill><ImageBrush ImageSource="{Binding FighterFace}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding FighterName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Chip}" Visibility="{Binding HasFighter, Converter={StaticResource BoolToVis}}" Margin="0,0,8,6"
                                        Command="{x:Static mvvm:AppCommands.ToggleShortlist}" CommandParameter="{Binding FighterId}"
                                        ToolTip="Pin to your shortlist (Notes app)">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Star" Width="13" Height="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Shortlist" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Chip}" Visibility="{Binding HasEvent, Converter={StaticResource BoolToVis}}" Margin="0,0,8,6"
                                        Command="{x:Static mvvm:AppCommands.OpenEvent}" CommandParameter="{Binding EventId}"
                                        ToolTip="Open the event page">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Calendar" Width="13" Height="13" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding EventName}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
