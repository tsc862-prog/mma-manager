<UserControl x:Class="MmaManager.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls">
    <!-- HOME: walking into your promotion. Built only from the shared blocks in
         App.xaml; panels reflow 1-3 columns with the window (MasonryPanel). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" DataContext="{Binding Dashboard}"
                  Background="{StaticResource Bg}" controls:Adaptive.CompactBelowHeight="820">
        <controls:MasonryPanel Margin="{StaticResource Space.Screen}" MinColumnWidth="390" MaxColumns="3" MaxWidth="2300" Gap="16" EvenBottoms="True">

            <!-- ===== Hero: who you are, what the boss says, and the climb =====
                 (tightens in a short window: Adaptive.IsCompact on the ScrollViewer) -->
            <ContentControl controls:MasonryPanel.FullWidth="True" Style="{StaticResource HeroPanel}" Focusable="False">
                <controls:MasonryPanel MinColumnWidth="430" MaxColumns="2" Gap="36">
                    <!-- Who you are, and the boss talking -->
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource HeroLogo}">
                            <Image Source="{Binding Logo}" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding DateLine}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                            <TextBlock Text="{Binding OrgName}" Style="{StaticResource Text.HeroName}" />
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding TierChip}" Style="{StaticResource Chip.Text}" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding HqChip}" Style="{StaticResource Chip.Text}" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding RankChip}" Style="{StaticResource Chip.Text}" /></Border>
                            </WrapPanel>
                            <DockPanel Margin="0,4,0,0">
                                <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="{DynamicResource OrgAccent}" Margin="0,2,14,2" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource Text.HeroQuote}" />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" ToolTip="{Binding OwnerNote}">
                                        <Run Text="— " /><Run Text="{Binding GreetingFrom, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </DockPanel>
                    <!-- The bank, and the climb -->
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Title}" FontSize="24" Foreground="{StaticResource Gold}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding RosterLine}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <TextBlock Text="IN THE BANK" Style="{StaticResource Text.Kicker}" VerticalAlignment="Top" Margin="0,8,0,0" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource HeroGap}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ClimbLine}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" FontWeight="SemiBold" />
                            <TextBlock Text="THE CLIMB" Style="{StaticResource Text.Kicker}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TierStops}" ItemTemplate="{StaticResource JourneyStripTemplate}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding ClimbDetail}" Style="{StaticResource Text.HeroDetail}" />
                    </StackPanel>
                </controls:MasonryPanel>
            </ContentControl>

            <!-- ===== A founder's first three steps ===== -->
            <Border controls:MasonryPanel.FullWidth="True" Style="{StaticResource Panel}"
                    Visibility="{Binding ShowFirstSteps, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <controls:SectionHeader Title="Your first three steps" Hint="Every promotion in the sport started exactly here." />
                    <ItemsControl ItemsSource="{Binding FirstSteps}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:MasonryPanel MinColumnWidth="250" MaxColumns="3" Gap="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Card}" Padding="16,14" MinHeight="170">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" x:Name="num" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left"
                                                Background="{StaticResource Track}">
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSoft}" x:Name="numText" />
                                        </Border>
                                        <Button DockPanel.Dock="Bottom" x:Name="act" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                                Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed" />
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Title}" FontSize="17" x:Name="label" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                        <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                        <Setter TargetName="num" Property="Background" Value="{DynamicResource OrgAccent}" />
                                        <Setter TargetName="numText" Property="Foreground" Value="#15181D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAction}" Value="True">
                                        <Setter TargetName="act" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="num" Property="Background" Value="{StaticResource ToneGoodDim}" />
                                        <Setter TargetName="numText" Property="Foreground" Value="{StaticResource ToneGood}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Your next card ===== -->
            <Border Style="{StaticResource Panel}" Visibility="{Binding ShowCareerPanels, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <controls:SectionHeader Title="Your next card" />
                    <!-- a card is booked -->
                    <Grid Visibility="{Binding HasNextEvent, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="150" Height="200" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top" Background="{StaticResource SurfaceSunken}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" />
                            </Border.Effect>
                            <Image Source="{Binding Poster}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding NextEventTagline}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NextEventTitle}" Style="{StaticResource Text.Title}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NextEventWhen}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding NextEventWhere}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding NextEventCard}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                            <Button Content="Watch it live ▸" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding WatchTonightCommand}" Visibility="{Binding FightNight, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Open the card ▸" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding BookCommand}" Visibility="{Binding FightNight, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <!-- the main event, face to face -->
                    <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource CardFill}"
                            Visibility="{Binding HasMainEvent, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Link}" Command="{Binding OpenFighterCommand}" CommandParameter="{Binding MainRed.Id}" HorizontalAlignment="Left">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Margin="0,0,10,0">
                                        <Border.Background><ImageBrush ImageSource="{Binding MainRed.Portrait}" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MainRed.Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding MainRed.Line}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Text="VS" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Crimson}"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Link}" Command="{Binding OpenFighterCommand}" CommandParameter="{Binding MainBlue.Id}" HorizontalAlignment="Right">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="46" Height="46" CornerRadius="23" Margin="10,0,0,0">
                                        <Border.Background><ImageBrush ImageSource="{Binding MainBlue.Portrait}" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MainBlue.Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextAlignment="Right" />
                                        <TextBlock Text="{Binding MainBlue.Line}" Style="{StaticResource Text.Caption}" TextAlignment="Right" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- nothing booked -->
                    <controls:EmptyState Icon="Calendar" Title="{Binding NoCardTitle}" Message="{Binding NoCardMessage}"
                                         ActionText="{Binding NoCardAction}" ActionCommand="{Binding NoCardCommand}"
                                         Visibility="{Binding HasNextEvent, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===== Needs you ===== -->
            <Border Style="{StaticResource Panel}" Visibility="{Binding ShowNeedsYou, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <controls:SectionHeader Title="Needs you" Hint="{Binding NeedsYouHint}" />
                    <ItemsControl ItemsSource="{Binding NeedsYouShown}" ItemTemplate="{StaticResource ActionRowTemplate}" Focusable="False" />
                    <Button Content="{Binding NeedsYouMoreText}" Style="{StaticResource Button.Link}" Command="{Binding ToggleNeedsYouCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding HasMoreNeedsYou, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Nothing needs you right now. Advance the calendar when you're ready." Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding NeedsYouEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===== Your people ===== -->
            <Border Style="{StaticResource Panel}" Visibility="{Binding HasPeople, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <controls:SectionHeader Title="Your people" Hint="Who matters this week." ActionText="Whole roster ▸" ActionCommand="{Binding RosterCommand}" />
                    <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource FighterRowCardTemplate}" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- ===== Around the sport ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <controls:SectionHeader Title="Around the sport" Hint="From the FightWire feed." ActionText="All news ▸" ActionCommand="{Binding NewsCommand}" />
                    <ItemsControl ItemsSource="{Binding Headlines}" ItemTemplate="{StaticResource HeadlineCardTemplate}" Focusable="False" />
                </StackPanel>
            </Border>

            <!-- ===== The ladder: your neighbours ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <controls:SectionHeader Title="The ladder" Hint="Where you stand among the promotions of the world."
                                            ActionText="{Binding LadderToggleText}" ActionCommand="{Binding ToggleLadderCommand}" />
                    <ItemsControl Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsSource" Value="{Binding LadderNear}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LadderExpanded}" Value="True">
                                        <Setter Property="ItemsSource" Value="{Binding Ladder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" CornerRadius="6" Padding="8,6" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RankText}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Image Grid.Column="1" Source="{Binding Logo}" Width="28" Height="28" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Tier}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Prestige}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" />
                                            <TextBlock Text="prestige" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                        <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Visit the Organizations pages ▸" Style="{StaticResource Button.Link}" Command="{Binding OrgsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Goals: the owner's objectives + career milestones ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <controls:SectionHeader Title="Goals" Hint="What's expected of you this year, and what you've achieved." ActionText="HQ ▸" ActionCommand="{Binding OrgCommand}" />
                    <ItemsControl ItemsSource="{Binding Objectives}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <controls:Icon DockPanel.Dock="Left" Kind="Check" Width="16" Height="16" Brush="{DynamicResource OrgAccent}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="by " /><Run Text="{Binding Deadline, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Status, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MilestoneLine}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="MILESTONES" Style="{StaticResource Text.Kicker}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Milestones}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="chip" Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon x:Name="i" Kind="{Binding Icon}" Width="13" Height="13" Brush="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                                        <TextBlock x:Name="t" Text="{Binding Title}" Style="{StaticResource Chip.Text}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Earned}" Value="True">
                                        <Setter TargetName="chip" Property="Background" Value="{StaticResource ToneWarnDim}" />
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Gold}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="i" Property="Brush" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </controls:MasonryPanel>
    </ScrollViewer>
</UserControl>
