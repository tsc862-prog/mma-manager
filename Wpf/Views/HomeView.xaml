<UserControl x:Class="MmaManager.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding Dashboard}" HorizontalAlignment="Left" MaxWidth="2060">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: who you are -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="56" Height="56" Margin="0,0,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding OrgName}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding OrgTagline}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Prestige" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding Prestige, Mode=OneWay}" Maximum="100" Height="10" Margin="0,3" Foreground="{StaticResource Gold}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Prestige}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Reputation" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Reputation, Mode=OneWay}" Maximum="100" Height="10" Margin="0,3" Foreground="{StaticResource Positive}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Reputation}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{Binding TierLine}" FontSize="11.5" Foreground="{StaticResource World}" Margin="0,8,0,2" />
                        <ProgressBar Value="{Binding TierProgress, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource World}" Background="{StaticResource Track}" BorderThickness="0" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding RosterLine}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MilestoneLine}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Text="Milestones" FontWeight="SemiBold" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Milestones}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3,6,0" Padding="6,2" CornerRadius="3" Background="{StaticResource Track}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Mark}" FontSize="11" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Title}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5C646E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Earned}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- THE DESK: calls only the owner can make -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeskHasCalls}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="THE DESK — your call" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Desk}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Due}" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Do it" Padding="12,3" FontWeight="SemiBold"
                                                        Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}"
                                                        Command="{Binding DataContext.AcceptDecisionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Pass" Padding="12,3" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeclineDecisionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Owner objectives" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Objectives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding Deadline, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Status, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Open ▸" Command="{Binding InboxCommand}" Padding="8,2" />
                            <TextBlock Text="Inbox" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding InboxLine}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,6" />
                        <ItemsControl ItemsSource="{Binding RecentMail}" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding From, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding When, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Column 1: what's next + the world talking -->
            <DockPanel Grid.Column="1" Margin="0,0,10,0">
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Book Event ▸" Command="{Binding BookCommand}" VerticalAlignment="Top" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="NEXT EVENT" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding NextEventTitle}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding NextEventLine}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NextEventMain}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Headlines" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Headlines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Category, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AboutPlayer}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Column 2: the ladder, your belts, deals running out -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="The ladder" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Ladder}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="4,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Selection}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Logo}" Width="24" Height="24" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Prestige}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Balance}" VerticalAlignment="Center" TextAlignment="Right" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Your champions" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Champions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3" Background="Transparent" Cursor="Hand"
                                               ToolTip="Double-click for the full profile">
                                        <DockPanel.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding FighterId}" />
                                        </DockPanel.InputBindings>
                                        <Image DockPanel.Dock="Left" Source="{Binding Portrait}" Width="36" Height="36" Margin="0,0,10,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                                <Run Text="{Binding Division, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Record, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Contracts ▸" Command="{Binding ContractsCommand}" Padding="8,2" />
                            <TextBlock Text="Deals running out" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Expiring}" Margin="0,6,0,0" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3" Background="Transparent" Cursor="Hand"
                                                ToolTip="Double-click for the full profile">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding FighterId}" />
                                        </StackPanel.InputBindings>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding Division, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Deal, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
</UserControl>
