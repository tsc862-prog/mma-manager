<UserControl x:Class="MmaManager.Wpf.Views.WorldMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             xmlns:map="clr-namespace:MmaManager.Wpf.Map"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
    <UserControl.Resources>
        <!-- A place (region / country / city) card: the List view's grid and the rail beside a zoomed map. -->
        <DataTemplate x:Key="PlaceCardTemplate">
            <Button Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Margin="6" CornerRadius="7" Background="{StaticResource Surface}"
                                MinHeight="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" MinWidth="300" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlayerHere}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Drillable}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="Card" Property="Background" Value="#1E242C" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding HeatBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{Binding TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Style="{StaticResource HomePill}" Margin="6,0,0,0"
                                    Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" ToolTip="Home town">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Kind="Home" Width="12" Height="12" Brush="{StaticResource Gold}" StrokeThickness="2.2" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="HOME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Interest}" FontWeight="Bold" FontSize="22" Foreground="{Binding TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       ToolTip="{Binding ValueTip}" />
                            <TextBlock Grid.Column="3" Text="{Binding Chevron}" FontSize="22" Foreground="{Binding TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding OrgSummary}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="12,8,12,0" TextWrapping="Wrap" />
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Orgs}" Margin="12,4,12,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Abbrev}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="3" BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0" Padding="12,6">
                        <StackPanel>
                            <TextBlock Text="{Binding CitiesHeader}" Foreground="{StaticResource TextMuted}" FontSize="9" />
                            <TextBlock Text="{Binding CitiesLine}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

        <Grid Margin="8" DataContext="{Binding WorldMap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,0,8">
                <DockPanel>
                    <!-- What the map is coloured by: siblings in one panel (never a named group) -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center" Margin="16,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedOption}" IsChecked="{Binding IsInterestLayer}"
                                         ToolTip="How fight-mad each place is">MMA interest</RadioButton>
                            <RadioButton Style="{StaticResource SegmentedOption}" IsChecked="{Binding IsPromotionLayer}"
                                         Visibility="{Binding CanShowPromotion, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Where your promotion's name is known: the question to ask before picking a city for a card">Where I'm known</RadioButton>
                            <RadioButton Style="{StaticResource SegmentedOption}" IsChecked="{Binding IsFighterLayer}"
                                         Visibility="{Binding CanShowFighter, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Where this fighter's name is known (open any profile's 'Where he's known' to change who)">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Kind="Flame" Width="13" Height="13" Brush="{StaticResource DrawInk}" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FighterLayerLabel}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="The Global Scene" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="12,0,0,2" />
                        <!-- Legend: MMA interest -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0"
                                    Visibility="{Binding IsInterestLayer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MMA interest:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="11" />
                            <Border Width="16" Height="12" Background="#2C5F8A" />
                            <TextBlock Text="cool" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="4,0,10,0" VerticalAlignment="Center" />
                            <Border Width="16" Height="12" Background="#8A5B58" />
                            <Border Width="16" Height="12" Background="#C0392B" />
                            <TextBlock Text="fight-mad" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Legend: fame (the same ramp the cards are drawn with) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0"
                                    Visibility="{Binding IsFameLayer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fame:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,-2,8,0" FontSize="11" />
                            <ItemsControl ItemsSource="{Binding FameLegend}" ItemTemplate="{StaticResource FameLegendStopTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Whose heat this is: the face (or the logo), the name, where it carries, home -->
                <Border Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="8"
                        Padding="0" Margin="0,12,6,0" Visibility="{Binding IsFameLayer, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border x:Name="face" DockPanel.Dock="Left" Width="96" Height="104" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                            <Image Source="{Binding SubjectPicture}" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Stretch" Value="UniformToFill" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Style.Triggers>
                                            <!-- a logo is shown whole, padded, not cropped like a face -->
                                            <DataTrigger Binding="{Binding SubjectPictureIsLogo}" Value="True">
                                                <Setter Property="Stretch" Value="Uniform" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="10" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,14,0">
                            <Button Content="{Binding OpenSubjectText}" Command="{Binding OpenSubjectCommand}" Style="{StaticResource Button.Soft}" Padding="12,4" Margin="0,0,0,6" />
                            <Button Content="‹ Back to MMA interest" Command="{Binding BackToInterestCommand}" Style="{StaticResource Button.Ghost}" Padding="12,4"
                                    ToolTip="The plain map: how fight-mad each place is" />
                        </StackPanel>
                        <StackPanel Margin="16,10,8,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SubjectKicker}" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource DrawInk}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SubjectName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <controls:DrawMeter Value="{Binding SubjectDraw}" ShowNumber="True" Margin="16,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowSubjectDraw, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock x:Name="line" Text="{Binding SubjectLine}" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasSubjectHome, Converter={StaticResource BoolToVis}}">
                                <controls:Icon Kind="Home" Width="14" Height="14" Brush="{StaticResource Gold}" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SubjectHome}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- The hottest cities, as chips (each opens its country) -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasHotSpots, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding HotSpotsHeader}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding HotSpots}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HotSpotChip}"
                                        Command="{Binding DataContext.HotSpotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Word}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Breadcrumb + level hint; Map | List on the right -->
                <DockPanel Margin="0,8,6,0">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MapListToggle}" IsChecked="{Binding ShowList}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Breadcrumb}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource CrumbButton}" />
                                        <TextBlock Text="  ›  " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LevelHint}" Foreground="{StaticResource TextMuted}" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- The List: the place cards, four across -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource PlaceCardTemplate}" Tag="210" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- The Map: the drawn world (zoomed to a region when drilled), the drilled place's cards beside it -->
            <Grid Grid.Row="1" Visibility="{Binding ShowMap, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,6,6">
                    <map:WorldMapCanvas Spots="{Binding MapSpots}" RegionLabels="{Binding MapRegions}" CountryFills="{Binding MapFills}"
                                        Focus="{Binding MapFocus}" FocusCountry="{Binding MapFocusCountry}"
                                        HoverSpot="{Binding HoverSpot}" HoverCountry="{Binding HoverCountry}"
                                        SpotCommand="{Binding MapSpotCommand}" CountryCommand="{Binding MapCountryCommand}" RegionCommand="{Binding MapRegionCommand}">
                        <map:WorldMapCanvas.HoverCard>
                            <Border Style="{StaticResource MapHoverCard}" Visibility="{Binding HasHover, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HoverTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource HomePill}" Margin="8,0,0,0" Visibility="{Binding HoverIsHome, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Kind="Home" Width="12" Height="12" Brush="{StaticResource Gold}" StrokeThickness="2.2" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding HoverHomeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HoverWhere}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,1,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Width="11" Height="11" CornerRadius="6" Background="{Binding HoverValueBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding HoverValue}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding HoverSecond}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding HoverOrgs}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding HoverHint}" Foreground="{StaticResource Steel}" FontSize="11" FontStyle="Italic" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </map:WorldMapCanvas.HoverCard>
                    </map:WorldMapCanvas>
                </Border>
                <DockPanel Grid.Column="1" Width="330" Margin="2,0,0,6" Visibility="{Binding ShowRail, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RailHeader}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="8,0,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource PlaceCardTemplate}" Tag="150" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
</UserControl>
