<UserControl x:Class="MmaManager.Wpf.Views.OrgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <DockPanel Margin="8" DataContext="{Binding Org}" HorizontalAlignment="Left" MaxWidth="1380">
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Identity}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Prestige" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="24,0,6,0" />
                    <ProgressBar Width="130" Height="10" Maximum="100" Value="{Binding Prestige, Mode=OneWay}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Prestige}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="Reputation" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="18,0,6,0" />
                    <ProgressBar Width="130" Height="10" Maximum="100" Value="{Binding Reputation, Mode=OneWay}" Foreground="{StaticResource Positive}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Reputation}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Border Width="1" Background="{StaticResource Border}" Margin="18,2,14,2" />
                    <StackPanel VerticalAlignment="Center" MinWidth="150">
                        <TextBlock Text="{Binding TierLine}" FontSize="11" Foreground="{StaticResource World}" />
                        <ProgressBar Width="150" Height="6" Maximum="100" Value="{Binding TierProgress, Mode=OneWay}" Foreground="{StaticResource World}" Background="{StaticResource Track}" BorderThickness="0" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Step up a tier — only when eligible (you've maxed the current one) -->
            <Border DockPanel.Dock="Top" Background="#20321F" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                    CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanPromote}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⬆ Eligible to promote" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        <TextBlock Text="{Binding PromotionLine}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Take the leap" Command="{Binding AcceptPromotionCommand}"
                            Padding="14,6" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- ============ Column 0: THE HOUSE — who we are ============ -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THE HOUSE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <!-- Biographer.Promotion leads with the authored lore, then the live career line. -->
                        <TextBlock Text="{Binding Story}" Foreground="#D6DADF" TextWrapping="Wrap" LineHeight="18" />
                        <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,8" />
                        <TextBlock Text="{Binding HistoryLine}" FontSize="12" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- The poster wall: the last six nights out -->
                <Border VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPosters}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="THE POSTER WALL" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding PosterWall}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="112" Margin="0,0,10,10" ToolTip="{Binding Caption}">
                                        <Border Background="#0B0C10" BorderBrush="#2A2F38" BorderThickness="1" Padding="2">
                                            <Image Source="{Binding Poster}" Height="146" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource TextFaint}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- ============ Column 1: THE BELTS — every strap in the house ============ -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" VerticalAlignment="Top">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="THE BELTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                Visibility="{Binding HasBeltless, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Weight classes on the roster without a sanctioned belt:"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding BeltCostLine}" Command="{Binding CreateTitleCommand}"
                                    ToolTip="Sanction a new championship — the division gets a vacant belt; the first title fight crowns the champion"
                                    Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding BeltlessDivisions}" SelectedItem="{Binding SelectedBeltless}" />
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                        <ItemsControl ItemsSource="{Binding Belts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Prestige}" Foreground="{StaticResource Gold}" FontWeight="Bold"
                                                           VerticalAlignment="Center" ToolTip="Belt prestige — the strap's own name in the sport" />
                                                <TextBlock Text="{Binding BeltName}" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Division}" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,1,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChampion}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Image Source="{Binding ChampPortrait}" Width="38" Height="38" Margin="0,0,8,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👑 " FontSize="12" />
                                                        <TextBlock Text="{Binding ChampName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ChampRecord}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReignLine}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Vacant — the belt is waiting for a champion" FontSize="11.5" Foreground="{StaticResource TextMuted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChampion}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding LineageLine}" FontSize="10.5" Foreground="{StaticResource TextFaint}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LineageLine}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Column 2: OPERATIONS — rules, marketing, staff ============ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="House rules" FontWeight="Bold" />
                        <TextBlock Text="How your promotion runs its fights. Applies to every card you book from here on."
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Round length" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <ComboBox Width="70" ItemsSource="{Binding RoundMinuteOptions}" SelectedItem="{Binding RoundMinutes}" />
                                <TextBlock Text="minutes" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Standard bout" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <ComboBox Width="70" ItemsSource="{Binding StandardRoundOptions}" SelectedItem="{Binding StandardRounds}" />
                                <TextBlock Text="rounds" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Title fight" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <ComboBox Width="70" ItemsSource="{Binding TitleRoundOptions}" SelectedItem="{Binding TitleRounds}" />
                                <TextBlock Text="rounds" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Fight of the Night" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       ToolTip="Paid to BOTH fighters of each card's best fight. 0 = none." />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="$" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="90" Text="{Binding FightOfNightBonus, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="each, to the night's best fight" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="7" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Brand Marketing" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="$" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="120" Text="{Binding MarketingBudget, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="/ month — pour it in to fill seats and climb faster"
                                       FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MarketingEffect}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="16" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Your staff" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding MyStaff}" SelectedItem="{Binding SelectedStaff}"
                          IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="140" Margin="0,0,0,6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="70" />
                        <DataGridTextColumn Header="Salary/mo" Binding="{Binding Salary}" SortMemberPath="SalarySort" Width="110" />
                        <DataGridTextColumn Header="Background" Binding="{Binding Background}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Release selected staff" Command="{Binding FireCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <TextBlock Text="Owner objectives" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Objectives}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Objective" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="By" Binding="{Binding Deadline}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Available staff" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Market}" SelectedItem="{Binding SelectedMarket}" IsReadOnly="True"
                          AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="240">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="70" />
                        <DataGridTextColumn Header="Salary/mo" Binding="{Binding Salary}" SortMemberPath="SalarySort" Width="120" />
                        <DataGridTextColumn Header="Background" Binding="{Binding Background}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Content="Hire selected" Command="{Binding HireCommand}" Padding="14,3" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Positive}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </DockPanel>
</UserControl>
