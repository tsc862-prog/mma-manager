<UserControl x:Class="MmaManager.Wpf.Views.FightersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Division:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="190" ItemsSource="{Binding RosterFilters}" SelectedItem="{Binding RosterFilter}" />
                <CheckBox Content="My fighters only" IsChecked="{Binding MyRosterOnly}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Content="View Profile >" Command="{Binding ViewProfileCommand}" Margin="12,0,0,0" />
                <Button Content="☆ Shortlist" Command="{Binding ToggleShortlistCommand}"
                        CommandParameter="{Binding SelectedFighter.Id}" Margin="6,0,0,0"
                        ToolTip="Pin the selected fighter to the Notes app shortlist" />
                <TextBlock Text="(or double-click a fighter)" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Roster}" SelectedItem="{Binding SelectedFighter}"
                      RowHeight="40" mvvm:FighterLink.OpenOnDoubleClick="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Portrait}" Width="34" Height="34" Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Honors" Binding="{Binding Badges}" Width="76" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" />
                    <DataGridTextColumn Header="Division" Binding="{Binding Division}" />
                    <DataGridTextColumn Header="Style" Binding="{Binding Style}" />
                    <DataGridTextColumn Header="Scout" Binding="{Binding Ovr}" />
                    <DataGridTextColumn Header="Record" Binding="{Binding Record}" SortMemberPath="RecordSort"/>
                    <DataGridTemplateColumn Header="Form" Width="66">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Form}" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cold}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Org" Binding="{Binding Org}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
</UserControl>
