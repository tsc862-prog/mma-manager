<UserControl x:Class="MmaManager.Wpf.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls">
    <!-- NEWS: FightWire, the sport's wire on the promoter's desktop. Masthead and plain
         filters on top; the lead story and the wire (grouped by day or kind) scroll below. -->
    <Grid DataContext="{Binding News}" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,12,16,4">
            <StackPanel>
                <!-- masthead -->
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center" ToolTip="How the wire is grouped">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedOption}" Content="By day" GroupName="newsGroup" IsChecked="{Binding ByDay}" />
                            <RadioButton Style="{StaticResource SegmentedOption}" Content="By kind" GroupName="newsGroup" IsChecked="{Binding ByKind}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Crimson}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <controls:Icon Kind="Newspaper" Width="24" Height="24" Brush="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Title}" FontSize="24" FontWeight="Bold">
                                <Run Text="FIGHT" /><Run Text="WIRE" Foreground="{StaticResource Crimson}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Caption}">
                                <Run Text="The fight game, covered  ·  " /><Run Text="{Binding DateLine, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- plain filters -->
                <WrapPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource Segmented}" Margin="0,0,14,6" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedOption}" Content="Everything" GroupName="newsWho" IsChecked="{Binding WhoEverything}" />
                            <RadioButton Style="{StaticResource SegmentedOption}" Content="My promotion" GroupName="newsWho" IsChecked="{Binding WhoMine}" />
                            <RadioButton Style="{StaticResource SegmentedOption}" Content="My fighters" GroupName="newsWho" IsChecked="{Binding WhoMyFighters}" />
                        </StackPanel>
                    </Border>
                    <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding DivisionOptions}" SelectedItem="{Binding Division}" VerticalAlignment="Top" ToolTip="Stories about fighters in one division" />
                </WrapPanel>
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" />
                <TextBlock Text="{Binding CountLine}" Style="{StaticResource Text.Caption}" Margin="2,0,0,0" />
            </StackPanel>
        </Border>

        <controls:CardWall Grid.Row="1" ItemsSource="{Binding Items}" CardWidth="420" Padding="16,8,4,8"
                           CardTemplate="{StaticResource StoryCardTemplate}" BannerTemplate="{StaticResource LeadStoryTemplate}" />

        <controls:EmptyState Grid.Row="1" Icon="Newspaper" Title="Quiet on the wire." Message="{Binding EmptyMessage}"
                             ActionText="Show everything" ActionCommand="{Binding ShowEverythingCommand}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
