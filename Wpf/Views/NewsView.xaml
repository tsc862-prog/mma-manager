<UserControl x:Class="MmaManager.Wpf.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <!-- The browser: chrome on top, FIGHTWIRE — the sport's paper of record — inside. -->
        <DockPanel DataContext="{Binding News}">

            <!-- Browser chrome -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="←" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="6,0" />
                        <TextBlock Text="→" Foreground="{StaticResource TextMuted}" FontSize="14" Margin="6,0" />
                        <TextBlock Text="⟳" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="6,0,10,0" />
                    </StackPanel>
                    <Border Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🔒" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- The site -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#EFEAE0">
                <StackPanel MaxWidth="960" Margin="28,18,28,30" HorizontalAlignment="Center">

                    <!-- Masthead -->
                    <TextBlock Text="FIGHTWIRE" FontFamily="Georgia" FontWeight="Bold" FontSize="38" TextAlignment="Center" Foreground="#211D15" />
                    <TextBlock Text="THE FIGHT GAME, COVERED — SINCE 1998" FontSize="10" TextAlignment="Center"
                               Foreground="#8A8272" Margin="0,2,0,10" />
                    <Border Height="2" Background="#211D15" Margin="0,0,0,1" />
                    <Border Height="1" Background="#C9C2B0" Margin="0,2,0,8" />

                    <!-- Section nav: the filters, worn as the site's sections -->
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding MineOnly}" VerticalAlignment="Center">
                            <TextBlock Text="★ MY PROMOTION" FontSize="11" FontWeight="Bold" Foreground="#8A6D1F" />
                        </CheckBox>
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,2" Margin="0,0,16,4">
                                                    <TextBlock x:Name="t" Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="#6E675A" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="t" Property="Foreground" Value="#211D15" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#1D5FAE" />
                                                        <Setter TargetName="t" Property="Foreground" Value="#211D15" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- The stories -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D8D1C0" BorderThickness="0,0,0,1" Padding="0,12,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#1D5FAE" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AboutPlayer}" Value="True">
                                                                <Setter Property="Foreground" Value="#8A6D1F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding When}" FontSize="10.5" Foreground="#8A8272" Margin="10,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Headline}" FontFamily="Georgia" FontSize="19" TextWrapping="Wrap" Margin="0,4,0,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#211D15" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AboutPlayer}" Value="True">
                                                            <Setter Property="Foreground" Value="#8A6D1F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}" FontSize="12.5" Foreground="#4A463C"
                                                   TextWrapping="Wrap" LineHeight="18" />

                                        <!-- Story links: the site's "read more" row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Cursor="Hand" FontSize="11.5" Foreground="#1D5FAE" Margin="0,0,16,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFighterLink}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding FighterLinkId}" />
                                                </TextBlock.InputBindings>
                                                Fighter profile →
                                            </TextBlock>
                                            <TextBlock Cursor="Hand" FontSize="11.5" Foreground="#8A6D1F" Margin="0,0,16,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFighterLink}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.ToggleShortlistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding FighterLinkId}" />
                                                </TextBlock.InputBindings>
                                                ☆ Shortlist
                                            </TextBlock>
                                            <TextBlock Cursor="Hand" FontSize="11.5" Foreground="#1D5FAE">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasEventLink}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding EventLinkId}" />
                                                </TextBlock.InputBindings>
                                                Event coverage →
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="© FightWire Media. All the sport, none of the mercy."
                               FontSize="10" Foreground="#8A8272" TextAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
</UserControl>
