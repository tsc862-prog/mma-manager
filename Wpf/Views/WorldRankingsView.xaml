<UserControl x:Class="MmaManager.Wpf.Views.WorldRankingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding WorldRankings}" HorizontalAlignment="Left" MaxWidth="1200">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Pound-for-pound" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding PoundForPound}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" mvvm:FighterLink.OpenOnDoubleClick="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" SortMemberPath="RankSort" Width="40" />
                        <DataGridTextColumn Header="Fighter" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Div" Binding="{Binding Division}" Width="110" />
                        <DataGridTextColumn Header="Org" Binding="{Binding Org}" Width="70" />
                        <DataGridTextColumn Header="Scout" Binding="{Binding Ovr}" Width="50" />
                        <DataGridTextColumn Header="Record" Binding="{Binding Record}" SortMemberPath="RecordSort" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Division rankings" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <ComboBox Width="150" ItemsSource="{Binding Divisions}" SelectedItem="{Binding SelectedDivision}" Margin="10,0,0,0" HorizontalAlignment="Left" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Division}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" mvvm:FighterLink.OpenOnDoubleClick="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" SortMemberPath="RankSort" Width="40" />
                        <DataGridTextColumn Header="Fighter" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Org" Binding="{Binding Org}" Width="70" />
                        <DataGridTextColumn Header="Scout" Binding="{Binding Ovr}" Width="50" />
                        <DataGridTextColumn Header="Record" Binding="{Binding Record}" SortMemberPath="RecordSort" Width="90" />
                        <DataGridTextColumn Header="Fame" Binding="{Binding Fame}" Width="55" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
</UserControl>
