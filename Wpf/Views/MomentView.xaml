<UserControl x:Class="MmaManager.Wpf.Views.MomentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MmaManager.Wpf.ViewModels"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}"
             controls:Adaptive.CompactBelowHeight="760">
    <!-- THE MOMENT: the dimmed desk and one poster card. DataContext = MomentsViewModel;
         the card draws Current through the template for its type (every kind can use
         the shared poster below, or add its own DataTemplate here). -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MomentViewModel}">
            <Border Style="{StaticResource MomentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.37*" MinWidth="250" />
                        <ColumnDefinition Width="0.63*" />
                    </Grid.ColumnDefinitions>

                    <!-- The person: full-body art standing in the org's light. -->
                    <Rectangle Fill="{DynamicResource OrgAccent}" Opacity="0.55" IsHitTestVisible="False">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.62" RadiusY="0.55">
                                <GradientStop Color="#A0000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Image Source="{Binding Art}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           Margin="18,26,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Feet fade into the card floor. -->
                    <Rectangle Height="70" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0013161B" Offset="0" />
                                <GradientStop Color="#E013161B" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="12,30,40,30" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Kicker}" Style="{StaticResource Text.MomentKicker}" />
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Moment}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.MomentName}" />
                            <DockPanel Margin="0,6,0,0">
                                <Image DockPanel.Dock="Left" Source="{Binding OrgLogo}" Width="26" Height="26" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" TextTrimming="None">
                                    <Run Text="{Binding Subline, Mode=OneWay}" Foreground="{DynamicResource OrgAccent}" />
                                    <Run Text="  ·  " Foreground="{StaticResource TextSecondary}" />
                                    <Run Text="{Binding Org, Mode=OneWay}" Foreground="{StaticResource TextSoft}" FontWeight="Normal" />
                                </TextBlock>
                            </DockPanel>

                            <!-- In their own words -->
                            <StackPanel x:Name="quote" Style="{StaticResource MomentGap}">
                                <TextBlock Text="{Binding Quote}" Style="{StaticResource Text.HeroQuote}" FontSize="17" />
                                <TextBlock Text="{Binding QuoteBy, StringFormat=— {0}}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- The lineage -->
                            <StackPanel x:Name="strip" Style="{StaticResource MomentGap}">
                                <TextBlock Text="{Binding StripLabel}" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Strip}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="link" Style="{StaticResource Button.Chip}" Margin="0,0,8,6" Padding="0"
                                                    Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FighterId}" ToolTip="Open the profile">
                                                <StackPanel Orientation="Horizontal" Margin="-6,-1,4,0">
                                                    <ContentControl Style="{StaticResource Avatar}" Content="{Binding}" Width="28" Height="28" />
                                                    <TextBlock x:Name="who" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                                </StackPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="who" Property="Foreground" Value="{DynamicResource OrgAccent}" />
                                                    <Setter TargetName="link" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- What it means -->
                            <ItemsControl ItemsSource="{Binding Facts}" Style="{StaticResource MomentGap}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}" Padding="14,11,14,12" Margin="0,0,10,0" Background="{StaticResource CardFill}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Kicker}" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Heading}" Margin="0,4,0,0" />
                                                <TextBlock x:Name="detail" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                                <Setter TargetName="detail" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The other corner's word -->
                            <DockPanel x:Name="answer" Style="{StaticResource MomentGap}">
                                <Ellipse DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top" Stroke="{StaticResource PanelEdge}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Answer.Picture}" Stretch="UniformToFill" AlignmentY="Top" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Answer.Text}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" FontSize="14" />
                                    <TextBlock Text="{Binding Answer.By, StringFormat=— {0}}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="also" Text="{Binding AlsoLine}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" />

                            <!-- Out -->
                            <WrapPanel Style="{StaticResource MomentGap}">
                                <Button x:Name="go" Content="Continue" Style="{StaticResource Button.Primary}" Margin="0,0,10,6" MinWidth="130"
                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button x:Name="profile" Content="{Binding SubjectButton}" Style="{StaticResource Button.Ghost}" Margin="0,0,10,6"
                                        Command="{Binding DataContext.OpenSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button x:Name="card" Content="The event page" Style="{StaticResource Button.Ghost}" Margin="0,0,14,6"
                                        Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Text="Esc, Enter or Space to carry on" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasStrip}" Value="False"><Setter TargetName="strip" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasAnswer}" Value="False"><Setter TargetName="answer" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasAlso}" Value="False"><Setter TargetName="also" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding SubjectId}" Value="{x:Null}"><Setter TargetName="profile" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding EventId}" Value="{x:Null}"><Setter TargetName="card" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The dimmed desk: a click anywhere off the card carries on. -->
        <Border Background="{StaticResource MomentScrim}" Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DismissCommand}" />
            </Border.InputBindings>
        </Border>
        <ContentControl x:Name="Card" Content="{Binding Current}" Focusable="False"
                        MaxWidth="1340" MaxHeight="860" Margin="28,22" />
    </Grid>
</UserControl>
