<UserControl x:Class="MmaManager.Wpf.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <UserControl.Resources>
            <!-- One red-vs-blue compare line, shared by the tale of the tape,
                 the judges' card, and the post-fight stats. -->
            <DataTemplate x:Key="CompareRow">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Red}" TextAlignment="Right" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RedBold}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Blue}" TextAlignment="Left" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlueBold}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </UserControl.Resources>
        <!-- Stretch (not Left) so the play-by-play column actually fills
             the window; the cap keeps ultrawides from absurd line lengths. -->
        <Grid Margin="8" DataContext="{Binding Watch}" MaxWidth="1780">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="620" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox Width="90" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" Margin="0,0,10,0" />
                    <Button Content="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}" Width="70" />
                    <Button Content="Skip" Command="{Binding SkipCommand}" Margin="6,0,0,0" />
                    <Button Content="Restart" Command="{Binding RestartCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource OrgAccent}" />
            </DockPanel>

            <!-- Right rail: the cage-side panel + the running order below it -->
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">

            <!-- Cage-side: tonight's poster during the cold open, then the
                 walkout card once the first bout is announced. -->
            <Grid DockPanel.Dock="Top">

                <!-- The cage-side panel: who's in there now, and how it ended. -->
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource SurfaceSunken}" Padding="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentBout}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="NOW IN THE CAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding CurrentBout.Billing}" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,4,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Image Source="{Binding CurrentBout.RedBody}" Height="250">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <!-- the loser fades once it's over -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowResult}" Value="True" />
                                                    <Condition Binding="{Binding CurrentBout.BlueWon}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0.35" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding CurrentBout.RedName}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#E88A80" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentBout.RedRecord}" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="🏆 WINNER" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Positive}" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowResult}" Value="True" />
                                                    <Condition Binding="{Binding CurrentBout.RedWon}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="vs" Foreground="#7C848D" FontSize="18" VerticalAlignment="Center" Margin="10,0" />
                        <StackPanel Grid.Column="2">
                            <Image Source="{Binding CurrentBout.BlueBody}" Height="250">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowResult}" Value="True" />
                                                    <Condition Binding="{Binding CurrentBout.RedWon}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0.35" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding CurrentBout.BlueName}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#82AEE8" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentBout.BlueRecord}" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="🏆 WINNER" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Positive}" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowResult}" Value="True" />
                                                    <Condition Binding="{Binding CurrentBout.BlueWon}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Pre-fight: the tale of the tape (hidden once it's over) -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResult}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding CurrentBout.Tale}" ItemTemplate="{StaticResource CompareRow}" />
                    </StackPanel>

                    <!-- The judges' card, filling in round by round -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <!-- nothing scored yet (early rounds / quick finish) -->
                                    <DataTrigger Binding="{Binding CurrentBout.Scorecard.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="JUDGES' CARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding CurrentBout.Scorecard}" ItemTemplate="{StaticResource CompareRow}" />
                    </StackPanel>

                    <!-- Post-fight: the result, the stars, and the numbers -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding CurrentBout.ResultText}" Foreground="#7BE0A0" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentBout.Stars}" Foreground="{StaticResource Gold}" FontSize="18" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding CurrentBout.Stats}" ItemTemplate="{StaticResource CompareRow}" />
                    </StackPanel>
                </StackPanel>
                </Border>

                <!-- The cold open: tonight's one-sheet, up until the first walkouts -->
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource SurfaceSunken}" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCard}" Value="True" />
                                        <Condition Binding="{Binding CurrentBout}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="TONIGHT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                        <Image Source="{Binding Poster}" MaxHeight="360" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The running order: results fill in as the broadcast reaches them,
                 so once the card is over this IS the full results sheet. -->
            <Border Margin="0,10,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource SurfaceSunken}" Padding="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCard}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="FINAL" FontSize="11" FontWeight="Bold" Foreground="#7BE0A0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardOver}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="THE CARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" Width="22" Foreground="#7C848D" FontWeight="Bold" VerticalAlignment="Top" Margin="0,1,0,0" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stars}" Foreground="{StaticResource Gold}" Margin="8,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Revealed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Matchup}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Billing}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="· upcoming" />
                                                            <Setter Property="Foreground" Value="#5C646E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Revealed}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding Result}" />
                                                                    <Setter Property="Foreground" Value="#7BE0A0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </DockPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="#111417">
                <ListBox ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" mvvm:AutoScroll.ToEnd="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock mvvm:CornerText.Segments="{Binding Segments}" TextWrapping="Wrap" Margin="12,1" Foreground="#CFD6DC" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Header">
                                                <Setter Property="Foreground" Value="#FFD54A" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="FontSize" Value="15" />
                                                <Setter Property="Margin" Value="12,12,12,4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Round">
                                                <Setter Property="Foreground" Value="#7FB5FF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Margin" Value="12,6,12,2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Result">
                                                <Setter Property="Foreground" Value="#7BE0A0" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Margin" Value="12,4,12,10" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
</UserControl>
