<UserControl x:Class="MmaManager.Wpf.Views.CampsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding Camps}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Text="Fight Camps" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Where the sport actually trains — the room shapes the fighter. ★ = your team deal."
                               Foreground="{StaticResource TextSecondary}" FontSize="11" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Camps}" SelectedItem="{Binding SelectedCamp}"
                          IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Camp" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120" />
                        <DataGridTextColumn Header="Teaches" Binding="{Binding Specialty}" Width="110" />
                        <DataGridTextColumn Header="Coaching" Binding="{Binding Coaching}" Width="70" />
                        <DataGridTextColumn Header="Rep" Binding="{Binding Reputation}" Width="50" />
                        <DataGridTextColumn Header="Mats" Binding="{Binding Capacity}" SortMemberPath="CapacitySort" Width="60" />
                        <DataGridTextColumn Header="Head coach" Binding="{Binding HeadCoach}" Width="150" />
                        <DataGridTextColumn Header="Fee" Binding="{Binding Fee}" SortMemberPath="FeeSort" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding SelectedCamp.Name}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedCamp.Lore}" TextWrapping="Wrap" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCamp.Lore}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{Binding SponsorButtonText}" Command="{Binding SponsorCommand}"
                            Padding="9,4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    <Button Content="{Binding ReportButtonText}" Command="{Binding BuyReportCommand}"
                            Padding="9,4" Margin="0,6,0,8" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="On the mats" FontWeight="Bold" Margin="0,2,0,4" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Members}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
</UserControl>
