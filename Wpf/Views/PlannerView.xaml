<UserControl x:Class="MmaManager.Wpf.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             xmlns:vm="clr-namespace:MmaManager.Wpf.ViewModels"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm"
             xmlns:local="clr-namespace:MmaManager.Wpf.Views">
    <!-- THE PLANNER: the promoter's calendar. A month grid (or an agenda list) of your
         cards, the dates on your timeline, and the sport's announced cards; a rail on the
         right reads out a picked date (what is on, what a card there would clash with,
         "Plan a card here") or, with nothing picked, what is coming up. Shared blocks only,
         plus the calendar-square and chip templates below. -->
    <UserControl.Resources>

        <!-- A calendar square: a flat button (click / Enter / Space picks the day). -->
        <Style x:Key="PlannerDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelEdge}"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True" Padding="5,4,5,4" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding InMonth}" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceSunken}" />
                                <Setter TargetName="b" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasMine}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                                <Setter TargetName="b" Property="Padding" Value="4,3,4,3" />
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line inside a calendar square: yours (accent, two lines), a clash (red),
             a date on your timeline (its tone and icon), or the world's (the org's poster colour). -->
        <DataTemplate x:Key="DayChipTemplate" DataType="{x:Type vm:DayChip}">
            <Border x:Name="b" CornerRadius="3" Margin="0,0,0,2" Padding="4,1,4,1" Background="Transparent" MinHeight="18">
                <DockPanel>
                    <Border x:Name="stripe" DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Margin="-2,2,5,2" Background="{Binding OrgBrush}" />
                    <controls:Icon x:Name="icon" DockPanel.Dock="Left" Kind="{Binding Icon}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                   Brush="{Binding Tone, Converter={StaticResource ToneBrush}}" Visibility="Collapsed" />
                    <controls:Icon x:Name="crown" DockPanel.Dock="Right" Kind="Crown" Width="11" Height="11" Margin="3,0,0,0" VerticalAlignment="Center"
                                   Brush="{StaticResource Gold}" Visibility="Collapsed" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="t" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSoft}">
                            <Run x:Name="main" Text="{Binding Text, Mode=OneWay}" FontWeight="SemiBold" /><Run x:Name="sub" Text="{Binding Sub, Mode=OneWay, StringFormat=' {0}'}" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                        <TextBlock x:Name="line2" Text="{Binding Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSoft}" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Mine">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                    <Setter TargetName="b" Property="Padding" Value="4,2,4,2" />
                    <Setter TargetName="stripe" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="sub" Property="Text" Value="" />
                    <Setter TargetName="line2" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Clash">
                    <Setter TargetName="b" Property="Background" Value="{StaticResource ToneBadDim}" />
                    <Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneBad}" />
                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextPrimary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Marker">
                    <Setter TargetName="stripe" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="b" Property="Background" Value="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}" />
                    <Setter TargetName="main" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTitle}" Value="True">
                    <Setter TargetName="crown" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSignature}" Value="True">
                    <Setter TargetName="main" Property="Foreground" Value="{StaticResource Gold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSub}" Value="False">
                    <Setter TargetName="sub" Property="Text" Value="" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A calendar square's face. -->
        <DataTemplate x:Key="DayCellTemplate" DataType="{x:Type vm:DayCell}">
            <Button Style="{StaticResource PlannerDay}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Spoken}"
                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                        <Border x:Name="dayPill" CornerRadius="9" MinWidth="20" Height="18" Padding="5,0" HorizontalAlignment="Left" Background="Transparent">
                            <TextBlock x:Name="day" Text="{Binding Day}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding More}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,0"
                               Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource DayChipTemplate}" Focusable="False" IsHitTestVisible="False" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="dayPill" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="day" Property="Foreground" Value="#15181D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="day" Property="Foreground" Value="{StaticResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Agenda: one of YOUR cards (rich) ===== -->
        <DataTemplate DataType="{x:Type vm:MyCardModel}">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,10" ToolTip="Open this card on the booking desk"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- poster -->
                    <Border Width="84" Height="112" CornerRadius="5" Background="{StaticResource SurfaceSunken}" Margin="0,0,14,0" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <controls:Icon Kind="Calendar" Width="28" Height="28" Brush="{StaticResource TextSecondary}" />
                            <Image Source="{Binding Poster}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="{Binding DateLine}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding HasMainEvent, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource CardButton}" Width="38" Height="38" Padding="0" ToolTip="Red corner's profile"
                                        Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding RedId}">
                                    <Ellipse Width="36" Height="36"><Ellipse.Fill><ImageBrush ImageSource="{Binding RedFace.Image}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill></Ellipse>
                                </Button>
                                <Button Style="{StaticResource CardButton}" Width="38" Height="38" Padding="0" Margin="-8,0,0,0" ToolTip="Blue corner's profile"
                                        Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding BlueId}">
                                    <Ellipse Width="36" Height="36"><Ellipse.Fill><ImageBrush ImageSource="{Binding BlueFace.Image}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill></Ellipse>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Kind="Crown" Width="14" Height="14" Brush="{StaticResource Gold}" Margin="0,0,5,0"
                                                   Visibility="{Binding IsTitle, Converter={StaticResource BoolToVis}}" ToolTip="A belt is on the line" />
                                    <TextBlock Text="{Binding MainEvent}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                    <Run Text="{Binding Bouts, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Venue, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding EndingLine}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource ToneWarn}" Margin="0,8,0,0"
                                   Visibility="{Binding HasEnding, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <!-- what the sim projects, and what it says to fix -->
                    <StackPanel Grid.Column="2" Width="250" Margin="16,0,0,0" VerticalAlignment="Top">
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,0,0,8"
                                Background="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Chip.Text}" FontWeight="SemiBold"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding HouseLine}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" TextAlignment="Right" />
                        <TextBlock Text="{Binding NetLine}" Style="{StaticResource Text.Heading}" HorizontalAlignment="Right" Margin="0,1,0,0"
                                   Foreground="{Binding NetTone, Converter={StaticResource ToneBrush}}" ToolTip="The sim's projection of the night's net: the box office and partners' money less every cost the night carries" />
                        <ItemsControl ItemsSource="{Binding Risks}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,0">
                                        <controls:Icon DockPanel.Dock="Left" Kind="Warning" Width="13" Height="13" Brush="{StaticResource ToneWarn}" Margin="0,2,5,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"
                                                   TextTrimming="WordEllipsis" MaxHeight="48" ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreRisks}" Style="{StaticResource Text.Caption}" Margin="18,2,0,0"
                                   Visibility="{Binding HasMoreRisks, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ===== Agenda: another promotion's announced card (lighter) ===== -->
        <DataTemplate DataType="{x:Type vm:RivalCardModel}">
            <Button x:Name="card" Style="{StaticResource CardButton}" Margin="0,0,0,6" ToolTip="Open the event page"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                <DockPanel Margin="10,8">
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" Background="#14171C" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Image Source="{Binding Logo}" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" MinWidth="110">
                        <TextBlock Text="{Binding DateLine}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Announced}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="7,1" Background="{StaticResource ToneWarnDim}"
                                    Visibility="{Binding IsSignature, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Flagship" Style="{StaticResource Chip.Text}" FontSize="11" Foreground="{StaticResource Gold}" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" FontSize="14" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <controls:Icon Kind="Crown" Width="13" Height="13" Brush="{StaticResource Gold}" Margin="0,0,5,0"
                                           Visibility="{Binding IsTitle, Converter={StaticResource BoolToVis}}" ToolTip="A belt is on the line" />
                            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding MainEventLine, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" /><Run Text="  ·  " /><Run Text="{Binding Venue, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding ChargedLine}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" Foreground="{StaticResource ToneBad}" Margin="0,3,0,0"
                                   Visibility="{Binding Charged, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- ===== A date on your timeline ===== -->
        <DataTemplate DataType="{x:Type vm:PlannerMarker}">
            <Border Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Margin="0,0,0,6" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="4,0,0,4" Background="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="{Binding OpenText}" Command="{Binding Open}" CommandParameter="{Binding OpenParameter}"
                            VerticalAlignment="Center" Margin="8,0,10,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DateLine}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="10,8,10,8" VerticalAlignment="Center"
                            Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                        <Grid>
                            <controls:Icon Kind="{Binding Icon}" Width="16" Height="16" Brush="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <Ellipse Visibility="{Binding HasFace, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Face.Image}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,6,0,6">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AgendaWeek}">
            <DockPanel Margin="2,10,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="16" />
            </DockPanel>
        </DataTemplate>

        <!-- ===== The rail's compact faces of the same models ===== -->
        <DataTemplate x:Key="RailMine" DataType="{x:Type vm:MyCardModel}">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" ToolTip="Open this card on the booking desk"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                <DockPanel Margin="10">
                    <Border DockPanel.Dock="Left" Width="54" Height="72" CornerRadius="4" Background="{StaticResource SurfaceSunken}" Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <controls:Icon Kind="Calendar" Width="22" Height="22" Brush="{StaticResource TextSecondary}" />
                            <Image Source="{Binding Poster}" Stretch="UniformToFill" Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="YOUR CARD" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{Binding MainEvent}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Text="{Binding NetLine}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="0,3,0,0"
                                   Foreground="{Binding NetTone, Converter={StaticResource ToneBrush}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RailRival" DataType="{x:Type vm:RivalCardModel}">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,6" ToolTip="Open the event page"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                <DockPanel Margin="8,7">
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="5" Background="#14171C" Margin="0,0,9,0" VerticalAlignment="Top">
                        <Image Source="{Binding Logo}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Distance}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Visibility="{Binding HasDistance, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Crown" Width="12" Height="12" Brush="{StaticResource Gold}" Margin="0,0,4,0"
                                           Visibility="{Binding IsTitle, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding MainEventLine}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Venue}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RailMarker" DataType="{x:Type vm:PlannerMarker}">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,6" Command="{Binding Open}" CommandParameter="{Binding OpenParameter}" ToolTip="{Binding OpenText}">
                <DockPanel Margin="8,7">
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Margin="0,0,9,0" VerticalAlignment="Top"
                            Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                        <Grid>
                            <controls:Icon Kind="{Binding Icon}" Width="15" Height="15" Brush="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <Ellipse Visibility="{Binding HasFace, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Face.Image}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding DateLine}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                        <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="48"
                                   ToolTip="{Binding Detail}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <local:PlannerRailSelector x:Key="RailSelector" Mine="{StaticResource RailMine}" Rival="{StaticResource RailRival}" Marker="{StaticResource RailMarker}" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding Planner.PrevMonthCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding Planner.NextMonthCommand}" />
        <KeyBinding Key="Home" Command="{Binding Planner.ThisMonthCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Planner.ClearSelectionCommand}" />
    </UserControl.InputBindings>

    <Grid DataContext="{Binding Planner}" Background="{StaticResource Bg}" controls:Adaptive.CompactBelowHeight="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Masthead: what is on your calendar, the view, the month, the filter ===== -->
        <StackPanel Margin="16,12,16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Plan a card" Command="{Binding PlanNextCommand}" VerticalAlignment="Center"
                        Margin="12,0,0,0" ToolTip="Opens Book Event's plan form (pick a date in the calendar first to plan on that date)" />
                <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Center" ToolTip="Month grid or a list of what is coming">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Month" GroupName="plannerView" IsChecked="{Binding ShowMonth}" />
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Agenda" GroupName="plannerView" IsChecked="{Binding ShowAgenda}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource OrgAccent}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <controls:Icon Kind="Calendar" Width="24" Height="24" Brush="#15181D" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" FontSize="22" FontWeight="Bold" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center" Visibility="{Binding ShowMonth, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Command="{Binding PrevMonthCommand}" IsEnabled="{Binding CanPrev}" ToolTip="Previous month (Page Up)"
                            AutomationProperties.Name="Previous month">
                        <controls:Icon Kind="ChevronLeft" Width="16" Height="16" Brush="{StaticResource TextPrimary}" />
                    </Button>
                    <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource Text.Title}" FontSize="19" Width="160" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanNext}" ToolTip="Next month (Page Down)"
                            AutomationProperties.Name="Next month">
                        <controls:Icon Kind="ChevronRight" Width="16" Height="16" Brush="{StaticResource TextPrimary}" />
                    </Button>
                    <Button Style="{StaticResource Button.Link}" Content="Now" Command="{Binding ThisMonthCommand}" Margin="8,0,0,0" ToolTip="Back to the coming weeks (Home)" />
                </StackPanel>
                <Border Style="{StaticResource Segmented}" Margin="0,0,14,6" VerticalAlignment="Center" ToolTip="Which of the sport's announced cards to show. A card that costs one of your houses always shows.">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Just mine" GroupName="plannerScope" IsChecked="{Binding ScopeIsMine}" />
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Near me" GroupName="plannerScope" IsChecked="{Binding ScopeIsNear}" />
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Everywhere" GroupName="plannerScope" IsChecked="{Binding ScopeIsAll}" />
                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Flagships" GroupName="plannerScope" IsChecked="{Binding ScopeIsFlagships}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="316" />
            </Grid.ColumnDefinitions>

            <!-- ===== Month grid ===== -->
            <Grid Visibility="{Binding ShowMonth, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding WeekdayNames}" Focusable="False" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Kicker}" Margin="6,0,0,0" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayCellTemplate}" Focusable="False"
                              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" Rows="{Binding DataContext.WeekRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- ===== Agenda ===== -->
            <Grid Visibility="{Binding ShowAgenda, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <!-- day one: nothing of yours yet -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Visibility="{Binding NoMyCards, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Your calendar is empty" Style="{StaticResource Text.Heading}" />
                                    <TextBlock Text="Nothing of yours is booked. Pick a quiet week below, or click a date in the month view to see who else is fighting around it." Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False" />
                        <TextBlock Text="Nothing coming up under this filter. Try Everywhere." Style="{StaticResource EmptyStateText}" Margin="0,30,0,0"
                                   Visibility="{Binding AgendaEmpty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== The rail ===== -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14,12,10,12">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,4,0">
                        <!-- a picked date -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Close" Command="{Binding ClearSelectionCommand}" VerticalAlignment="Top" ToolTip="Back to what's coming up (Esc)" />
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedLine}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                                    <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Text.Title}" />
                                </StackPanel>
                            </DockPanel>
                            <Button Style="{StaticResource Button.Primary}" Content="Plan a card here" Command="{Binding PlanSelectedCommand}"
                                    Visibility="{Binding CanPlanSelected, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,4" HorizontalAlignment="Stretch" ToolTip="Opens Book Event with this date on the plan form" />
                            <Button Style="{StaticResource Button.Soft}" Content="{Binding MineHereText}" Command="{Binding OpenCardCommand}" CommandParameter="{Binding MineHereId}"
                                    Visibility="{Binding HasMineHere, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,4" HorizontalAlignment="Stretch" ToolTip="Open this card on the booking desk" />
                            <TextBlock Text="{Binding PlanHint}" Style="{StaticResource BondLineText}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />

                            <TextBlock Text="ON THIS DAY" Style="{StaticResource Text.Kicker}" Margin="0,8,0,6" Visibility="{Binding HasDayItems, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding DayItems}" ItemTemplateSelector="{StaticResource RailSelector}" Focusable="False" />

                            <TextBlock Text="THE CLASH WINDOW" Style="{StaticResource Text.Kicker}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding ClashLine}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding HasClashCharged, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Would cost the house" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ToneBad}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding ClashCharged}" ItemTemplate="{StaticResource RailRival}" Focusable="False" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasClashNearby, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <TextBlock Text="Nearby, not charged" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding ClashNearby}" ItemTemplate="{StaticResource RailRival}" Focusable="False" />
                            </StackPanel>
                        </StackPanel>

                        <!-- nothing picked: what's coming -->
                        <StackPanel Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="COMING UP FOR YOU" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding HeadsUp}" ItemTemplate="{StaticResource RailMarker}" Focusable="False" />
                            <TextBlock Text="No deadlines, returns or lapses ahead. Click a date to see who else is fighting that week." Style="{StaticResource Text.Secondary}"
                                       Visibility="{Binding NoHeadsUp, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6" />

                            <TextBlock Text="FLAGSHIP NIGHTS" Style="{StaticResource Text.Kicker}" Margin="0,14,0,8" Visibility="{Binding HasFlagships, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Flagships}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlagshipModel}">
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Background="#14171C" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Image Source="{Binding Logo}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}">
                                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Line, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Where}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
