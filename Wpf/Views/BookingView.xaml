<UserControl x:Class="MmaManager.Wpf.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             controls:Adaptive.CompactBelowHeight="760"
             controls:Adaptive.NarrowBelowWidth="1420">
    <!-- THE CARD DESK. The fight card is the screen: the main event large with
         both fighters' full-body art, the co-main and the main card stepping
         down, the prelims compact, and the open slot offering the matchmaker's
         pairings. The rail on the right is "the night" (house, money, partner
         terms, risks), or whatever the card asked for: the opponent picker, the
         room chooser, a new card, a bulk proposal. The roster table and the
         poster are one toggle away. Everything is read from and written through
         the sim (BookingViewModel -> PlayerBooking). -->
    <UserControl.Resources>
        <Style x:Key="BillName" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Open the profile" />
        </Style>

        <!-- A face in a rounded frame, red or blue corner by Tag. -->
        <Style x:Key="CornerFace" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- A pairing proposed by the matchmaker (empty slots, the picker): two faces, why, Book. -->
        <DataTemplate x:Key="ProposalTemplate">
            <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource CornerFace}" Width="40" Height="40" BorderBrush="#A8453C">
                            <Image Source="{Binding Red.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                        </Border>
                        <Border Style="{StaticResource CornerFace}" Width="40" Height="40" BorderBrush="#3C639E" Margin="4,0,10,0">
                            <Image Source="{Binding Blue.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Red.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerRedText}" /><Run Text=" vs " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding Blue.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerBlueText}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Division, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Terms, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="Book" Style="{StaticResource Button.Soft}" Padding="14,5" FontSize="12.5"
                                Command="{Binding Desk.BookProposalCommand}" CommandParameter="{Binding}"
                                ToolTip="{Binding Pairing, StringFormat=Book {0} in this slot}" />
                        <Button Content="Look closer" Style="{StaticResource Button.Link}" FontSize="12" HorizontalAlignment="Center"
                                Command="{Binding Desk.LookCloserCommand}" CommandParameter="{Binding}"
                                ToolTip="The whole fight: the fighters side by side, their history, the stakes, and what it does to the night" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource OrgAccent}" TextWrapping="Wrap" />
                        <!-- each corner in a line: rank, record, streak, when he last fought, our read -->
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="●" Foreground="{StaticResource CornerRed}" /><Run Text=" " /><Run Text="{Binding Red.Short, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run Text=": " /><Run Text="{Binding Red.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                            <Run Text="●" Foreground="{StaticResource CornerBlue}" /><Run Text=" " /><Run Text="{Binding Blue.Short, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run Text=": " /><Run Text="{Binding Blue.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="{Binding Cost, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Read, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Name="night" Text="{Binding NightEffect}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{Binding NightTone, Converter={StaticResource ToneBrush}}" />
                        <ItemsControl x:Name="notes" ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False" Margin="0,5,0,-6">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasNightEffect}" Value="False"><Setter TargetName="night" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter TargetName="notes" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A proposal in a bulk list: ticked to book. -->
        <DataTemplate x:Key="ProposedTemplate">
            <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="10,8" Margin="0,0,0,8">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Untick to leave this one out" />
                    <Border DockPanel.Dock="Left" Style="{StaticResource CornerFace}" Width="36" Height="36" BorderBrush="#A8453C">
                        <Image Source="{Binding Red.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    </Border>
                    <Border DockPanel.Dock="Left" Style="{StaticResource CornerFace}" Width="36" Height="36" BorderBrush="#3C639E" Margin="4,0,10,0">
                        <Image Source="{Binding Blue.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Look closer" Style="{StaticResource Button.Link}" FontSize="12" Margin="6,-2,0,0"
                                    Command="{Binding Desk.LookCloserCommand}" CommandParameter="{Binding}" VerticalAlignment="Top"
                                    ToolTip="This fight in full on the left: the fighters, their history, the stakes, what it does to the night" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding SlotLabel, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OrgAccent}" /><Run Text="  " /><Run Text="{Binding Division, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Red.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerRedText}" /><Run Text=" vs " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding Blue.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerBlueText}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="●" Foreground="{StaticResource CornerRed}" /><Run Text=" " /><Run Text="{Binding Red.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                            <Run Text="●" Foreground="{StaticResource CornerBlue}" /><Run Text=" " /><Run Text="{Binding Blue.Summary, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Cost}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="notes" ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False" Margin="0,4,0,-6">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter TargetName="notes" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A fighter in the picker's ladder: rank, face, read, and why not when they can't. -->
        <DataTemplate x:Key="LadderTemplate">
            <Border x:Name="row" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="8,6,8,7"
                    Cursor="Hand" ToolTip="{Binding Tip}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding Command}" CommandParameter="{Binding}" />
                </Border.InputBindings>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,9,0">
                        <Border Width="42" Height="42" CornerRadius="7" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                            <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                        </Border>
                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run x:Name="nick" Text="{Binding Nickname, Mode=OneWay, StringFormat='  {0}'}" FontStyle="Italic" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Division, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Record, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run Text="  ·  fought " /><Run Text="{Binding LastFoughtText, Mode=OneWay}" />
                        </TextBlock>
                        <WrapPanel Margin="0,3,0,0">
                            <Border x:Name="streak" CornerRadius="4" Padding="5,0,5,1" Margin="0,0,6,2" VerticalAlignment="Center"
                                    Background="{Binding StreakTone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                                <TextBlock Text="{Binding Streak}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StreakTone, Converter={StaticResource ToneBrush}}" />
                            </Border>
                            <TextBlock FontSize="12" Margin="0,0,0,2" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="{Binding ReadText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" /><Run Text="  ·  " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding Draw, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run x:Name="purse" Text="{Binding Purse, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{StaticResource TextSecondary}" />
                            </TextBlock>
                        </WrapPanel>
                        <Border x:Name="flag" Style="{StaticResource Chip}" Padding="7,1,7,2" Margin="0,3,0,0" HorizontalAlignment="Left"
                                Background="{Binding Flag.Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                            <TextBlock Text="{Binding Flag.Text}" FontSize="11.5" Foreground="{Binding Flag.Tone, Converter={StaticResource ToneBrush}}" />
                        </Border>
                        <TextBlock x:Name="line" Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource OrgAccent}" Margin="0,3,0,0" />
                        <TextBlock x:Name="cost" Text="{Binding Cost}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock x:Name="why" Text="{Binding Why}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneWarn}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Button x:Name="find" Style="{StaticResource Button.Link}" Content="Find an opponent ▸" FontSize="12" HorizontalAlignment="Left" Margin="-4,1,0,-2"
                                Command="{Binding Desk.FindOpponentCommand}" CommandParameter="{Binding}" Visibility="Collapsed"
                                ToolTip="Pick him as the first corner and rank everyone he could fight by how good the fight is" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.55" />
                    <Setter TargetName="row" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="why" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanFindOpponent}" Value="True"><Setter TargetName="find" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding HasLine}" Value="False"><Setter TargetName="line" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasCost}" Value="False"><Setter TargetName="cost" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasStreak}" Value="False"><Setter TargetName="streak" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasFlag}" Value="False"><Setter TargetName="flag" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A bout on the bill under the main event: faces, names, what sells it, quiet actions. -->
        <DataTemplate x:Key="BoutRowTemplate">
            <Border x:Name="card" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="14,10,10,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="slot" Text="{Binding SlotLabel}" Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding Division}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{Binding Rounds, Mode=OneWay}" /><Run x:Name="titleRun" Text="" Foreground="{StaticResource Gold}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                        <TextBlock Text="{Binding Red.Name}" Style="{StaticResource BillName}" HorizontalAlignment="Right">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Red.Id}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock x:Name="redFacts" Text="{Binding Red.Facts}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="redFace" Grid.Column="2" Style="{StaticResource CornerFace}" BorderBrush="#A8453C" VerticalAlignment="Center">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Red.Id}" />
                        </Border.InputBindings>
                        <Image Source="{Binding Red.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    </Border>
                    <TextBlock Grid.Column="3" Text="vs" Foreground="{StaticResource Crimson}" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="blueFace" Grid.Column="4" Style="{StaticResource CornerFace}" BorderBrush="#3C639E" VerticalAlignment="Center">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Blue.Id}" />
                        </Border.InputBindings>
                        <Image Source="{Binding Blue.Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    </Border>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding Blue.Name}" Style="{StaticResource BillName}">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Blue.Id}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock x:Name="blueFacts" Text="{Binding Blue.Facts}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Icon}" Content="▲" ToolTip="Up the bill (toward the main event)"
                                Command="{Binding Desk.MoveUpCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveUp}" />
                        <Button Style="{StaticResource Button.Icon}" Content="▼" ToolTip="Down the bill (toward the prelims)"
                                Command="{Binding Desk.MoveDownCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveDown}" />
                        <Button Style="{StaticResource Button.Icon}" Content="⇄" ToolTip="Change a corner (keeps the slot)"
                                Command="{Binding Desk.ReplaceCornerCommand}" CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="✕" ToolTip="Take this bout off the card"
                                Command="{Binding Desk.RemoveBoutCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <!-- what sells it, and what to watch: a second line under the names -->
                    <WrapPanel x:Name="tags" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="8,8,0,-6" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Sells}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding WatchFor}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </WrapPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCoMain}" Value="True">
                    <Setter TargetName="slot" Property="Foreground" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="redFace" Property="Width" Value="56" />
                    <Setter TargetName="redFace" Property="Height" Value="56" />
                    <Setter TargetName="blueFace" Property="Width" Value="56" />
                    <Setter TargetName="blueFace" Property="Height" Value="56" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTitle}" Value="True">
                    <Setter TargetName="titleRun" Property="Text" Value=" · title" />
                </DataTrigger>
                <!-- prelims: dimmer lights, smaller faces, no second line -->
                <DataTrigger Binding="{Binding IsPrelim}" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource PanelFill}" />
                    <Setter TargetName="card" Property="Padding" Value="14,6,10,6" />
                    <Setter TargetName="card" Property="Margin" Value="0,0,0,6" />
                    <Setter TargetName="redFace" Property="Width" Value="34" />
                    <Setter TargetName="redFace" Property="Height" Value="34" />
                    <Setter TargetName="blueFace" Property="Width" Value="34" />
                    <Setter TargetName="blueFace" Property="Height" Value="34" />
                    <Setter TargetName="tags" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The main event: both fighters in full, the kicker, why it sells, what to watch. -->
        <DataTemplate x:Key="MainEventTemplate">
            <Border x:Name="band" CornerRadius="{StaticResource Radius.Panel}" BorderBrush="{DynamicResource OrgAccent}" BorderThickness="1"
                    ClipToBounds="True" MinHeight="290" Margin="0,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2418" Offset="0" />
                        <GradientStop Color="#1B1F27" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="redCol" Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="blueCol" Width="210" />
                    </Grid.ColumnDefinitions>
                    <!-- the bodies paint the band's sides (a brush never decides the band's height) -->
                    <Border Grid.Column="0" Cursor="Hand" ToolTip="Open the profile" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Red.BodyImage}" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Red.Id}" />
                        </Border.InputBindings>
                    </Border>
                    <Border Grid.Column="2" Cursor="Hand" ToolTip="Open the profile" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Blue.BodyImage}" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Blue.Id}" />
                        </Border.InputBindings>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="18,16,18,12">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextTrimming="CharacterEllipsis" />
                        <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="redName" Text="{Binding Red.Name}" Style="{StaticResource Text.Title}" FontSize="24" Cursor="Hand">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Red.Id}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <TextBlock Text="{Binding Red.Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                                <TextBlock Text="{Binding Red.Facts}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="Scout: " /><Run Text="{Binding Red.ReadText, Mode=OneWay}" Foreground="{StaticResource TextSoft}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="VS" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource Crimson}" Margin="14,2,14,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="blueName" Text="{Binding Blue.Name}" Style="{StaticResource Text.Title}" FontSize="24" TextAlignment="Right" Cursor="Hand">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Blue.Id}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <TextBlock Text="{Binding Blue.Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Blue.Facts}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right">
                                    <Run Text="Scout: " /><Run Text="{Binding Blue.ReadText, Mode=OneWay}" Foreground="{StaticResource TextSoft}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <!-- quiet actions along the bottom of the band -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource Button.Link}" Content="Change a corner" Command="{Binding Desk.ReplaceCornerCommand}" CommandParameter="{Binding}"
                                    ToolTip="Swap one fighter; the bout keeps its place, and the belt while the champion stays in" />
                            <Button Style="{StaticResource Button.Link}" Content="Move down the bill" Command="{Binding Desk.MoveDownCommand}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanMoveDown}" Margin="10,0,0,0" />
                            <Button Style="{StaticResource Button.Link}" Content="Take off the card" Command="{Binding Desk.RemoveBoutCommand}" CommandParameter="{Binding}" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel x:Name="sells">
                                <TextBlock DockPanel.Dock="Left" Text="WHY IT SELLS" Style="{StaticResource Text.Kicker}" Width="96" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding Sells}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel x:Name="watch">
                                <TextBlock DockPanel.Dock="Left" Text="WATCH FOR" Style="{StaticResource Text.Kicker}" Width="96" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding WatchFor}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                            <Border x:Name="quote" Background="#B3141820" CornerRadius="6" Padding="10,7" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Text.Secondary}" TextTrimming="WordEllipsis" MaxHeight="54">
                                    <Run Text="Matchmaker: " FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" /><Run Text="{Binding Matchmaker, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWatchFor}" Value="False"><Setter TargetName="watch" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasMatchmaker}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <!-- a short or narrow window: the bodies become portraits, the band tightens -->
                <Trigger SourceName="band" Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter TargetName="band" Property="MinHeight" Value="220" />
                    <Setter TargetName="redCol" Property="Width" Value="150" />
                    <Setter TargetName="blueCol" Property="Width" Value="150" />
                    <Setter TargetName="redName" Property="FontSize" Value="20" />
                    <Setter TargetName="blueName" Property="FontSize" Value="20" />
                    <Setter TargetName="quote" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger SourceName="band" Property="controls:Adaptive.IsNarrow" Value="True">
                    <Setter TargetName="redCol" Property="Width" Value="150" />
                    <Setter TargetName="blueCol" Property="Width" Value="150" />
                    <Setter TargetName="redName" Property="FontSize" Value="20" />
                    <Setter TargetName="blueName" Property="FontSize" Value="20" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The open slot (DataContext = the desk): what the card needs next, two ideas, the picker. -->
        <DataTemplate x:Key="OpenSlotTemplate">
            <Border CornerRadius="{StaticResource Radius.Card}" BorderThickness="1" BorderBrush="{StaticResource BorderStrong}" Padding="14,10" Margin="0,0,0,10"
                    Background="{StaticResource SurfaceSunken}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Open the picker ▸" Command="{Binding OpenNextSlotCommand}"
                                Padding="12,4" VerticalAlignment="Top" ToolTip="Suggestions, a division's ladder with our scouts' reads, or a local opponent" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0">
                            <Run Text="+  " Foreground="{DynamicResource OrgAccent}" FontWeight="Bold" /><Run Text="{Binding NextSlotLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" /><Run Text="   " /><Run Text="{Binding NextSlotHint, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                        </TextBlock>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding NextSlotIdeas}" ItemTemplate="{StaticResource ProposalTemplate}" Focusable="False" Margin="0,8,0,-8"
                                  Visibility="{Binding HasNextSlotIdeas, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One corner on the fight sheet (CornerSheet): how he wins and loses, his form, when he last
             fought and whether he's ready, the person, and our scouts' read. -->
        <DataTemplate x:Key="CornerFactsTemplate">
            <StackPanel>
                <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Heading}" Foreground="{StaticResource CornerRedText}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                    <Run Text="{Binding Standing, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Record, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                </TextBlock>
                <!-- how he wins: a bar split KO / sub / decision -->
                <Grid x:Name="bar" Height="6" Margin="0,6,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding KoWidth}" />
                        <ColumnDefinition Width="{Binding SubWidth}" />
                        <ColumnDefinition Width="{Binding DecWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Crimson}" CornerRadius="3,0,0,3" ToolTip="Wins by KO/TKO" />
                    <Border Grid.Column="1" Background="{StaticResource World}" ToolTip="Wins by submission" />
                    <Border Grid.Column="2" Background="{StaticResource TextSecondary}" CornerRadius="0,3,3,0" ToolTip="Wins on the cards" />
                </Grid>
                <TextBlock Text="{Binding WinsText}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LossesText}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                <!-- the last five, oldest first -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="LAST 5" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Form}" ItemTemplate="{StaticResource FormChipTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StreakText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Readiness}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,6"
                           Foreground="{Binding ReadinessTone, Converter={StaticResource ToneBrush}}" />
                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0">
                    <Run Text="OUR READ  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding ReadText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding ScoutText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRed}" Value="False"><Setter TargetName="name" Property="Foreground" Value="{StaticResource CornerBlueText}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasWins}" Value="False"><Setter TargetName="bar" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Money lines in the night panel -->
        <DataTemplate x:Key="MoneyLineTemplate">
            <DockPanel Margin="0,2">
                <TextBlock x:Name="amt" DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="12.5" Foreground="{StaticResource ToneGood}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="amt" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" DataContext="{Binding Booking}" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: your cards as tabs, a new card, and how to look at this one -->
        <DockPanel Margin="16,12,16,0">
            <Border DockPanel.Dock="Right" Style="{StaticResource Segmented}" VerticalAlignment="Top" Margin="12,0,0,0"
                    Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentedOption}" Content="Card" GroupName="deskView" IsChecked="{Binding ShowCardView}" ToolTip="The bill" />
                    <RadioButton Style="{StaticResource SegmentedOption}" Content="Table" GroupName="deskView" IsChecked="{Binding ShowTableView}" ToolTip="Your whole roster as a sortable table" />
                    <RadioButton Style="{StaticResource SegmentedOption}" Content="Poster" GroupName="deskView" IsChecked="{Binding ShowPosterView}" ToolTip="The poster, drawn from the main event" />
                </StackPanel>
            </Border>
            <WrapPanel>
                <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding UpcomingEvents}" SelectedItem="{Binding SelectedEvent}"
                         AutomationProperties.Name="Your upcoming cards">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Style="{StaticResource Button.Ghost}" Content="+ Plan a card" Command="{Binding PlanCardCommand}" Margin="0,0,0,6"
                        VerticalAlignment="Stretch" ToolTip="Put a new card on the calendar" />
            </WrapPanel>
        </DockPanel>

        <!-- Row 1: the card's header -->
        <Grid Grid.Row="1" Margin="16,6,16,0" Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="10" Background="#14171C" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                <Image Source="{Binding PlayerLogo}" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock Text="{Binding EventName}" Style="{StaticResource Text.Display}" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Background="{StaticResource ToneWarnDim}" VerticalAlignment="Center" Margin="0,4,6,0"
                            Visibility="{Binding HasTagline, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Chip.Text}" Foreground="{StaticResource Gold}" FontWeight="Bold" />
                    </Border>
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,4,6,0">
                        <TextBlock Text="{Binding TierLabel}" Style="{StaticResource Chip.Text}" />
                    </Border>
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                    <TextBlock Text="{Binding DateLine}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding RoomLine}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Link}" Content="Change room" Command="{Binding ChangeRoomCommand}" Margin="6,0,0,0"
                            ToolTip="Every room in this city, with the house and box office each would give" />
                    <TextBlock Text="{Binding BroadcastLine}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding HasBroadcastLine, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
            </StackPanel>
            <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="560">
                <!-- fight night: the two doors -->
                <Button Style="{StaticResource Button.Primary}" Content="Watch it live" Command="{Binding RunLiveCommand}" Margin="0,0,8,6"
                        Visibility="{Binding IsDue, Converter={StaticResource BoolToVis}}" ToolTip="Run the card now and watch the broadcast" />
                <Button Style="{StaticResource Button.Ghost}" Content="Sim the result" Command="{Binding SimTonightCommand}" Margin="0,0,8,6"
                        Visibility="{Binding IsDue, Converter={StaticResource BoolToVis}}" ToolTip="Run the card without watching" />
                <Button Style="{StaticResource Button.Soft}" Content="Fill the undercard" Command="{Binding ProposeUndercardCommand}" Margin="0,0,8,6" Padding="14,7"
                        Visibility="{Binding IsDue, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="The matchmaker proposes prelims from fighters who are ready and unbooked. You review before anything is booked." />
                <Button Style="{StaticResource Button.Ghost}" Content="Propose the whole card" Command="{Binding ProposeWholeCardCommand}" Margin="0,0,8,6"
                        Visibility="{Binding IsDue, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="A whole card's worth of pairings, nobody twice, for you to review" />
                <Button Style="{StaticResource Button.Ghost}" Content="Cancel card" Command="{Binding CancelEventCommand}" Margin="0,0,0,6"
                        ToolTip="Scrap this card and every bout on it. You'll be asked first, and told what it costs." />
            </WrapPanel>
        </Grid>

        <!-- Row 2: what just happened (a booking, a refusal, things that changed since you looked) -->
        <Border Grid.Row="2" Margin="16,8,16,0" CornerRadius="6" Padding="12,6"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource ToneGoodDim}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ToneBadDim}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Foreground" Value="{StaticResource ToneGood}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ToneBad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Row 3: the body: the bill (or the table, or the poster) and the rail -->
        <Grid Grid.Row="3" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===================== THE BILL ===================== -->
            <ScrollViewer x:Name="BillScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"
                          Visibility="{Binding ShowCardView, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- nothing on the calendar -->
                    <controls:EmptyState Icon="Calendar" Title="No card on the calendar."
                                         Message="Pick a date and a host city on the right and the card opens here, ready for its main event."
                                         Footnote="Advancing time stops on fight night: you choose to watch the card live or sim it."
                                         Margin="0,60,0,0"
                                         Visibility="{Binding HasNoEvents, Converter={StaticResource BoolToVis}}" />

                    <!-- the main event, booked -->
                    <ContentControl Content="{Binding MainEvent}" ContentTemplate="{StaticResource MainEventTemplate}" Focusable="False"
                                    Visibility="{Binding HasMainEvent, Converter={StaticResource BoolToVis}}" />

                    <!-- the main event, open: the matchmaker's ideas right here -->
                    <Border CornerRadius="{StaticResource Radius.Panel}" BorderThickness="1.5" Padding="18,14" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource OrgAccent}" Background="{StaticResource PanelFill}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelectedEvent}" Value="True" />
                                            <Condition Binding="{Binding HasMainEvent}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="MAIN EVENT" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" />
                            <TextBlock Text="Who headlines?" Style="{StaticResource Text.Title}" FontSize="22" Margin="0,4,0,2" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,10"
                                       Text="The main event sells the night: the house, the poster and the partners' star terms all read it. Book it first and the rest of the card falls in under it." />
                            <ItemsControl ItemsSource="{Binding HeadlineIdeas}" ItemTemplate="{StaticResource ProposalTemplate}" Focusable="False" />
                            <!-- no roster yet: the way out -->
                            <Border Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="14,10" Margin="0,0,0,8"
                                    Visibility="{Binding HasRoster, Converter={StaticResource InverseBoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Sign fighters" Command="{Binding OpenContractsCommand}"
                                            VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="Your gym is empty, for now." FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Text.Secondary}"
                                                   Text="A bout needs two of your fighters in one division, or one of yours against the local club scene. Free agents near your HQ and their asking prices are on the Contracts desk." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Content="Pick it yourself ▸" Command="{Binding OpenSlotCommand}" CommandParameter="MainEvent" Margin="0,0,8,0"
                                        ToolTip="The picker: the matchmaker's ideas, a division's ladder, or a local opponent" />
                                <Button Style="{StaticResource Button.Link}" Content="Propose the whole card" Command="{Binding ProposeWholeCardCommand}" VerticalAlignment="Center"
                                        Visibility="{Binding HasRoster, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- the main card under the main event -->
                    <ItemsControl ItemsSource="{Binding MainCardRows}" ItemTemplate="{StaticResource BoutRowTemplate}" Focusable="False" />

                    <!-- the open slot under the main card (while the main card is still filling) -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OpenSlotTemplate}" Focusable="False"
                                    Visibility="{Binding NextSlotIsMainCard, Converter={StaticResource BoolToVis}}" />

                    <!-- the broadcast split -->
                    <DockPanel Margin="0,2,0,8" Visibility="{Binding HasMainEvent, Converter={StaticResource BoolToVis}}">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding MainCardOptions}" SelectedItem="{Binding SelectedMainCard}" Width="120" Height="28"
                                  AutomationProperties.Name="Main card size"
                                  ToolTip="Fights above the line air as the main card; the rest are prelims (less exposure, less fame). Media deals may ask for a window of a certain size." />
                        <TextBlock DockPanel.Dock="Right" Text="Main card size" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MainCardNote}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- the prelims -->
                    <StackPanel Visibility="{Binding HasPrelims, Converter={StaticResource BoolToVis}}">
                        <TextBlock Margin="2,4,0,6" TextWrapping="Wrap">
                            <Run Text="PRELIMS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}" /><Run Text="   " /><Run Text="{Binding PrelimNote, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding PrelimRows}" ItemTemplate="{StaticResource BoutRowTemplate}" Focusable="False" />
                    </StackPanel>

                    <!-- the open slot under the prelims (once the main card is full) -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OpenSlotTemplate}" Focusable="False"
                                    Visibility="{Binding NextSlotIsPrelim, Converter={StaticResource BoolToVis}}" />

                    <!-- the house's padding, shown before the night -->
                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,4,0,8"
                            Visibility="{Binding HasPadding, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="ON THE NIGHT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}" /><Run Text="   " /><Run Text="{Binding PaddingLine, Mode=OneWay}" Foreground="{StaticResource TextSoft}" FontSize="12.5" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PaddingBouts}" Margin="0,8,0,-6" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" Background="Transparent">
                                            <TextBlock Text="{Binding}" Style="{StaticResource Chip.Text}" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Advancing time stops on fight night: you choose to watch the card live or sim the result."
                               Style="{StaticResource Text.Caption}" Margin="2,4,0,8"
                               Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== THE TABLE ===================== -->
            <Grid Visibility="{Binding ShowTableView, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="PairButton" DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Pair the two selected" Padding="14,6"
                                Click="OnPairClick" ToolTip="Select two fighters (Ctrl+click), then compare and book them on the fight sheet" />
                        <StackPanel>
                            <TextBlock Text="{Binding TableTitle}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="Sort any column. Double-click a fighter for the profile; Ctrl+click two to pair them." />
                        </StackPanel>
                    </DockPanel>
                    <!-- the finder's search, scope and chips (shared with the picker) -->
                    <WrapPanel Margin="0,8,0,0">
                        <TextBox x:Name="TableSearchBox" Style="{StaticResource SearchBox}" Tag="Search by name or nickname  (Ctrl+F)" Width="380" Margin="0,0,8,6"
                                 Text="{Binding FinderSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" AutomationProperties.Name="Search your roster" />
                        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding FinderScope}" Width="200" Height="30" Margin="0,0,0,6" AutomationProperties.Name="Division" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding FinderChips}" Focusable="False" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource FilterChip.Compact}" IsChecked="{Binding IsOn}" ToolTip="{Binding Tip}" Content="{Binding Text}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <DataGrid x:Name="TableGrid" Grid.Row="1" ItemsSource="{Binding TableRows}" RowHeight="36" SelectionMode="Extended"
                          mvvm:FighterLink.OpenOnDoubleClick="True" EnableRowVirtualization="True" AutomationProperties.Name="Your roster">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Face.Image}" Width="30" Height="30" Margin="0,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rk" Binding="{Binding Rank}" SortMemberPath="RankSort" Width="40" />
                        <DataGridTextColumn Header="Fighter" Binding="{Binding Name}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="120" />
                        <DataGridTextColumn Header="Record" Binding="{Binding Record}" SortMemberPath="RecordSort" Width="104" />
                        <DataGridTextColumn Header="Streak" Binding="{Binding Streak}" SortMemberPath="StreakSort" Width="58" />
                        <DataGridTextColumn Header="Our read" Binding="{Binding ReadText}" SortMemberPath="Read" Width="78" />
                        <DataGridTextColumn Header="Pop" Binding="{Binding Popularity}" Width="44" />
                        <DataGridTextColumn Header="Fought" Binding="{Binding LastFought}" SortMemberPath="LastFoughtSort" Width="78" />
                        <DataGridTextColumn Header="Purse" Binding="{Binding Purse}" SortMemberPath="PurseSort" Width="64" />
                        <DataGridTextColumn Header="Left" Binding="{Binding FightsLeft}" Width="40" />
                        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="40" />
                        <DataGridTextColumn Header="For this card" Binding="{Binding Availability}" Width="150" />
                        <DataGridTemplateColumn Header="Notes" Width="170" SortMemberPath="Notes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding Notes}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ===================== THE POSTER ===================== -->
            <Grid Visibility="{Binding ShowPosterView, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                <Border Background="#0B0C10" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="{StaticResource Radius.Panel}" Padding="10">
                    <Image Source="{Binding Poster}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>

            <!-- ===================== THE FIGHT SHEET =====================
                 One pairing in full, over the bill while the picker (or a proposal) is open in the rail:
                 the two people and why it matters up top; the fighters, between them, the stakes,
                 the night and the contracts below; the dense tale of the tape one toggle away. -->
            <Grid x:Name="SheetPane" Background="{StaticResource Bg}" Margin="0,0,8,0"
                  Visibility="{Binding HasSheet, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- the band: both fighters, the kicker, the one line, the terms and the button -->
                    <Border x:Name="SheetBand" DockPanel.Dock="Top" CornerRadius="{StaticResource Radius.Panel}" BorderBrush="{DynamicResource OrgAccent}" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,0,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A2418" Offset="0" />
                                <GradientStop Color="#1B1F27" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SheetRedCol" Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SheetBlueCol" Width="150" />
                            </Grid.ColumnDefinitions>
                            <Border Cursor="Hand" ToolTip="Open the profile" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Sheet.Red.Body}" Stretch="UniformToFill" AlignmentY="Top" />
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Sheet.Red.Id}" />
                                </Border.InputBindings>
                            </Border>
                            <Border Grid.Column="2" Cursor="Hand" ToolTip="Open the profile" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Sheet.Blue.Body}" Stretch="UniformToFill" AlignmentY="Top" />
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Sheet.Blue.Id}" />
                                </Border.InputBindings>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,12,16,12">
                                <TextBlock Text="{Binding Sheet.Kicker}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextWrapping="Wrap" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SheetRedName" Text="{Binding Sheet.Red.Name}" Style="{StaticResource Text.Title}" FontSize="21" TextWrapping="Wrap" Foreground="{StaticResource CornerRedText}" />
                                        <TextBlock Text="{Binding Sheet.Red.Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Foreground="{StaticResource TextSoft}">
                                            <Run Text="{Binding Sheet.Red.Standing, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Sheet.Red.Record, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="VS" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource Crimson}" Margin="12,2,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="SheetBlueName" Text="{Binding Sheet.Blue.Name}" Style="{StaticResource Text.Title}" FontSize="21" TextWrapping="Wrap" TextAlignment="Right" Foreground="{StaticResource CornerBlueText}" />
                                        <TextBlock Text="{Binding Sheet.Blue.Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Right" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Right" Foreground="{StaticResource TextSoft}">
                                            <Run Text="{Binding Sheet.Blue.Standing, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Sheet.Blue.Record, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Sheet.Headline}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,8,0,6" />
                                <ItemsControl ItemsSource="{Binding Sheet.Tags}" ItemTemplate="{StaticResource ToneTagTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6" Visibility="{Binding Sheet.CanEditTerms, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Rounds" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Width="56" Height="28" ItemsSource="{Binding RoundsOptions}" SelectedItem="{Binding SelectedRounds}" AutomationProperties.Name="Rounds" />
                                        <CheckBox Content="Title fight" IsChecked="{Binding IsTitleBout}" IsEnabled="{Binding CanBeTitle}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                  ToolTip="A belt can be on the line only with the champion in the bout, or for a vacant belt" />
                                    </StackPanel>
                                    <Button Style="{StaticResource Button.Primary}" Content="{Binding Sheet.ActionText}" Command="{Binding SheetActionCommand}" Padding="16,6" Margin="0,0,8,6"
                                            Visibility="{Binding Sheet.HasAction, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="Back to the card" Command="{Binding CloseSheetCommand}" Margin="0,0,8,6"
                                            ToolTip="Close the sheet; the picker stays open" />
                                    <Border Style="{StaticResource Segmented}" Margin="0,0,0,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentedOption}" Content="Story" GroupName="sheetView" IsChecked="{Binding ShowSheetStory}" ToolTip="The fight told in groups" />
                                            <RadioButton Style="{StaticResource SegmentedOption}" Content="Table" GroupName="sheetView" IsChecked="{Binding ShowSheetTable}" ToolTip="Every line side by side, scouts' reads included" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- STORY: the fighters side by side -->
                            <StackPanel Visibility="{Binding ShowSheetStory, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="THE FIGHTERS" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding Sheet.Red}" ContentTemplate="{StaticResource CornerFactsTemplate}" Focusable="False" />
                                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource GridLine}" HorizontalAlignment="Center" />
                                            <ContentControl Grid.Column="2" Content="{Binding Sheet.Blue}" ContentTemplate="{StaticResource CornerFactsTemplate}" Focusable="False" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- between them -->
                                    <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="BETWEEN THEM" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Sheet.Between}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                            <TextBlock Text="{Binding Sheet.Matchmaker}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSoft}" Margin="0,4,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="How even" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <ProgressBar Grid.Column="1" Value="{Binding Sheet.Competitiveness, Mode=OneWay}" Maximum="100" Height="8" Margin="0,3" Foreground="{StaticResource Positive}" BorderThickness="0" />
                                                <TextBlock Grid.Row="1" Text="Appeal" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Sheet.Appeal, Mode=OneWay}" Maximum="100" Height="8" Margin="0,3" Foreground="{StaticResource World}" BorderThickness="0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- what's at stake -->
                                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="WHAT'S AT STAKE" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Sheet.Stakes}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0">
                                                <Run Text="{Binding Sheet.Red.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerRedText}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource ToneGood}"><Run Text="Win: " FontWeight="SemiBold" /><Run Text="{Binding Sheet.Red.WinDoes, Mode=OneWay}" /></TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource ToneWarn}"><Run Text="Loss: " FontWeight="SemiBold" /><Run Text="{Binding Sheet.Red.LossRisks, Mode=OneWay}" /></TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0">
                                                <Run Text="{Binding Sheet.Blue.Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerBlueText}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource ToneGood}"><Run Text="Win: " FontWeight="SemiBold" /><Run Text="{Binding Sheet.Blue.WinDoes, Mode=OneWay}" /></TextBlock>
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource ToneWarn}"><Run Text="Loss: " FontWeight="SemiBold" /><Run Text="{Binding Sheet.Blue.LossRisks, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <!-- what it does to the night -->
                                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="WHAT IT DOES TO THE NIGHT" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Sheet.Night}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="NightBefore" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="NightAfter" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="NightChange" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Before}" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" FontSize="12.5" Margin="6,0,0,0"><Run Text="→ " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding After, Mode=OneWay}" /></TextBlock>
                                                            <TextBlock Grid.Column="3" Text="{Binding Change}" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" TextAlignment="Right"
                                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Sheet.NightNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                            <TextBlock Text="Partners" Style="{StaticResource SectionLabel}" Margin="0,2,0,4" Visibility="{Binding Sheet.HasTerms, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Sheet.Terms}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                            <TextBlock Text="Risks it brings" Style="{StaticResource SectionLabel}" Margin="0,4,0,4" Visibility="{Binding Sheet.HasRisks, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Sheet.Risks}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                        </StackPanel>
                                    </Border>
                                    <!-- on their contracts -->
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="ON THEIR CONTRACTS" Style="{StaticResource Text.Kicker}" Margin="0,0,0,8" />
                                            <StackPanel Visibility="{Binding Sheet.Red.HasContract, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Sheet.Red.Name}" FontWeight="SemiBold" Foreground="{StaticResource CornerRedText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Sheet.Red.Contract}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding Sheet.Blue.HasContract, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Sheet.Blue.Name}" FontWeight="SemiBold" Foreground="{StaticResource CornerBlueText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Sheet.Blue.Contract}" ItemTemplate="{StaticResource SheetLineTemplate}" Focusable="False" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- TABLE: the dense tale of the tape -->
                            <Border Style="{StaticResource Panel}" Padding="14,10" Visibility="{Binding ShowSheetTable, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="TALE OF THE TAPE · PUBLIC RECORD AND OUR SCOUTS' READS" Style="{StaticResource Text.Kicker}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Sheet.Tape}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="r" Text="{Binding Red}" TextAlignment="Right" Margin="0,0,10,0" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="b" Grid.Column="2" Text="{Binding Blue}" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RedBold}" Value="True"><Setter TargetName="r" Property="FontWeight" Value="Bold" /><Setter TargetName="r" Property="Foreground" Value="{StaticResource Positive}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding BlueBold}" Value="True"><Setter TargetName="b" Property="FontWeight" Value="Bold" /><Setter TargetName="b" Property="Foreground" Value="{StaticResource Positive}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ===================== THE RAIL ===================== -->
            <Border x:Name="Rail" Grid.Column="1" Style="{StaticResource Panel}" Padding="16,14,10,14" Margin="6,0,0,0" Width="410"
                    Visibility="{Binding ShowRail, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- the night as one line while the rail is busy -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource CardFill}" CornerRadius="6" Padding="10,6" Margin="0,0,6,10"
                            Visibility="{Binding ShowNightLine, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="The night ▸" Command="{Binding CloseRailCommand}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="NIGHT  " FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding NightLine, Mode=OneWay}" FontSize="12.5" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!-- ===== the night ===== -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="{Binding IsRailNight, Converter={StaticResource BoolToVis}}">
                            <StackPanel Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Estimate · moves as you book" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" />
                                    <TextBlock Text="The night" Style="{StaticResource Text.Title}" />
                                </DockPanel>
                                <!-- the house -->
                                <TextBlock Text="{Binding HouseHeadline}" Style="{StaticResource Text.Display}" FontSize="26" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding HouseDetail}" Style="{StaticResource Text.Secondary}" />
                                <ProgressBar Value="{Binding HouseFill, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,0" Foreground="{StaticResource ToneGood}" BorderThickness="0"
                                             Visibility="{Binding HasMoney, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding PpvLine}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                                           Visibility="{Binding HasPpv, Converter={StaticResource BoolToVis}}" />

                                <!-- the money -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMoney, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding MoneyIn}" ItemTemplate="{StaticResource MoneyLineTemplate}" Focusable="False" />
                                    <ItemsControl ItemsSource="{Binding MoneyOut}" ItemTemplate="{StaticResource MoneyLineTemplate}" Focusable="False" Margin="0,4,0,0" />
                                    <Border Height="1" Background="{StaticResource PanelEdge}" Margin="0,8" />
                                    <TextBlock Text="You should clear" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock x:Name="NetText" Text="{Binding NetRange}" FontSize="19" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource ToneGood}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NetTone}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding NetTone}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    <TextBlock Text="{Binding NetExpected}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- the risks -->
                                <StackPanel Visibility="{Binding HasRisks, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="What could go wrong" Style="{StaticResource Text.Heading}" Margin="0,12,0,6" />
                                    <ItemsControl ItemsSource="{Binding Risks}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <controls:Icon x:Name="ic" DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Brush="{StaticResource ToneWarn}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Secondary}" FontSize="12" ToolTip="{Binding Tip}" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="ic" Property="Brush" Value="{StaticResource ToneBad}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="ic" Property="Brush" Value="{StaticResource ToneInfo}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- other cards announced near ours that cost nothing: information only -->
                                <StackPanel Visibility="{Binding HasAlsoThatWeek, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Also that week" Style="{StaticResource Text.Heading}" Margin="0,10,0,4" />
                                    <ItemsControl ItemsSource="{Binding AlsoThatWeek}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <controls:Icon DockPanel.Dock="Left" Kind="Calendar" Width="16" Height="16" Brush="{StaticResource TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- the partners -->
                                <TextBlock Text="What partners want from this card" Style="{StaticResource Text.Heading}" Margin="0,16,0,2" />
                                <TextBlock Text="{Binding PartnersSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Partners}" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="pb" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="10,8" Margin="0,0,0,6"
                                                    BorderThickness="3,0,0,0" BorderBrush="{StaticResource ToneGood}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Text.Caption}" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Fee, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Strikes, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Terms}" Margin="0,4,0,0" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,1">
                                                                    <TextBlock x:Name="g" DockPanel.Dock="Left" Text="{Binding Glyph}" Width="16" FontWeight="Bold" Foreground="{StaticResource ToneGood}" />
                                                                    <TextBlock TextWrapping="Wrap" FontSize="12">
                                                                        <Run Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run x:Name="gap" Text="{Binding Gap, Mode=OneWay, StringFormat='  ({0})'}" Foreground="{StaticResource TextSecondary}" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissed}" Value="True"><Setter TargetName="g" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="gap" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOnTheNight}" Value="True"><Setter TargetName="g" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasGap}" Value="False"><Setter TargetName="gap" Property="Text" Value="" /></DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock x:Name="verdict" Text="{Binding Verdict}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="pb" Property="BorderBrush" Value="{StaticResource ToneWarn}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                                    <Setter TargetName="pb" Property="BorderBrush" Value="{StaticResource ToneBad}" />
                                                    <Setter TargetName="verdict" Property="Foreground" Value="{StaticResource ToneBad}" />
                                                    <Setter TargetName="verdict" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasVerdict}" Value="False"><Setter TargetName="verdict" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- the poster -->
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource CardButton}" Command="{Binding OpenPosterCommand}" Width="92" Height="130" Margin="0,0,12,0"
                                            ToolTip="Open the poster">
                                        <Image Source="{Binding Poster}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="The poster" Style="{StaticResource Text.Heading}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="It draws itself from your main event and redraws when the headliners change." />
                                        <Button Style="{StaticResource Button.Link}" Content="Open the poster ▸" Command="{Binding OpenPosterCommand}" HorizontalAlignment="Left" Margin="-4,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== the picker ===== -->
                        <DockPanel Visibility="{Binding IsRailPicker, Converter={StaticResource BoolToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="✕" Command="{Binding CloseRailCommand}" ToolTip="Close the picker" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding PickerTitle}" Style="{StaticResource Text.Title}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PickerHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,6,10"
                                       Visibility="{Binding ShowFinderTools, Converter={StaticResource InverseBoolToVis}}" />

                            <!-- replace a corner -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,6,8" Visibility="{Binding IsReplacing, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Segmented}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentedOption}" GroupName="replaceSide" IsChecked="{Binding ReplacingRed}">
                                            <TextBlock><Run Text="Replace " /><Run Text="{Binding ReplaceRedName, Mode=OneWay}" /></TextBlock>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentedOption}" GroupName="replaceSide" IsChecked="{Binding ReplacingBlue}">
                                            <TextBlock><Run Text="Replace " /><Run Text="{Binding ReplaceBlueName, Mode=OneWay}" /></TextBlock>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <!-- a new bout: three ways in -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,6,8" Visibility="{Binding IsPickingSlot, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Segmented}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Suggested" GroupName="pickMode" IsChecked="{Binding PickSuggested}"
                                                     ToolTip="The matchmaker's pairings for this slot" />
                                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Find a fighter" GroupName="pickMode" IsChecked="{Binding PickDivision}"
                                                     ToolTip="Search your whole roster (Ctrl+F); pick one and every opponent is ranked by the fight they'd make" />
                                        <RadioButton Style="{StaticResource SegmentedOption}" Content="Local" GroupName="pickMode" IsChecked="{Binding PickLocal}"
                                                     ToolTip="One of yours against the local club scene"
                                                     Visibility="{Binding HasLocalOption, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- the finder: search, scope, sort, chips -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,6,6" Visibility="{Binding ShowFinderTools, Converter={StaticResource BoolToVis}}">
                                <TextBox x:Name="FinderSearchBox" Style="{StaticResource SearchBox}" Tag="Search by name or nickname  (Ctrl+F)"
                                         Text="{Binding FinderSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" PreviewKeyDown="OnFinderSearchKey"
                                         AutomationProperties.Name="Search your roster" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding FinderScope}" Height="28" AutomationProperties.Name="Division"
                                              ToolTip="Narrow to one division (a filter, not a must)" IsEnabled="{Binding ShowScope}" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Height="28" AutomationProperties.Name="Sort by"
                                              ToolTip="How the list is ordered (ready fighters always first)" />
                                </Grid>
                                <!-- a short window folds the chips to one line until opened -->
                                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-4,4,0,0" FontSize="12" Command="{Binding ToggleFiltersCommand}"
                                        ToolTip="Show or fold the filters">
                                    <Button.Visibility>
                                        <Binding Path="(controls:Adaptive.IsCompact)" RelativeSource="{RelativeSource Self}" Converter="{StaticResource BoolToVis}" />
                                    </Button.Visibility>
                                    <TextBlock Text="{Binding FiltersLine}" TextWrapping="Wrap" />
                                </Button>
                                <ItemsControl ItemsSource="{Binding FinderChips}" Focusable="False" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding (controls:Adaptive.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding FiltersOpen}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource FilterChip.Compact}" IsChecked="{Binding IsOn}" ToolTip="{Binding Tip}" Content="{Binding Text}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,0,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Clear" FontSize="12" Command="{Binding ClearFinderCommand}"
                                            ToolTip="Clear the search and every filter" />
                                    <TextBlock Text="{Binding FinderCount}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>

                            <Grid>
                                <!-- Suggested -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPickingSlot}" Value="True" />
                                                        <Condition Binding="{Binding PickSuggested}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel>
                                        <!-- the fighters who need a fight: the finder, filtered to them -->
                                        <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-4,-4,0,6" Command="{Binding ShowNeedsCommand}"
                                                Visibility="{Binding HasNeedsLine, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Long lay-offs, deals running out and grievances a booking would fix">
                                            <TextBlock><Run Text="{Binding NeedsLine, Mode=OneWay}" /><Run Text=" ▸" /></TextBlock>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource ProposalTemplate}" Focusable="False" />
                                        <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding SuggestionsEmpty}" Style="{StaticResource Text.Secondary}" />
                                            <Button Style="{StaticResource Button.Primary}" Content="Sign fighters" Command="{Binding OpenContractsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Visibility="{Binding HasRoster, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Find / Local / Replace: the finder's list -->
                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPickingSlot}" Value="True" />
                                                        <Condition Binding="{Binding PickSuggested}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>

                                    <!-- the first corner, once picked -->
                                    <Border DockPanel.Dock="Top" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="10,6" Margin="0,0,6,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasRedPick}" Value="True" />
                                                            <Condition Binding="{Binding IsPickingSlot}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Change" Command="{Binding ClearRedCommand}" />
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <Run Text="FIRST CORNER  " FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding RedHead, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource CornerRedText}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <WrapPanel Margin="-4,2,0,0">
                                                <Button Style="{StaticResource Button.Link}" Content="Suggest one" FontSize="12" Command="{Binding SuggestOpponentCommand}"
                                                        ToolTip="The matchmaker picks the most compelling opponent on our reads"
                                                        Visibility="{Binding ShowSuggestOne, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource Button.Link}" Content="Or a local opponent ▸" FontSize="12" Margin="6,0,0,0"
                                                        Command="{Binding LocalInsteadCommand}" Visibility="{Binding ShowLocalInstead, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Put him against the local club scene instead: cheap, easy work for a prospect" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- local opponent: the style and the button -->
                                    <Border DockPanel.Dock="Top" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="10,8" Margin="0,0,6,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding PickLocal}" Value="True" />
                                                            <Condition Binding="{Binding IsPickingSlot}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap"
                                                       Text="One of yours against the local club scene: easy work for a flat $1,000 local, and it builds a prospect up. Careful: locals occasionally bite." />
                                            <TextBlock Text="{Binding LocalPickLine}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock Text="Opponent's style" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Width="120" Height="28" ItemsSource="{Binding LocalStyles}" SelectedItem="{Binding SelectedLocalStyle}" AutomationProperties.Name="Local opponent's style" />
                                                <TextBlock Text="Rounds" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                                <ComboBox Width="56" Height="28" ItemsSource="{Binding RoundsOptions}" SelectedItem="{Binding SelectedRounds}" AutomationProperties.Name="Rounds" />
                                            </WrapPanel>
                                            <Button Style="{StaticResource Button.Primary}" Content="Book the local fight" Command="{Binding AddLocalBoutCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,6" />
                                        </StackPanel>
                                    </Border>

                                    <!-- the list (hidden in local mode once a fighter is chosen) -->
                                    <DockPanel>
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasRedPick}" Value="True" />
                                                            <Condition Binding="{Binding PickLocal}" Value="True" />
                                                            <Condition Binding="{Binding IsPickingSlot}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <!-- who needs a fight: your idle, expiring and unhappy, one click from an opponent -->
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,6,6" Visibility="{Binding ShowNeedsStrip, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-4,0,0,2" Command="{Binding ToggleNeedsCommand}"
                                                    ToolTip="Your fighters a booking would help most: grievances, expiring deals, long lay-offs">
                                                <TextBlock Text="{Binding NeedsTitle}" Style="{StaticResource Text.Kicker}" />
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding NeedsAFight}" Focusable="False">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding (controls:Adaptive.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                                                                    <Condition Binding="{Binding NeedsOpen}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4" ToolTip="{Binding Tip}">
                                                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="5" ClipToBounds="True" Background="{StaticResource SurfaceSunken}" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                                                            </Border>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="Opponent ▸" FontSize="12" VerticalAlignment="Top" Margin="4,0,-4,0"
                                                                    Command="{Binding Desk.FindOpponentCommand}" CommandParameter="{Binding}"
                                                                    ToolTip="Find him an opponent: everyone he could fight, best fight first" />
                                                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Line, Mode=OneWay}" Foreground="{StaticResource ToneWarn}" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding LadderTitle}" Style="{StaticResource Text.Kicker}" TextWrapping="Wrap" Margin="0,0,6,6"
                                                   Visibility="{Binding ShowSuggestOne, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding LadderEmpty}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,6,0"
                                                   Visibility="{Binding HasLadder, Converter={StaticResource InverseBoolToVis}}" />
                                        <ListBox x:Name="FinderList" Style="{StaticResource CardList}" ItemsSource="{Binding Ladder}" ItemTemplate="{StaticResource LadderTemplate}"
                                                 Padding="0,0,6,0" PreviewKeyDown="OnFinderListKey" AutomationProperties.Name="Fighters" />
                                    </DockPanel>
                                </DockPanel>
                            </Grid>
                        </DockPanel>

                        <!-- ===== the room ===== -->
                        <DockPanel Visibility="{Binding IsRailRoom, Converter={StaticResource BoolToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="✕" Command="{Binding CloseRailCommand}" ToolTip="Close" VerticalAlignment="Top" />
                                <TextBlock Text="Choose the room" Style="{StaticResource Text.Title}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding RoomsHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,6,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding Rooms}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="room" Style="{StaticResource CardButton}" Margin="0,0,0,8" Command="{Binding Desk.ChooseRoomCommand}" CommandParameter="{Binding}">
                                                <Grid Margin="12,9,12,9">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Border x:Name="booked" DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="6,0,0,0" Background="{DynamicResource OrgAccentDim}" Visibility="Collapsed">
                                                                <TextBlock Text="Booked" Style="{StaticResource Chip.Text}" Foreground="{StaticResource TextPrimary}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <TextBlock Style="{StaticResource Text.Caption}">
                                                            <Run Text="{Binding Seats, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Rent, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding House}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                                        <TextBlock x:Name="bo" Text="{Binding BoxOffice}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ToneGood}" />
                                                        <TextBlock x:Name="note" Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource OrgAccent}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="booked" Property="Visibility" Value="Visible" /></DataTrigger>
                                                <DataTrigger Binding="{Binding BoxOfficePositive}" Value="False"><Setter TargetName="bo" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasNote}" Value="False"><Setter TargetName="note" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ===== plan a card ===== -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="{Binding IsRailPlan, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="✕" Command="{Binding CloseRailCommand}" ToolTip="Close"
                                            Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" />
                                    <TextBlock Text="Plan a card" Style="{StaticResource Text.Title}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,12"
                                           Text="A date, a tier and a host city. The sim picks the best-fitting room there; you can change the room on the card." />
                                <TextBlock Text="Date" Style="{StaticResource Text.Kicker}" />
                                <DatePicker SelectedDate="{Binding NewEventDate}" Margin="0,4,0,10" AutomationProperties.Name="Date" />
                                <TextBlock Text="Card tier" Style="{StaticResource Text.Kicker}" />
                                <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier}" Height="30" Margin="0,4,0,10" AutomationProperties.Name="Card tier">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="t" Text="Fight Night" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Ppv"><Setter TargetName="t" Property="Text" Value="Pay-per-view" /></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="SuperCard"><Setter TargetName="t" Property="Text" Value="Super-card" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Host city" Style="{StaticResource Text.Kicker}" />
                                <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" Height="30" Margin="0,4,0,4"
                                          ToolTip="{Binding SelectedCity.Display}" AutomationProperties.Name="Host city" />
                                <TextBlock Text="{Binding ReachLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <Button Style="{StaticResource Button.Primary}" Content="Put it on the calendar" Command="{Binding NewEventCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== bulk proposals ===== -->
                        <DockPanel Visibility="{Binding IsRailProposals, Converter={StaticResource BoolToVis}}">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,6,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="✕" Command="{Binding CloseRailCommand}" ToolTip="Close without booking" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding ProposedTitle}" Style="{StaticResource Text.Title}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ProposedHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,6,10" />
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding BookProposedText}" Command="{Binding BookProposedCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Not now" Command="{Binding CloseRailCommand}" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding Proposed}" ItemTemplate="{StaticResource ProposedTemplate}" Focusable="False" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
