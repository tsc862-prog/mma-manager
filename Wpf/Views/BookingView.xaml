<UserControl x:Class="MmaManager.Wpf.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <!-- Three columns: the fight card is the star column so the lineup
             gets every spare pixel; Add bout + Tale of the Tape share the
             fixed right rail (the tape list scrolls internally). -->
        <Grid Margin="8" DataContext="{Binding Booking}" HorizontalAlignment="Left" MaxWidth="2060">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: create an event, pick from your events -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PLAN A NEW CARD" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <TextBlock Text="Date" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <DatePicker SelectedDate="{Binding NewEventDate}" Margin="0,2,0,4" />
                        <TextBlock Text="Card tier" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier}" Margin="0,2,0,4" />
                        <TextBlock Text="Host city" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding ReachLine}" FontSize="11" Foreground="#7B8794" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="+ Create Event" Command="{Binding NewEventCommand}" HorizontalAlignment="Left"
                                FontWeight="SemiBold" Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="YOUR UPCOMING EVENTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding UpcomingEvents}" SelectedItem="{Binding SelectedEvent}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}">
                                    <Run Text="{Binding Date, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Bouts, Mode=OneWay}" /><Run Text=" bouts" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Column 1: the fight card for the selected event -->
            <DockPanel Grid.Column="1" Margin="0,0,10,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Cancel Event" Command="{Binding CancelEventCommand}" />
                    <Button DockPanel.Dock="Right" Content="▶ Watch Tonight" Command="{Binding RunLiveCommand}" Margin="0,0,6,0" FontWeight="SemiBold"
                            ToolTip="Available on fight night — advance to the event date first" />
                    <TextBlock Text="{Binding SelectedEventTitle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="▲ Up the bill" Command="{Binding MoveBoutUpCommand}"
                            ToolTip="Move the selected fight toward the main event" />
                    <Button Content="▼ Down the bill" Command="{Binding MoveBoutDownCommand}" Margin="6,0,0,0"
                            ToolTip="Move the selected fight toward the prelims" />
                    <Border Width="1" Background="{StaticResource Border}" Margin="10,2" />
                    <Button Content="Remove Selected Bout" Command="{Binding RemoveBoutCommand}" />
                    <TextBlock Text="Advancing stops on fight night — you'll choose to watch the card live or sim the result."
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <!-- The broadcast window: how much of this card is the main card. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4"
                            Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Main card:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding MainCardOptions}" SelectedItem="{Binding SelectedMainCard}" Width="150"
                              ToolTip="Fights above the divider air as the main card; the rest are prelims (less exposure, less fame). Media deals demand a window of a certain size." />
                </StackPanel>
                <!-- Contract clauses the card as booked would break. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}" Margin="0,0,0,4"
                              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Negative}" FontSize="12" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Projected box office for the card as it stands. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Projection}" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Positive}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProjectionInTheRed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Projection}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid ItemsSource="{Binding Bouts}" SelectedItem="{Binding SelectedBout}" RowHeight="62">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <!-- the marquee: the main event's row carries the lights -->
                                <DataTrigger Binding="{Binding IsMainEvent}" Value="True">
                                    <Setter Property="Background" Value="#241F14" />
                                </DataTrigger>
                                <!-- prelims live below the broadcast window: dimmer lights -->
                                <DataTrigger Binding="{Binding IsPrelim}" Value="True">
                                    <Setter Property="Opacity" Value="0.62" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Matchup is the star column: * widths are re-negotiated on every
                             resize, unlike Auto + a trailing filler, which freezes at the
                             pre-data measure and squishes the card. -->
                        <DataGridTemplateColumn Header="Slot" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Slot}" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMainEvent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Matchup" Width="*" MinWidth="320">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                                                    ToolTip="Double-click to open profile">
                                            <StackPanel.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding RedId}" />
                                            </StackPanel.InputBindings>
                                            <Image Source="{Binding RedPortrait}" Width="52" Height="52" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding RedName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="vs" Foreground="#7C848D" Margin="14,0" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                                                    ToolTip="Double-click to open profile">
                                            <StackPanel.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding BlueId}" />
                                            </StackPanel.InputBindings>
                                            <TextBlock Text="{Binding BlueName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            <Image Source="{Binding BluePortrait}" Width="52" Height="52" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Division" Binding="{Binding Division}" Width="110" />
                        <DataGridTextColumn Header="Rounds" Binding="{Binding Rounds}" Width="60" />
                        <DataGridTextColumn Header="Stakes" Binding="{Binding Stakes}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Column 2: build the matchup — the corner pickers ARE the tale of the tape -->
            <DockPanel Grid.Column="2">

            <!-- Local fight: the small-org special (City/Regional reach only) -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" Background="#20262E" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLocalOption}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Local fight" FontWeight="Bold" />
                    <TextBlock Text="Put your red corner against the local club scene — easy work for $1,000 flat, and it builds a prospect up. Careful: locals occasionally bite."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="120" ItemsSource="{Binding LocalStyles}" SelectedItem="{Binding SelectedLocalStyle}" />
                        <Button Content="Book Local Fight" Command="{Binding AddLocalBoutCommand}" Margin="10,0,0,0" Padding="10,2" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10"
                    IsEnabled="{Binding HasSelectedEvent}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BUILD A MATCHUP" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Division" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox MinWidth="140" ItemsSource="{Binding Divisions}" SelectedItem="{Binding SelectedDivision}" />
                                </StackPanel>
                            </Grid>

                            <!-- The corners: pick a fighter, watch them step in -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border Width="112" Height="150" Background="{StaticResource SurfaceAlt}" BorderBrush="#A8453C" BorderThickness="1" HorizontalAlignment="Center"
                                            Cursor="Hand" ToolTip="Double-click to open profile">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding RedCornerId}" />
                                        </Border.InputBindings>
                                        <Image Source="{Binding RedBig}" Stretch="UniformToFill" VerticalAlignment="Top" />
                                    </Border>
                                    <TextBlock Text="{Binding RedHead}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#E88A80" MinHeight="18" Margin="0,4,0,2"
                                               Background="Transparent" Cursor="Hand" ToolTip="Double-click to open profile">
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding RedCornerId}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <TextBlock Text="Red corner" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox ItemsSource="{Binding RedOptions}" SelectedItem="{Binding SelectedRed}" Margin="0,2,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Rank}" Width="28" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Portrait}" Width="34" Height="34" Margin="2,0,8,0" />
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="vs" Foreground="#7C848D" FontSize="16" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel Grid.Column="2">
                                    <Border Width="112" Height="150" Background="{StaticResource SurfaceAlt}" BorderBrush="#3C639E" BorderThickness="1" HorizontalAlignment="Center"
                                            Cursor="Hand" ToolTip="Double-click to open profile">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding BlueCornerId}" />
                                        </Border.InputBindings>
                                        <Image Source="{Binding BlueBig}" Stretch="UniformToFill" VerticalAlignment="Top" />
                                    </Border>
                                    <TextBlock Text="{Binding BlueHead}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#82AEE8" MinHeight="18" Margin="0,4,0,2"
                                               Background="Transparent" Cursor="Hand" ToolTip="Double-click to open profile">
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding BlueCornerId}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <TextBlock Text="Blue corner" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox ItemsSource="{Binding BlueOptions}" SelectedItem="{Binding SelectedBlue}" Margin="0,2,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Rank}" Width="28" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Portrait}" Width="34" Height="34" Margin="2,0,8,0" />
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Suggest an opponent" Command="{Binding SuggestOpponentCommand}"
                                            ToolTip="Auto-pick the most compelling eligible opponent" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Rounds" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox Width="55" ItemsSource="{Binding RoundsOptions}" SelectedItem="{Binding SelectedRounds}" />
                                <CheckBox Content="Title fight" IsChecked="{Binding IsTitleBout}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <Button Content="Add Bout" Command="{Binding AddBoutCommand}" Margin="16,0,0,0" Padding="14,3"
                                        FontWeight="Bold" Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}" />
                            </StackPanel>

                            <!-- Live matchup appraisal -->
                            <TextBlock Text="{Binding Appraisal}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6" />
                            <TextBlock Text="{Binding HeadToHead}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasHeadToHead, Converter={StaticResource BoolToVis}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Competitive" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding Competitiveness, Mode=OneWay}" Maximum="100" Height="11" Margin="0,2" Foreground="{StaticResource Positive}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Appeal" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Appeal, Mode=OneWay}" Maximum="100" Height="11" Margin="0,2" Foreground="{StaticResource World}" />
                            </Grid>

                            <TextBlock Text="{Binding Status}" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- The tape itself fills whatever is left -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Tape}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,3">
                                            <Border.Resources>
                                                <Style x:Key="EdgeValue" TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </Border.Resources>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Red}" TextAlignment="Right" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EdgeValue}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RedBold}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Blue}" TextAlignment="Left" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EdgeValue}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BlueBold}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
            </Border>
            </DockPanel>

            <!-- Column 3: the auto-generated fight poster — redraws live as
                 the card (and its story) takes shape under your hands -->
            <DockPanel Grid.Column="3" Margin="10,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="THE POSTER" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <Border Background="#0B0C10" BorderBrush="#2A2F38" BorderThickness="1" CornerRadius="4" Padding="6">
                    <Image Source="{Binding Poster}" Stretch="Uniform" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </DockPanel>
        </Grid>
</UserControl>
