<UserControl x:Class="MmaManager.Wpf.Views.OrgsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding OrgsPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: every promotion in the sport -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="ORGANIZATIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Orgs}" SelectedItem="{Binding Selected}" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="34" />
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Logo}" Width="24" Height="24" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Promotion" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Level" Binding="{Binding Tier}" Width="88" />
                        <DataGridTextColumn Header="Prs" Binding="{Binding Prestige}" Width="42" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Right: the ORG PAGE -->
            <Border Grid.Column="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- Masthead -->
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" />
                                <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Prestige" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ProgressBar Width="110" Height="9" Maximum="100" Value="{Binding Prestige, Mode=OneWay}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Prestige}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="5,0,0,0" />
                                    <TextBlock Text="Reputation" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <ProgressBar Width="110" Height="9" Maximum="100" Value="{Binding Reputation, Mode=OneWay}" Foreground="{StaticResource Positive}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Reputation}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding TierLine}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource World}" VerticalAlignment="Center" />
                                    <ProgressBar Width="150" Height="6" Maximum="100" Value="{Binding TierProgress, Mode=OneWay}"
                                                 Foreground="{StaticResource World}" Background="{StaticResource Track}" BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Story}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                   LineHeight="17" Margin="0,10,0,10" MaxHeight="72" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Money & media -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MONEY &amp; MEDIA" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding BalanceText}" FontFamily="Consolas" FontWeight="Bold" FontSize="19" Foreground="{StaticResource Gold}" />
                                <TextBlock Text="{Binding RosterLine}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8" />

                                <ItemsControl ItemsSource="{Binding Deals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="26" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Partner}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Terms}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No broadcast or sponsorship deals — the networks come calling when the level rises."
                                           FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDeals}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding RulesLine}" FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- The belts -->
                        <DockPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="THE BELTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Belts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Prestige}" Foreground="{StaticResource Gold}" FontWeight="Bold"
                                                                   FontSize="11.5" VerticalAlignment="Center" ToolTip="Belt prestige" />
                                                        <TextBlock Text="{Binding Division}" FontSize="10.5" Foreground="{StaticResource TextFaint}" />
                                                    </DockPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Image Source="{Binding ChampPortrait}" Width="26" Height="26" Margin="0,0,7,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="👑 " /><Run Text="{Binding ChampName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding ChampRecord, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ReignLine}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Text="Vacant" FontSize="11" Foreground="{StaticResource TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasChampion}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- The marquee + recent shows -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THE MARQUEE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding TopFighters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,3" Cursor="Hand" ToolTip="Open the profile">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding FighterId}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <Image DockPanel.Dock="Left" Source="{Binding Portrait}" Width="30" Height="30" Margin="0,0,8,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👑 " FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsChampion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="RECENT SHOWS" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,3" Cursor="Hand" ToolTip="Open the event page">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Id}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stars}" Foreground="{StaticResource Gold}" FontSize="11" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DateText}" FontSize="10.5" Foreground="{StaticResource TextFaint}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
</UserControl>
