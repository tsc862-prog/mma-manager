<UserControl x:Class="MmaManager.Wpf.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding EventsPage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: every card in the world -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Right" Content="My events only" IsChecked="{Binding MineOnly}" VerticalAlignment="Center" />
                    <TextBlock Text="EVENTS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding OrgLogo}" Width="24" Height="24" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Event" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" SortMemberPath="Date" Width="92" />
                        <DataGridTextColumn Header="Bouts" Binding="{Binding Bouts}" Width="52" />
                        <DataGridTemplateColumn Header="Rating" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Stars}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Right: the EVENT PAGE -->
            <Border Grid.Column="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- Masthead -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding DetailTitle}" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource OrgAccent}" />
                        <TextBlock Text="{Binding DetailSub}" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FinLine}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FinInRed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- The one-sheet -->
                        <Border Background="#0B0C10" BorderBrush="#2A2F38" BorderThickness="1" CornerRadius="4" Padding="6" VerticalAlignment="Top">
                            <Image Source="{Binding Poster}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- The card, bout by bout -->
                        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Card}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Billing slot -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Slot}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMainEvent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Division}" FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" />
                                                    <TextBlock Text="★ TITLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTitle}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- The matchup + the verdict -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding RedPortrait}" Width="34" Height="34" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding RedName}" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand" ToolTip="Open the profile">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding Gesture="LeftClick"
                                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding RedId}" />
                                                            </TextBlock.InputBindings>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BlueWon}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="vs" Foreground="{StaticResource TextFaint}" Margin="10,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding BlueName}" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand" ToolTip="Open the profile">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding Gesture="LeftClick"
                                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding BlueId}" />
                                                            </TextBlock.InputBindings>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RedWon}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding BluePortrait}" Width="34" Height="34" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ResultLine}" FontSize="12" Foreground="#7BE0A0" />
                                                        <TextBlock Text="🏆 NEW CHAMPION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="10,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NewChampion}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Stars}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
</UserControl>
