<UserControl x:Class="MmaManager.Wpf.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Figure" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FigureIn" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
    </UserControl.Resources>

    <!-- The Media desk: who airs us, who's calling, and the screens still to climb. -->
    <DockPanel DataContext="{Binding Media}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="📡 THE MEDIA DESK" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="One deal per screen: a linear TV home, a streaming home, and the pay-per-view pipe. Networks pitch once — sign them or watch them move on."
                           FontSize="12" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- Left: our deals, the platform, the offers -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="ON THE AIR — OUR DEALS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding Deals}" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Terms}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Screen" Binding="{Binding Kind}" Width="150" />
                            <DataGridTextColumn Header="Partner" Binding="{Binding Partner}" Width="*" />
                            <DataGridTextColumn Header="Pays" Binding="{Binding Fee}" SortMemberPath="FeeSort" Width="120" ElementStyle="{StaticResource FigureIn}" />
                            <DataGridTextColumn Header="Left" Binding="{Binding Left}" Width="60" ElementStyle="{StaticResource Figure}" />
                            <DataGridTextColumn Header="" Binding="{Binding Strikes}" Width="46" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="OUR OWN PLATFORM" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasStream, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StreamHeadline}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Gold}" />
                                <TextBlock Text="{Binding StreamDetail}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding StreamPitch}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StreamPitch}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="🎬 Launch our streaming service" Command="{Binding LaunchStreamCommand}"
                                        HorizontalAlignment="Left" FontWeight="SemiBold"
                                        Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}"
                                        Visibility="{Binding CanLaunchStream, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OFFERS ON THE TABLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Offers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Sign" Padding="10,2" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.AcceptOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Pass" Padding="10,2"
                                                    ToolTip="They only ask once — a passed network won't call again until it's back on the market"
                                                    Command="{Binding DataContext.DeclineOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Partner}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap">
                                                <Run Text="{Binding Fee, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Term, Mode=OneWay}" /><Run Text=" · expires " /><Run Text="{Binding Expires, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Terms}" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No offers right now. Networks call when the promotion is worth airing — grow the reach, build a star, keep running cards."
                               Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Offers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: the ladder of screens -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="THE LADDER — EVERY SCREEN IN THE SPORT" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Ladder}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Qualified}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Fee}" Style="{StaticResource FigureIn}" />
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Signed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock Text="{Binding Terms}" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
