<UserControl x:Class="MmaManager.Wpf.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Figure" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FigureIn" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
        </Style>
    </UserControl.Resources>

    <!-- The Media desk: who airs us, who's calling, and the screens still to climb. -->
    <DockPanel x:Name="Desk" DataContext="{Binding Media}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="📡 THE MEDIA DESK" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>

            <!-- Left: our deals, the platform, the offers -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource CardsTableToggle}" IsChecked="{Binding ShowDealTable}" />
                        <TextBlock Text="ON THE AIR — OUR DEALS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Deals}" ItemTemplate="{StaticResource DealRowTemplate}" Focusable="False" Margin="0,0,0,12"
                                  Visibility="{Binding ShowDealTable, Converter={StaticResource InverseBoolToVis}}" />
                    <DataGrid ItemsSource="{Binding Deals}" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12"
                              Visibility="{Binding ShowDealTable, Converter={StaticResource BoolToVis}}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Terms}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Screen" Binding="{Binding Kind}" Width="150" />
                            <DataGridTextColumn Header="Partner" Binding="{Binding Partner}" Width="*" />
                            <DataGridTextColumn Header="Pays" Binding="{Binding Fee}" SortMemberPath="FeeSort" Width="120" ElementStyle="{StaticResource FigureIn}" />
                            <DataGridTextColumn Header="Left" Binding="{Binding Left}" Width="60" ElementStyle="{StaticResource Figure}" />
                            <DataGridTextColumn Header="" Binding="{Binding Strikes}" Width="46" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nobody airs us yet." Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Deals.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="OUR OWN PLATFORM" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasStream, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StreamHeadline}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Gold}" />
                                <TextBlock Text="{Binding StreamDetail}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <!-- the quiet way out: opens the confirmation below, closes nothing by itself -->
                                <Button Content="{Binding ShutdownLabel}" Command="{Binding AskShutdownCommand}" Style="{StaticResource Button.Quiet}"
                                        HorizontalAlignment="Left" Margin="-4,6,0,0"
                                        ToolTip="See what closing it costs first: nothing shuts until you confirm"
                                        Visibility="{Binding ShowShutdown, Converter={StaticResource InverseBoolToVis}}" />
                                <!-- the confirmation: what goes with it, in three numbers and a sentence or two -->
                                <Border DataContext="{Binding Shutdown}" Background="{StaticResource ToneBadDim}" CornerRadius="{StaticResource Radius.Card}"
                                        Padding="12,10,12,12" Margin="0,10,0,0"
                                        Visibility="{Binding DataContext.ShowShutdown, ElementName=Desk, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Kicker}" Foreground="{StaticResource ToneBad}">
                                            <Run Text="SHUT DOWN " /><Run Text="{Binding Platform, Mode=OneWay}" /><Run Text="?" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Lede}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" />
                                        <Grid Margin="0,10,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Subscribers}" Style="{StaticResource Text.Stat}" />
                                                <TextBlock Text="subscribers lost" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding NetPerQuarter}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Stat}">
                                                            <Setter Property="Foreground" Value="{StaticResource ToneGood}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetUp}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource ToneBad}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="it nets a quarter now" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Relaunch}" Style="{StaticResource Text.Stat}" />
                                                <TextBlock Text="to relaunch, from zero" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Reach}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding RelaunchLine}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="{Binding ConfirmLabel}" Style="{StaticResource Button.Danger}" Padding="14,5" FontSize="12.5" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ShutdownCommand, ElementName=Desk}" />
                                            <Button Content="Keep it running" Style="{StaticResource Button.Primary}" Padding="14,5" FontSize="12.5"
                                                    Command="{Binding DataContext.CancelShutdownCommand, ElementName=Desk}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding StreamPitch}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StreamPitch}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="🎬 Launch our streaming service" Command="{Binding LaunchStreamCommand}"
                                        HorizontalAlignment="Left" FontWeight="SemiBold"
                                        Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}"
                                        Visibility="{Binding CanLaunchStream, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OFFERS ON THE TABLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Offers}" ItemTemplate="{StaticResource OfferCardTemplate}" Focusable="False" />
                    <TextBlock Text="No offers right now. Networks call when the promotion is worth airing — grow the reach, build a star, keep running cards."
                               Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Offers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: the ladder of screens -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="THE LADDER — EVERY SCREEN IN THE SPORT" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <!-- the screens the sport hasn't got yet (Origins): said plainly, not listed as rungs to climb -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="12,10" Margin="0,8,0,0"
                        Visibility="{Binding HasNotYet, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="NOT IN THE SPORT YET" Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding NotYetLine}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Ladder}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6" ToolTip="{Binding Terms}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Qualified}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Fee}" Style="{StaticResource FigureIn}" />
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Signed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock Text="{Binding ShortTerms}" Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" />
                                        <!-- the networks on this rung: the one airing us lit, the rest quieter -->
                                        <ItemsControl ItemsSource="{Binding Partners}" Margin="0,6,0,0" Focusable="False"
                                                      Visibility="{Binding HasPartners, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="b" Width="112" Padding="4,5,4,4" Margin="0,0,6,6" CornerRadius="6" BorderThickness="1"
                                                            BorderBrush="Transparent" Background="{StaticResource SurfaceSunken}" Opacity="0.85" ToolTip="{Binding Name}">
                                                        <StackPanel>
                                                            <ContentControl Style="{StaticResource BrandMark}" Content="{Binding Name}" Width="100" Height="56" />
                                                            <!-- the name, always: some marks are too fine to read at this size -->
                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource TextSoft}" TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding OnAir}" Value="True">
                                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                            <Setter TargetName="b" Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
