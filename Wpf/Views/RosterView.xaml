<UserControl x:Class="MmaManager.Wpf.Views.RosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="8" DataContext="{Binding MyRoster}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="(double-click a fighter for their profile)"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The gym floor: everyone on your books, front-office columns first -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Fighters}" RowHeight="40" mvvm:FighterLink.OpenOnDoubleClick="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Portrait}" Width="34" Height="34" Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="" Binding="{Binding Badges}" Width="44" />
                    <DataGridTextColumn Header="Division" Binding="{Binding Division}" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" />
                    <DataGridTextColumn Header="Record" Binding="{Binding Record}" SortMemberPath="RecordSort"/>
                    <DataGridTextColumn Header="Scout" Binding="{Binding Ovr}" />
                    <DataGridTemplateColumn Header="Form" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Form}" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Cold}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Morale" Binding="{Binding Morale}" />
                    <DataGridTextColumn Header="Loyalty" Binding="{Binding Loyalty}" />
                    <DataGridTemplateColumn Header="Contract" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ContractLine}" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <!-- last bout on the deal: the giants may be circling -->
                                                <DataTrigger Binding="{Binding ExpiringSoon}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Camp" Binding="{Binding CampName}" Width="150" />
                    <DataGridTemplateColumn Header="Availability" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Availability}" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSidelined}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- The founded-org day one: an empty gym and a job to do -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="The gym is empty." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Sign fighters from the free-agent market on the Contracts screen, then book your first card."
                           Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
</UserControl>
