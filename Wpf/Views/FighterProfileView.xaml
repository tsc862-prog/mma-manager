<UserControl x:Class="MmaManager.Wpf.Views.FighterProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The fighter themselves, near life-size down the left —
                 the pack bodies are transparent cut-outs, so they stand
                 straight on the page. -->
            <Image Grid.Column="0" Grid.RowSpan="2" Source="{Binding SelectedFighter.BodyShot}"
                   Width="235" MaxHeight="650" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,16,0" />

            <!-- Header: vitals -->
            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedFighter.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFighter.Badges}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding SelectedFighter.AccoladesText}" />
                            <Image Source="{Binding SelectedFighter.OrgLogo}" Width="40" Height="40" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedFighter.Nickname}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding SelectedFighter.Bio}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SelectedFighter.Physicals}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="SCOUT " FontSize="16" VerticalAlignment="Center"
                                       ToolTip="{Binding ScoutTip}" />
                            <TextBlock Text="{Binding SelectedFighter.Ovr}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFighter.Record}" FontSize="16" Margin="18,0,0,0" VerticalAlignment="Center" />
                            <!-- Drawing power: a public fact; the word, the meter and the number -->
                            <TextBlock Text="DRAW" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="22,1,8,0" VerticalAlignment="Center" />
                            <controls:DrawMeter Value="{Binding SelectedFighter.Popularity}" ShowNumber="True" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedFighter.Finishes}" Margin="0,4,0,0" Foreground="#A8B0B9" />
                        <TextBlock Text="{Binding SelectedFighter.StatusLine}" Margin="0,4,0,0" />

                        <!-- The paper: who holds it, and on what terms -->
                        <TextBlock Text="{Binding SelectedFighter.CompanyLine}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   ToolTip="Open the promotion's page">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedFighter.HasCompany}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="TextDecorations" Value="Underline" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenOrgCommand}"
                                              CommandParameter="{Binding SelectedFighter.CompanyId}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.ContractText}" Margin="0,2,0,0" Foreground="#A8B0B9" />
                        <TextBlock Text="{Binding SelectedFighter.ContractDetail}" FontSize="11.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.ContractDetail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.AskLine}" Style="{StaticResource BondLineText}"
                                   Foreground="#D6DADF" FontStyle="Italic" MaxWidth="680" HorizontalAlignment="Left" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SelectedFighter.BondLine}" Style="{StaticResource BondLineText}"
                                   MaxWidth="680" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedFighter.CareerOrgs}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.CareerOrgs}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Front office: spend to keep & build your own fighters -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding ShortlistButtonText}" Command="{Binding ToggleShortlistCommand}"
                                    CommandParameter="{Binding SelectedFighter.Id}" Padding="9,4" Margin="0,0,8,0"
                                    ToolTip="Pin them to the shortlist in the Notes app" />
                            <Button Content="Contract talks" Command="{Binding NegotiateFighterCommand}"
                                    CommandParameter="{Binding SelectedFighter.Id}" Padding="9,4"
                                    Visibility="{Binding IsObserving, Converter={StaticResource InverseBoolToVis}}"
                                    ToolTip="Open negotiations on the Contracts screen — free agents, or re-signing your own" />
                        </StackPanel>
                        <!-- (Wraps at the bio's width: four long labels in one row ran off the panel.) -->
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsMine}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <Button Content="{Binding RetentionButtonText}" Command="{Binding RetainFighterCommand}"
                                    Padding="9,4" Margin="0,0,8,6" />
                            <Button Content="{Binding MarketingButtonText}" Command="{Binding ToggleMarketingCommand}"
                                    Padding="9,4" Margin="0,0,8,6" />
                            <Button Content="{Binding CampButtonText}" Command="{Binding ToggleCampStipendCommand}"
                                    Padding="9,4" Margin="0,0,8,6" />
                            <Button Content="{Binding FaceButtonText}" Command="{Binding MakeFaceCommand}"
                                    Padding="9,4" Margin="0,0,0,6" />
                        </WrapPanel>

                        <!-- The people in their life, as a passage: leads the bio (Biographer.PeopleText) -->
                        <Border Style="{StaticResource PeoplePassage}"
                                Visibility="{Binding SelectedFighter.HasPeople, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedFighter.PeopleKicker}" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource Gold}" FontSize="10.5" />
                                <TextBlock Text="{Binding SelectedFighter.PeopleText}" Style="{StaticResource PeoplePassage.Text}" />
                            </StackPanel>
                        </Border>
                        <!-- Bonds: family, friends, mentors, feuds — the list, when there is no passage to say it -->
                        <TextBlock Text="{Binding SelectedFighter.BondsText}" Margin="0,8,0,0" LineHeight="19"
                                   Foreground="#9FB6C9" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.ShowBondsList}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.StoryBelowPeople}" TextWrapping="Wrap" MaxWidth="680" LineHeight="18" HorizontalAlignment="Left"
                                   Foreground="#C9CFD6" FontStyle="Italic" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body: ratings (as bars) + fight history -->
            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <Border Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,5" Margin="0,0,12,10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedFighter.ScoutingLine}" FontSize="11" Foreground="#C9CFD6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Where the name carries: the hottest cities as heat chips, the regions that know him, and the map -->
                    <Border Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,8"
                            Margin="0,0,12,12" MaxWidth="476" HorizontalAlignment="Left">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding SelectedFighter.FameMapText}" Style="{StaticResource Button.Link}" Padding="0"
                                        Command="{x:Static mvvm:AppCommands.ShowFame}" CommandParameter="{Binding SelectedFighter.Id}"
                                        ToolTip="The World Map as a heat map of this name, city by city" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Kind="Flame" Width="14" Height="14" Brush="{StaticResource DrawInk}" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedFighter.FameKicker}" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource DrawInk}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedFighter.FameLine}" FontSize="12" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding SelectedFighter.FameHotSpots}" Focusable="False" Margin="0,8,0,0"
                                          Visibility="{Binding SelectedFighter.IsKnownNowhere, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HotSpotChip}" Command="{x:Static mvvm:AppCommands.ShowFame}"
                                                CommandParameter="{Binding DataContext.SelectedFighter.Id, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{Binding Word}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding SelectedFighter.KnownRegions}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" Height="9" Margin="2,0"
                                                         Foreground="{StaticResource DrawInk}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SelectedFighter.RatingGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="232" Margin="0,0,12,12" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Ratings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="46" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarValue, Mode=OneWay}"
                                                                     Foreground="{Binding BarBrush}" Opacity="{Binding BarOpacity}" Height="11" Margin="2,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <!-- Promises made to him at the table: what, by when, how it's going; at risk highlighted -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Padding="10,8" Margin="0,0,0,10"
                            Visibility="{Binding SelectedFighter.HasPromises, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="PROMISES" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"
                                       ToolTip="{Binding SelectedFighter.IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Written into his deal at the table. Kept: he remembers. Broken: he takes it hard, and it’s public.'}" />
                            <ItemsControl ItemsSource="{Binding SelectedFighter.OpenPromises}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PromiseCard}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding BookText}" Style="{StaticResource Button.Soft}"
                                                        Command="{x:Static mvvm:AppCommands.BookFighter}" CommandParameter="{Binding FighterId}"
                                                        VerticalAlignment="Center" Margin="10,0,0,0" Padding="10,4"
                                                        Visibility="{Binding CanBook, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Opens the card desk on your next card he can make, with him in the first corner'}" />
                                                <Button DockPanel.Dock="Right" Content="Talk terms ▸" Style="{StaticResource Button.Soft}"
                                                        Command="{Binding DataContext.NegotiateFighterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FighterId}"
                                                        VerticalAlignment="Center" Margin="10,0,0,0" Padding="10,4"
                                                        Visibility="{Binding CanTalk, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Opens contract talks with him: re-sign him, then book him'}" />
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="{StaticResource ToneBadDim}"
                                                                Visibility="{Binding AtRisk, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="AT RISK" Style="{StaticResource Chip.Text}" FontWeight="Bold" Foreground="{StaticResource Negative}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding What}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="{Binding Status, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding Progress, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Why}" FontSize="11.5" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasWhy, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding SelectedFighter.PastPromises}" Margin="0,2,0,0"
                                          Visibility="{Binding SelectedFighter.HasPastPromises, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- The trophy case: reigns off every belt's lineage + the honours -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Padding="10,8" Margin="0,0,0,10" MaxHeight="215">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFighter.HasAchievements}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="🏆 ACHIEVEMENTS" Style="{StaticResource SectionLabel}"
                                       Foreground="{StaticResource Gold}" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedFighter.CareerAchievements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="26" FontSize="13" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Fight History" FontWeight="Bold" Margin="0,0,0,4" />
                    <!-- Off-the-books remainder: club-circuit bouts no commission taped,
                         so the record and the listed fights always reconcile. -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedFighter.UnlistedBouts}"
                               Foreground="{StaticResource TextFaint}" FontSize="11" FontStyle="Italic" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFighter.UnlistedBouts}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding SelectedFighter.History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding When}" SortMemberPath="Date" Width="88" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="60" />
                            <DataGridTextColumn Header="Rating" Binding="{Binding Stars}" Width="76" />
                            <DataGridTemplateColumn Header="Opponent" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Opponent}" VerticalAlignment="Center" Margin="4,0"
                                                   Cursor="Hand" ToolTip="Open their profile">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding OpponentId}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="128" />
                            <DataGridTextColumn Header="End" Binding="{Binding Round}" Width="64" />
                            <DataGridTextColumn Header="Org" Binding="{Binding Org}" Width="52" />
                            <DataGridTemplateColumn Header="Event" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Event}" VerticalAlignment="Center" Margin="4,0"
                                                   Cursor="Hand" ToolTip="Open the event page">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding EventId}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
</UserControl>
