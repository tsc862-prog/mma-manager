<UserControl x:Class="MmaManager.Wpf.Views.FighterProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The fighter themselves, near life-size down the left —
                 the pack bodies are transparent cut-outs, so they stand
                 straight on the page. -->
            <Image Grid.Column="0" Grid.RowSpan="2" Source="{Binding SelectedFighter.BodyShot}"
                   Width="235" MaxHeight="650" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,16,0" />

            <!-- Header: vitals -->
            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedFighter.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFighter.Badges}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding SelectedFighter.AccoladesText}" />
                            <Image Source="{Binding SelectedFighter.OrgLogo}" Width="40" Height="40" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedFighter.Nickname}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding SelectedFighter.Bio}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SelectedFighter.Physicals}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="SCOUT " FontSize="16" VerticalAlignment="Center"
                                       ToolTip="Your scouts' read — the truth may differ until they're proven" />
                            <TextBlock Text="{Binding SelectedFighter.Ovr}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFighter.Record}" FontSize="16" Margin="18,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedFighter.Finishes}" Margin="0,4,0,0" Foreground="#A8B0B9" />
                        <TextBlock Text="{Binding SelectedFighter.StatusLine}" Margin="0,4,0,0" />

                        <!-- The paper: who holds it, and on what terms -->
                        <TextBlock Text="{Binding SelectedFighter.CompanyLine}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   ToolTip="Open the promotion's page">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedFighter.HasCompany}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="TextDecorations" Value="Underline" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenOrgCommand}"
                                              CommandParameter="{Binding SelectedFighter.CompanyId}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.ContractText}" Margin="0,2,0,0" Foreground="#A8B0B9" />
                        <TextBlock Text="{Binding SelectedFighter.ContractDetail}" FontSize="11.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.ContractDetail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.CareerOrgs}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.CareerOrgs}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Front office: spend to keep & build your own fighters -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding ShortlistButtonText}" Command="{Binding ToggleShortlistCommand}"
                                    CommandParameter="{Binding SelectedFighter.Id}" Padding="9,4" Margin="0,0,8,0"
                                    ToolTip="Pin them to the shortlist in the Notes app" />
                            <Button Content="Contract talks" Command="{Binding NegotiateFighterCommand}"
                                    CommandParameter="{Binding SelectedFighter.Id}" Padding="9,4"
                                    ToolTip="Open negotiations on the Contracts screen — free agents, or re-signing your own" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsMine}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="{Binding RetentionButtonText}" Command="{Binding RetainFighterCommand}"
                                    Padding="9,4" Margin="0,0,8,0" />
                            <Button Content="{Binding MarketingButtonText}" Command="{Binding ToggleMarketingCommand}"
                                    Padding="9,4" Margin="0,0,8,0" />
                            <Button Content="{Binding CampButtonText}" Command="{Binding ToggleCampStipendCommand}"
                                    Padding="9,4" Margin="0,0,8,0" />
                            <Button Content="{Binding FaceButtonText}" Command="{Binding MakeFaceCommand}"
                                    Padding="9,4" />
                        </StackPanel>

                        <!-- Bonds: family, friends, mentors, feuds — the relationship graph made visible -->
                        <TextBlock Text="{Binding SelectedFighter.BondsText}" Margin="0,8,0,0" LineHeight="19"
                                   Foreground="#9FB6C9" TextWrapping="Wrap" MaxWidth="680">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFighter.HasBonds}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFighter.Story}" TextWrapping="Wrap" MaxWidth="680" LineHeight="18"
                                   Foreground="#C9CFD6" FontStyle="Italic" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body: ratings (as bars) + fight history -->
            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <Border Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,5" Margin="0,0,12,10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedFighter.ScoutingLine}" FontSize="11" Foreground="#C9CFD6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SelectedFighter.RatingGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="232" Margin="0,0,12,12" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding Ratings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="46" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarValue, Mode=OneWay}"
                                                                     Foreground="{Binding BarBrush}" Opacity="{Binding BarOpacity}" Height="11" Margin="2,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="300" HorizontalAlignment="Left" Margin="0,0,12,12" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Regional Fame" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,5" />
                            <ItemsControl ItemsSource="{Binding SelectedFighter.RegionalFame}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" Height="11" Margin="2,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <!-- The trophy case: reigns off every belt's lineage + the honours -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" Padding="10,8" Margin="0,0,0,10" MaxHeight="215">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFighter.HasAchievements}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="🏆 ACHIEVEMENTS" Style="{StaticResource SectionLabel}"
                                       Foreground="{StaticResource Gold}" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedFighter.CareerAchievements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="26" FontSize="13" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Fight History" FontWeight="Bold" Margin="0,0,0,4" />
                    <!-- Off-the-books remainder: club-circuit bouts no commission taped,
                         so the record and the listed fights always reconcile. -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedFighter.UnlistedBouts}"
                               Foreground="{StaticResource TextFaint}" FontSize="11" FontStyle="Italic" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFighter.UnlistedBouts}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding SelectedFighter.History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding When}" SortMemberPath="Date" Width="88" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="60" />
                            <DataGridTextColumn Header="Rating" Binding="{Binding Stars}" Width="76" />
                            <DataGridTemplateColumn Header="Opponent" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Opponent}" VerticalAlignment="Center" Margin="4,0"
                                                   Cursor="Hand" ToolTip="Open their profile">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding OpponentId}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="128" />
                            <DataGridTextColumn Header="End" Binding="{Binding Round}" Width="64" />
                            <DataGridTextColumn Header="Org" Binding="{Binding Org}" Width="52" />
                            <DataGridTemplateColumn Header="Event" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Event}" VerticalAlignment="Center" Margin="4,0"
                                                   Cursor="Hand" ToolTip="Open the event page">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding EventId}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
</UserControl>
