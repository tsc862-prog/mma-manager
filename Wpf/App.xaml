<Application x:Class="MmaManager.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ================= Fight-night palette (dark · gold · crimson) ================= -->
        <SolidColorBrush x:Key="Bg" Color="#16191E" />
        <SolidColorBrush x:Key="Surface" Color="#1E232B" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#262C35" />
        <SolidColorBrush x:Key="Header" Color="#12151A" />
        <SolidColorBrush x:Key="Hover" Color="#2C333D" />
        <SolidColorBrush x:Key="Border" Color="#2E353F" />
        <SolidColorBrush x:Key="BorderStrong" Color="#3A424D" />
        <SolidColorBrush x:Key="GridLine" Color="#242A31" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA4AF" />
        <SolidColorBrush x:Key="TextMuted" Color="#6E7680" />
        <SolidColorBrush x:Key="Gold" Color="#E8B23A" />
        <SolidColorBrush x:Key="Crimson" Color="#D64550" />
        <SolidColorBrush x:Key="Positive" Color="#57C97E" />
        <SolidColorBrush x:Key="Negative" Color="#E5736B" />
        <SolidColorBrush x:Key="SurfaceSunken" Color="#181C22" />
        <SolidColorBrush x:Key="Track" Color="#232A33" />
        <SolidColorBrush x:Key="TextFaint" Color="#8A929B" />
        <SolidColorBrush x:Key="Selection" Color="#3A3320" />

        <!-- The player org's signature colour (its poster palette) — swapped at
             runtime by MainViewModel.RefreshAll, so reference via DynamicResource.
             Defaults to the house gold until a career starts. -->
        <SolidColorBrush x:Key="OrgAccent" Color="#E8B23A" />
        <SolidColorBrush x:Key="OrgAccentDim" Color="#46E8B23A" />

        <!-- ================= Converters (shared by every view) ================= -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <mvvm:InverseBoolToVisibility x:Key="InverseBoolToVis" />

        <!-- ================= Text ================= -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <!-- Small-caps section label ("FREE AGENTS", "YOUR OFFER", …) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- A content card: the standard panel chrome for screen sections. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Small grey caption above an input ("Date", "Host city", …) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- An empty panel says what to do next instead of showing blank controls. -->
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>

        <!-- A folded notice strip (contract warnings, cautions): one line, opens on demand. -->
        <SolidColorBrush x:Key="NegativeDim" Color="#2A1D1F" />
        <Style x:Key="NoticeStrip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NegativeDim}" />
            <Setter Property="BorderBrush" Value="#5A3033" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- A small text toggle ("Show all", "Hide") that sits inside a strip. -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="6,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel tabs (two views sharing one column): gold underline on the open one. -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="10,5" Margin="0,0,4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Buttons ================= -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="3" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- World-research accent: global information reads blue, vs the org accent. -->
        <SolidColorBrush x:Key="World" Color="#4C8DE0" />


        <!-- ================= Desktop-shell window chrome ================= -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="0,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Crimson}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Scrollbars (dark, thin, rounded thumb) ================= -->
        <ControlTemplate x:Key="ScrollThumb" TargetType="Thumb">
            <Border x:Name="b" Background="{StaticResource BorderStrong}" CornerRadius="4" Margin="2" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{StaticResource TextMuted}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{StaticResource TextSecondary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VScrollBar" TargetType="ScrollBar">
            <Border Background="{StaticResource Bg}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HScrollBar" TargetType="ScrollBar">
            <Border Background="{StaticResource Bg}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Template" Value="{StaticResource VScrollBar}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HScrollBar}" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= DataGrid family ================= -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Header}" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Inputs ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tb" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Gold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Date picker ================= -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        </Style>

        <!-- ================= Lists ================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GridLine}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             WELCOMING BUILDING BLOCKS  (pilot: Home + Roster use only these)
             =====================================================================
             The direction: lead with people, pictures and story; keep the numbers
             one glance or one click behind. Every app is a window on the promoter's
             desktop, so layouts reflow with the WINDOW width, never the screen.

             TOKENS
               Type ......... Text.Kicker (11 caps label) · Text.Caption (12) ·
                              Text.Secondary (12.5) · Text.Body (13.5) · Text.Heading (15) ·
                              Text.Title (19) · Text.Display (30, the one big name on a screen) ·
                              Text.Quote (15, a person talking)
                              Never put text in TextMuted: use TextSecondary (6:1) or TextSoft (7.5:1).
               Space ........ Space.Screen (screen margin) · Space.Panel (panel padding) ·
                              Space.Stack (between stacked items) · Radius.Panel · Radius.Pill
               Tone ......... Tone{Good,Warn,Bad,Info} + Tone{..}Dim backgrounds. CardTone enum
                              (ViewModels/Cards.cs) picks them in the templates below.

             SURFACES
               Panel ........ (Border) the standard section of a screen: soft fill, rounded.
               HeroPanel .... (ContentControl) the top band of a screen, washed in the org accent.
               Chip ......... (Border) + Chip.Text: a small rounded tag ("City promotion").

             BUTTONS
               Button.Primary  the ONE obvious thing to do in a panel (org accent fill).
               Button.Soft     an action inside a list item (accent text on a dim accent fill).
               Button.Ghost    secondary action, outlined.
               Button.Link     inline text link ("All news ▸").

             CONTROLS (Wpf/Controls)
               controls:SectionHeader  Title / Hint / ActionText + ActionCommand.
               controls:EmptyState     Glyph / Title / Message / ActionText + ActionCommand / Footnote.
               controls:RatingBadge    Value = a SCOUTED rating -> bar + number + word.
               controls:CardWall       virtualised wrapping wall of cards; ItemsSource may mix
                                       CardGroup headings in. CardTemplate + CardWidth.
               controls:MasonryPanel   1-3 adaptive columns of panels by window width;
                                       MasonryPanel.FullWidth="True" spans a band.
               Segmented + SegmentedOption (RadioButtons) — plain-choice toggles, e.g. Cards | Table.

             TEMPLATES (bind to the models in ViewModels/Cards.cs)
               FighterCardTemplate     FighterCardModel as a contact card (walls, ~300 px).
               FighterRowCardTemplate  FighterCardModel as a compact row with its "why" line.
               ActionRowTemplate       ActionItemModel: a "needs you" item with up to two buttons.
               HeadlineCardTemplate    HeadlineCardModel: a story with a picture and a quote.
               JourneyStripTemplate    a list of JourneyStop as a connected strip (tier climb).
             Clicking a fighter card opens the profile through the window's OpenFighterCommand.
             ===================================================================== -->

        <!-- Tokens: colour -->
        <SolidColorBrush x:Key="TextSoft" Color="#B8C1CB" />
        <SolidColorBrush x:Key="Steel" Color="#7FA6C9" />
        <SolidColorBrush x:Key="PanelFill" Color="#1B2028" />
        <SolidColorBrush x:Key="PanelEdge" Color="#29303A" />
        <SolidColorBrush x:Key="CardFill" Color="#222831" />
        <SolidColorBrush x:Key="CardHover" Color="#2A313B" />
        <SolidColorBrush x:Key="ToneGood" Color="#57C97E" />
        <SolidColorBrush x:Key="ToneWarn" Color="#E8B23A" />
        <SolidColorBrush x:Key="ToneBad" Color="#EE7A72" />
        <SolidColorBrush x:Key="ToneInfo" Color="#7FB0EC" />
        <SolidColorBrush x:Key="ToneGoodDim" Color="#1C3125" />
        <SolidColorBrush x:Key="ToneWarnDim" Color="#38301B" />
        <SolidColorBrush x:Key="ToneBadDim" Color="#3A2225" />
        <SolidColorBrush x:Key="ToneInfoDim" Color="#1C2A3D" />

        <!-- Tokens: space and shape -->
        <Thickness x:Key="Space.Screen">16</Thickness>
        <Thickness x:Key="Space.Panel">18,16,18,18</Thickness>
        <Thickness x:Key="Space.Stack">0,0,0,10</Thickness>
        <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
        <CornerRadius x:Key="Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Radius.Pill">11</CornerRadius>
        <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>

        <!-- Tokens: type -->
        <Style x:Key="Text.Kicker" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Quote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <!-- Surfaces -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="Padding" Value="{StaticResource Space.Panel}" />
        </Style>
        <!-- HeroPanel (ContentControl): the top band of a screen, washed from the left in the org accent. -->
        <Style x:Key="HeroPanel" TargetType="ContentControl">
            <Setter Property="Padding" Value="24,20,24,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource PanelFill}" BorderBrush="{DynamicResource OrgAccentDim}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True">
                            <Grid>
                                <Border Background="{DynamicResource OrgAccentDim}" CornerRadius="{StaticResource Radius.Panel}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                            <GradientStop Color="#C0000000" Offset="0" />
                                            <GradientStop Color="#30000000" Offset="0.45" />
                                            <GradientStop Color="#00000000" Offset="0.8" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="Chip.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- Buttons -->
        <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource OrgAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
            <Setter Property="Foreground" Value="#15181D" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                <Setter TargetName="b" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="Button.Soft" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Button.Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter x:Name="c" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A borderless clickable surface (a whole card that opens something). -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (RadioButtons in a Segmented border): "Cards | Table", "Everyone | Ready | Injured". -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="SegmentedOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:SectionHeader -->
        <Style TargetType="controls:SectionHeader">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SectionHeader">
                        <DockPanel>
                            <Button x:Name="act" DockPanel.Dock="Right" Style="{StaticResource Button.Link}" VerticalAlignment="Top"
                                    Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionParameter}" Margin="8,0,-4,0" />
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="17" />
                                <TextBlock x:Name="hint" Text="{TemplateBinding Hint}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Hint" Value=""><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:EmptyState -->
        <Style TargetType="controls:EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:EmptyState">
                        <StackPanel MaxWidth="460" Margin="24">
                            <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource OrgAccentDim}" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Glyph}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="22" TextAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSoft}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20" />
                            <Button x:Name="act" Style="{StaticResource Button.Primary}" Content="{TemplateBinding ActionText}"
                                    Command="{TemplateBinding ActionCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="foot" Text="{TemplateBinding Footnote}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Footnote" Value=""><Setter TargetName="foot" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:RatingBadge -->
        <Style TargetType="controls:RatingBadge">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:RatingBadge">
                        <StackPanel Orientation="Horizontal" ToolTip="Your scout's read of this fighter (not the whole truth)">
                            <Grid Width="56" Height="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Fraction, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ColumnDefinition Width="{Binding Rest, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="{StaticResource Track}" CornerRadius="3" />
                                <Border Background="{TemplateBinding Tone}" CornerRadius="3" />
                            </Grid>
                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" FontSize="13"
                                       Foreground="{TemplateBinding Tone}" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Word}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:CardWall (virtualised lines of cards) -->
        <Style TargetType="controls:CardWall">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:CardWall">
                        <ItemsControl ItemsSource="{Binding Lines, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.CacheLength="2,2" VirtualizingPanel.CacheLengthUnit="Item">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- a section heading line -->
                                        <DockPanel x:Name="head" Margin="2,14,0,8" Visibility="Collapsed">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Header.Title}" Style="{StaticResource Text.Title}" FontSize="17" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Header.Detail}" Style="{StaticResource Text.Caption}" Margin="12,0,0,2" VerticalAlignment="Bottom" />
                                        </DockPanel>
                                        <!-- a line of cards -->
                                        <ItemsControl x:Name="line" ItemsSource="{Binding Cards}" Focusable="False"
                                                      ItemTemplate="{Binding CardTemplate, RelativeSource={RelativeSource AncestorType=controls:CardWall}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=controls:CardWall}}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,12,12" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="head" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status line colour by CardTone (used by the fighter + action templates). -->
        <Style x:Key="Text.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- FighterCardTemplate: a contact card for walls of fighters -->
        <DataTemplate x:Key="FighterCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="146"
                    Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- face: rounded left edge of the card -->
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="champ" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#D9161A1F" CornerRadius="0,0,0,8" Padding="4,2">
                        <TextBlock Text="👑 CHAMP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9,10,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock x:Name="nick" Text="{Binding Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="deal" Text="{Binding ContractText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Text.Status}" Margin="0,1,0,0" />
                    </StackPanel>
                    <!-- the fighter last picked/opened: survives refreshes by id -->
                    <Border x:Name="sel" Grid.ColumnSpan="2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource OrgAccent}"
                            IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChampion}" Value="True"><Setter TargetName="champ" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Nickname}" Value=""><Setter TargetName="nick" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Warn"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneWarn}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Bad"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Good"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Bad"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Info"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- FighterRowCardTemplate: compact person row with the reason they matter now -->
        <DataTemplate x:Key="FighterRowCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                    Command="{Binding DataContext.OpenFighterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <DockPanel Margin="0,0,10,0">
                    <Border DockPanel.Dock="Left" Width="64" Height="72" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <controls:RatingBadge DockPanel.Dock="Right" Value="{Binding Scout}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel VerticalAlignment="Center" Margin="12,6,0,6">
                        <TextBlock x:Name="why" Text="{Binding Why}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWhy}" Value="False"><Setter TargetName="why" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ActionRowTemplate: one "needs you" item -->
        <DataTemplate x:Key="ActionRowTemplate">
            <Border x:Name="row" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Margin="0,0,0,8"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1">
                <DockPanel>
                    <Border x:Name="stripe" DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{StaticResource BorderStrong}" />
                    <Grid Margin="12,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="pic" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontSize="20" Width="40" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <TextBlock x:Name="due" DockPanel.Dock="Right" Text="{Binding Due}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="14" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,9,0,0">
                            <Button x:Name="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" CommandParameter="{Binding PrimaryParameter}"
                                    Style="{StaticResource Button.Soft}" Padding="14,5" FontSize="12.5" />
                            <Button x:Name="secondary" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" CommandParameter="{Binding SecondaryParameter}"
                                    Style="{StaticResource Button.Ghost}" Padding="12,4" FontSize="12.5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                    <Setter TargetName="pic" Property="Visibility" Value="Visible" />
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSecondary}" Value="False"><Setter TargetName="secondary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding PrimaryText}" Value=""><Setter TargetName="primary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="stripe" Property="Background" Value="{StaticResource Crimson}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneWarn}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneInfo}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneGood}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- HeadlineCardTemplate: a story with a face -->
        <DataTemplate x:Key="HeadlineCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" Command="{Binding OpenCommand}" CommandParameter="{Binding OpenParameter}">
                <DockPanel Margin="0,0,12,0">
                    <Border DockPanel.Dock="Left" Width="72" MinHeight="80" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,9,0,10" VerticalAlignment="Center">
                        <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock x:Name="quote" Text="{Binding Quote}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,4,0,0" MaxHeight="36" TextTrimming="WordEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True"><Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- JourneyStripTemplate: ItemsControl.ItemTemplate for JourneyStop items in a one-row UniformGrid -->
        <DataTemplate x:Key="JourneyStripTemplate">
            <StackPanel>
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="left" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Border x:Name="right" Grid.Column="2" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Ellipse x:Name="dot" Grid.Column="1" Width="14" Height="14" Fill="{StaticResource SurfaceSunken}" Stroke="{StaticResource BorderStrong}" StrokeThickness="2" />
                </Grid>
                <TextBlock x:Name="label" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="left" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="right" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="right" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="dot" Property="Width" Value="20" />
                    <Setter TargetName="dot" Property="Height" Value="20" />
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Bg}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="StrokeThickness" Value="5" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="label" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Result strip (the shell's "what just happened" line above the taskbar) ===== -->
        <!-- Rest colour = Surface; the flash is a dim gold that fades back to it when a new result lands. -->
        <Color x:Key="ResultStripRestColor">#1E232B</Color>
        <Color x:Key="ResultStripFlashColor">#6B5520</Color>
        <Style x:Key="ResultStrip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="12,3,6,3" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Text" Value="⚠" />
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
