<Application x:Class="MmaManager.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:MmaManager.Wpf.Mvvm"
             xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ================= Fight-night palette (dark · gold · crimson) ================= -->
        <SolidColorBrush x:Key="Bg" Color="#16191E" />
        <SolidColorBrush x:Key="Surface" Color="#1E232B" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#262C35" />
        <SolidColorBrush x:Key="Header" Color="#12151A" />
        <SolidColorBrush x:Key="Hover" Color="#2C333D" />
        <SolidColorBrush x:Key="Border" Color="#2E353F" />
        <SolidColorBrush x:Key="BorderStrong" Color="#3A424D" />
        <SolidColorBrush x:Key="GridLine" Color="#242A31" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6E9EC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA4AF" />
        <SolidColorBrush x:Key="TextMuted" Color="#6E7680" />
        <SolidColorBrush x:Key="Gold" Color="#E8B23A" />
        <SolidColorBrush x:Key="Crimson" Color="#D64550" />
        <SolidColorBrush x:Key="Positive" Color="#57C97E" />
        <SolidColorBrush x:Key="Negative" Color="#E5736B" />
        <SolidColorBrush x:Key="SurfaceSunken" Color="#181C22" />
        <SolidColorBrush x:Key="Track" Color="#232A33" />
        <SolidColorBrush x:Key="TextFaint" Color="#8A929B" />
        <SolidColorBrush x:Key="Selection" Color="#3A3320" />

        <!-- The player org's signature colour (its poster palette) — swapped at
             runtime by MainViewModel.RefreshAll, so reference via DynamicResource.
             Defaults to the house gold until a career starts. -->
        <SolidColorBrush x:Key="OrgAccent" Color="#E8B23A" />
        <SolidColorBrush x:Key="OrgAccentDim" Color="#46E8B23A" />

        <!-- ================= Converters (shared by every view) ================= -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <mvvm:InverseBoolToVisibility x:Key="InverseBoolToVis" />
        <!-- CardTone -> Tone{Good,Warn,Bad,Info} brush; ConverterParameter=Dim for the background shade. -->
        <mvvm:ToneBrush x:Key="ToneBrush" />

        <!-- ================= Text ================= -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <!-- Small-caps section label ("FREE AGENTS", "YOUR OFFER", …) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- One of your fighters' bond with you, in a line (Lifers.BondOf via AskText.Bond);
             collapses when there is nothing to say. -->
        <Style x:Key="BondLineText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#9FB6C9" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A content card: the standard panel chrome for screen sections. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Small grey caption above an input ("Date", "Host city", …) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- An empty panel says what to do next instead of showing blank controls. -->
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>

        <!-- A folded notice strip (contract warnings, cautions): one line, opens on demand. -->
        <SolidColorBrush x:Key="NegativeDim" Color="#2A1D1F" />
        <Style x:Key="NoticeStrip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NegativeDim}" />
            <Setter Property="BorderBrush" Value="#5A3033" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- A small text toggle ("Show all", "Hide") that sits inside a strip. -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="6,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel tabs (two views sharing one column): gold underline on the open one. -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="10,5" Margin="0,0,4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Buttons ================= -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="3" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- World-research accent: global information reads blue, vs the org accent. -->
        <SolidColorBrush x:Key="World" Color="#4C8DE0" />


        <!-- ================= Desktop-shell window chrome ================= -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="0,6,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Crimson}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Scrollbars (dark, thin, rounded thumb) ================= -->
        <ControlTemplate x:Key="ScrollThumb" TargetType="Thumb">
            <Border x:Name="b" Background="{StaticResource BorderStrong}" CornerRadius="4" Margin="2" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{StaticResource TextMuted}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{StaticResource TextSecondary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VScrollBar" TargetType="ScrollBar">
            <Border Background="{StaticResource Bg}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="HScrollBar" TargetType="ScrollBar">
            <Border Background="{StaticResource Bg}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Template" Value="{StaticResource VScrollBar}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HScrollBar}" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= DataGrid family ================= -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Header}" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Inputs ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tb" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Gold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Date picker ================= -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        </Style>

        <!-- ================= Lists ================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource GridLine}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             WELCOMING BUILDING BLOCKS  (Home, Roster, Fighters, News and Inbox use only these)
             =====================================================================
             The direction: lead with people, pictures and story; keep the numbers
             one glance or one click behind. Every app is a window on the promoter's
             desktop, so layouts reflow with the WINDOW width, never the screen.

             TOKENS
               Type ......... Text.Kicker (11 caps label) · Text.Caption (12) · Text.Note (12, collapses when empty) ·
                              Text.Secondary (12.5) · Text.Body (13.5) · Text.Heading (15) ·
                              Text.Title (19) · Text.Display (30, the one big name on a screen) ·
                              Text.Quote (15, a person talking)
                              Never put text in TextMuted: use TextSecondary (6:1) or TextSoft (7.5:1).
               Space ........ Space.Screen (screen margin) · Space.Panel (panel padding) ·
                              Space.Stack (between stacked items) · Radius.Panel · Radius.Pill
               Tone ......... Tone{Good,Warn,Bad,Info} + Tone{..}Dim backgrounds. CardTone enum
                              (ViewModels/Cards.cs) picks them in the templates below, or bind a
                              CardTone through {StaticResource ToneBrush} (ConverterParameter=Dim).
               Icons ........ Icon.{Envelope, Document, Warning, Trophy, Calendar, Search, People,
                              Money, Bell, Star, Crown, Broadcast, Pen, Check, Newspaper, Building,
                              ChevronLeft, ChevronRight}:
                              line geometry on a 24x24 grid, drawn by controls:Icon. No emoji in
                              these screens (WPF draws them flat and monochrome).

             SURFACES
               Panel ........ (Border) the standard section of a screen: soft fill, rounded.
               HeroPanel .... (ContentControl) the top band of a screen, washed in the org accent.
                              HeroLogo / Text.HeroName / Text.HeroQuote / Text.HeroDetail / HeroGap
                              tighten when the window is short (controls:Adaptive.IsCompact).
               MomentCard ... (Border) The Moment's poster card over MomentScrim, with
                              Text.MomentKicker / Text.Moment (the one huge line) /
                              Text.MomentName / MomentGap; all tighten when compact.
               Chip ......... (Border) + Chip.Text: a small rounded tag ("City promotion").
               Avatar ....... (ContentControl; Content has Picture/HasPicture/Icon) a round face,
                              or a desk's icon on a disc.

             BUTTONS
               Button.Primary  the ONE obvious thing to do in a panel (org accent fill).
               Button.Soft     an action inside a list item (accent text on a dim accent fill).
               Button.Ghost    secondary action, outlined.
               Button.Link     inline text link ("All news ▸").
               Button.Chip     a small pill that follows something to its page (a name, "AFC", an event).
               Button.Icon     a small square ghost button for a row's quiet actions (▲ ▼ ✕).
               TabStrip ...... (ListBox) open documents side by side, one selected (the Card Desk's events).
               ToneTagTemplate a fact pill for any Text + Tone (CardTone) item ("Bad blood · heat 60").

             FILTERS
               SearchBox ..... (TextBox) rounded field with a search icon; Tag = placeholder.
                              Bind with UpdateSourceTrigger=PropertyChanged, Delay=120.
               FilterCombo ... (ComboBox) a picker in a wrapping filter row.
               FilterChip .... (ToggleButton) an on/off pill ("On my shortlist").
               ChipList ...... (ListBox) one-of-many pills on SelectedItem (News kinds, Inbox folders).
               Segmented + SegmentedOption (RadioButtons) — plain-choice toggles, e.g. Cards | Table.

             CONTROLS (Wpf/Controls)
               controls:SectionHeader  Title / Hint / ActionText + ActionCommand.
               controls:EmptyState     Icon (or Glyph) / Title / Message / ActionText + ActionCommand / Footnote.
               controls:RatingBadge    Value = a SCOUTED rating -> bar + number + word.
               controls:Icon           Kind (an Icon.* name) / Brush / StrokeThickness; 20x20 by default.
               controls:CardWall       virtualised wrapping wall of cards; ItemsSource may mix
                                       CardGroup headings and a CardBanner (full-width feature drawn
                                       with BannerTemplate) in. CardTemplate + CardWidth.
               controls:MasonryPanel   1-3 adaptive columns of panels by window width;
                                       MasonryPanel.FullWidth="True" spans a band;
                                       EvenBottoms="True" ends every column on one line.
               controls:Adaptive       CompactBelowHeight on a screen root -> inherited IsCompact.

             TEMPLATES (models in ViewModels/Cards.cs and MailViewModel.cs)
               FighterCardTemplate       FighterCardModel as a contact card (your roster, ~300 px).
               WorldFighterCardTemplate  FighterCardModel for the world: who they fight for + shortlist star.
               FighterRowCardTemplate    FighterCardModel as a compact row with its "why" line.
               ActionRowTemplate         ActionItemModel: a "needs you" item (an Icon) with up to two buttons.
               HeadlineCardTemplate      HeadlineCardModel: a story with a picture and a quote (Home).
               StoryCardTemplate         StoryCardModel: a wire story with follow chips (News).
               LeadStoryTemplate         StoryCardModel as the big lead (a CardWall BannerTemplate).
               LetterRowTemplate         LetterModel in a mail list (+ LetterListItem container style).
               JourneyStripTemplate      a list of JourneyStop as a connected strip (tier climb).
             Clicking a fighter card opens the profile through the window's OpenFighterCommand.
             Card faces decode off the UI thread (Portraits.Thumb with a callback); card models
             raise PropertyChanged when the face lands, so a wall opens before its faces decode.
             Long lists on a dashboard show a few and a "See all" link (Home: Needs you shows 4).
             ===================================================================== -->

        <!-- Tokens: colour -->
        <SolidColorBrush x:Key="TextSoft" Color="#B8C1CB" />
        <SolidColorBrush x:Key="Steel" Color="#7FA6C9" />
        <SolidColorBrush x:Key="PanelFill" Color="#1B2028" />
        <SolidColorBrush x:Key="PanelEdge" Color="#29303A" />
        <SolidColorBrush x:Key="CardFill" Color="#222831" />
        <SolidColorBrush x:Key="CardHover" Color="#2A313B" />
        <SolidColorBrush x:Key="ToneGood" Color="#57C97E" />
        <SolidColorBrush x:Key="ToneWarn" Color="#E8B23A" />
        <SolidColorBrush x:Key="ToneBad" Color="#EE7A72" />
        <SolidColorBrush x:Key="ToneInfo" Color="#7FB0EC" />
        <SolidColorBrush x:Key="ToneGoodDim" Color="#1C3125" />
        <SolidColorBrush x:Key="ToneWarnDim" Color="#38301B" />
        <SolidColorBrush x:Key="ToneBadDim" Color="#3A2225" />
        <SolidColorBrush x:Key="ToneInfoDim" Color="#1C2A3D" />

        <!-- Tokens: line icons (24x24 grid, stroked by controls:Icon — never filled).
             Add a shape here, then use it anywhere as <controls:Icon Kind="Name" />. -->
        <Geometry x:Key="Icon.Envelope">M3,6 H21 V18 H3 Z M3,6.5 L12,13 L21,6.5</Geometry>
        <Geometry x:Key="Icon.Document">M6,3 H14 L18,7 V21 H6 Z M14,3 V7 H18 M9,12 H15 M9,16 H15</Geometry>
        <Geometry x:Key="Icon.Warning">M12,3.5 L21.5,20 H2.5 Z M12,9.5 V14 M12,17 V17.2</Geometry>
        <Geometry x:Key="Icon.Trophy">M7.5,4 H16.5 V9 A4.5,4.5 0 0 1 7.5,9 Z M7.5,6 H4.5 A3,3 0 0 0 7.8,10.5 M16.5,6 H19.5 A3,3 0 0 1 16.2,10.5 M12,13.5 V17.5 M8.5,20.5 H15.5 M9.5,17.5 H14.5</Geometry>
        <Geometry x:Key="Icon.Calendar">M4,6 H20 V20 H4 Z M4,10 H20 M8.5,3.5 V7.5 M15.5,3.5 V7.5 M8,14 H10 M14,14 H16 M8,17 H10</Geometry>
        <Geometry x:Key="Icon.Search">M4,10.5 A6.5,6.5 0 1 0 17,10.5 A6.5,6.5 0 1 0 4,10.5 M15.3,15.3 L20.5,20.5</Geometry>
        <Geometry x:Key="Icon.People">M5.5,8 A3.5,3.5 0 1 0 12.5,8 A3.5,3.5 0 1 0 5.5,8 M2.5,20 A6.5,6.5 0 0 1 15.5,20 M15.5,4.8 A3.2,3.2 0 0 1 15.5,11.2 M17.5,14 A5.5,5.5 0 0 1 21.5,20</Geometry>
        <Geometry x:Key="Icon.Money">M3,6.5 H21 V17.5 H3 Z M9.5,12 A2.5,2.5 0 1 0 14.5,12 A2.5,2.5 0 1 0 9.5,12 M6.5,9.5 V14.5 M17.5,9.5 V14.5</Geometry>
        <Geometry x:Key="Icon.Bell">M6,16.5 V11 A6,6 0 0 1 18,11 V16.5 L20,18.5 H4 Z M10,21 A2,2 0 0 0 14,21</Geometry>
        <Geometry x:Key="Icon.Star">M12,3.5 L14.6,8.9 L20.5,9.7 L16.2,13.8 L17.3,19.7 L12,16.9 L6.7,19.7 L7.8,13.8 L3.5,9.7 L9.4,8.9 Z</Geometry>
        <Geometry x:Key="Icon.Crown">M3.5,8 L8,12 L12,5 L16,12 L20.5,8 L18.5,18.5 H5.5 Z</Geometry>
        <Geometry x:Key="Icon.Broadcast">M10.5,12 A1.5,1.5 0 1 0 13.5,12 A1.5,1.5 0 1 0 10.5,12 M8.5,8.5 A5,5 0 0 0 8.5,15.5 M15.5,8.5 A5,5 0 0 1 15.5,15.5 M5.6,5.6 A9,9 0 0 0 5.6,18.4 M18.4,5.6 A9,9 0 0 1 18.4,18.4</Geometry>
        <Geometry x:Key="Icon.Pen">M4,20 L5,16 L16,5 L19,8 L8,19 Z M14,7 L17,10 M4,20 H20</Geometry>
        <Geometry x:Key="Icon.Check">M5,12.5 L10,17.5 L19.5,7</Geometry>
        <Geometry x:Key="Icon.Newspaper">M4,5 H17 V19 H6 A2,2 0 0 1 4,17 Z M17,9 H20 V17 A2,2 0 0 1 18,19 H17 M7,8.5 H14 M7,12 H14 M7,15 H11</Geometry>
        <Geometry x:Key="Icon.Building">M4,20.5 H20 M5.5,20.5 V8 L12,4 L18.5,8 V20.5 M9,11 H10 M14,11 H15 M9,14.5 H10 M14,14.5 H15 M10.5,20.5 V17 H13.5 V20.5</Geometry>
        <Geometry x:Key="Icon.ChevronLeft">M15,5 L8,12 L15,19</Geometry>
        <Geometry x:Key="Icon.ChevronRight">M9,5 L16,12 L9,19</Geometry>

        <!-- Tokens: space and shape -->
        <Thickness x:Key="Space.Screen">16</Thickness>
        <Thickness x:Key="Space.Panel">18,16,18,18</Thickness>
        <Thickness x:Key="Space.Stack">0,0,0,10</Thickness>
        <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
        <CornerRadius x:Key="Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Radius.Pill">11</CornerRadius>
        <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>

        <!-- Tokens: type -->
        <Style x:Key="Text.Kicker" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Text.Note: a wrapping caption that collapses when it has nothing to say (a hint under a button). -->
        <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Quote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <!-- Surfaces -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="Padding" Value="{StaticResource Space.Panel}" />
        </Style>
        <!-- HeroPanel (ContentControl): the top band of a screen, washed from the left in the org accent. -->
        <Style x:Key="HeroPanel" TargetType="ContentControl">
            <Setter Property="Padding" Value="24,20,24,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource PanelFill}" BorderBrush="{DynamicResource OrgAccentDim}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True">
                            <Grid>
                                <Border Background="{DynamicResource OrgAccentDim}" CornerRadius="{StaticResource Radius.Panel}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                            <GradientStop Color="#C0000000" Offset="0" />
                                            <GradientStop Color="#30000000" Offset="0.45" />
                                            <GradientStop Color="#00000000" Offset="0.8" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Padding" Value="20,12,20,12" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Hero parts that tighten in a short window (controls:Adaptive.IsCompact on the screen root). -->
        <Style x:Key="HeroLogo" TargetType="Border">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Width" Value="56" />
                    <Setter Property="Height" Value="56" />
                    <Setter Property="Margin" Value="0,0,14,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroName" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroQuote" TargetType="TextBlock" BasedOn="{StaticResource Text.Quote}">
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="LineHeight" Value="19" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroDetail" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroGap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Margin" Value="0,6,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- THE MOMENT: one poster-like card over the dimmed desktop (Views/MomentView.xaml). -->
        <SolidColorBrush x:Key="MomentScrim" Color="#E60A0C10" />
        <Style x:Key="MomentCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D222A" Offset="0" />
                        <GradientStop Color="#13161B" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Text.MomentKicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Kicker}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="13" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The one huge line ("AND NEW."): announcer words, never a stat. -->
        <Style x:Key="Text.Moment" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
            <Setter Property="FontSize" Value="92" />
            <Setter Property="LineHeight" Value="94" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="-4,2,0,4" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="60" />
                    <Setter Property="LineHeight" Value="62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.MomentName" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="FontSize" Value="26" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="20" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A gap between moment sections that closes up on a short screen. -->
        <Style x:Key="MomentGap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,22,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Margin" Value="0,10,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="Chip.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- Buttons -->
        <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource OrgAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
            <Setter Property="Foreground" Value="#15181D" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                <Setter TargetName="b" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="Button.Soft" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Button.Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter x:Name="c" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A borderless clickable surface (a whole card that opens something). -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (RadioButtons in a Segmented border): "Cards | Table", "Everyone | Ready | Injured". -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="SegmentedOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SearchBox (TextBox): rounded field with a search icon; Tag = the placeholder text. -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="17">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon Kind="Search" Width="16" Height="16" Brush="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FilterChip (ToggleButton or RadioButton): a pill filter that lights up in the org accent when on ("On my shortlist", "Needs a decision · 3"). -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}" Padding="12,5" MinHeight="30">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChip.Radio" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}" />

        <!-- FilterChip.Compact (ToggleButton): the same pill, smaller, for a narrow rail with many filters ("Needs a fight · 12"). -->
        <Style x:Key="FilterChip.Compact" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}" Padding="8,2,8,3" MinHeight="22">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ChipList (ListBox): a wrapping row of one-choice pills bound to SelectedItem
             (News kinds, Inbox folders). Items draw with their ToString or an ItemTemplate. -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Pill}" Padding="12,5" Margin="0,0,6,6" MinHeight="30">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field: a labelled picker in a filter row ("Division [Every division ▾]"). -->
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,14,6" />
            <Setter Property="MinWidth" Value="170" />
        </Style>

        <!-- controls:SectionHeader -->
        <Style TargetType="controls:SectionHeader">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SectionHeader">
                        <DockPanel>
                            <Button x:Name="act" DockPanel.Dock="Right" Style="{StaticResource Button.Link}" VerticalAlignment="Top"
                                    Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionParameter}" Margin="8,0,-4,0" />
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="17" />
                                <TextBlock x:Name="hint" Text="{TemplateBinding Hint}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Hint" Value=""><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:EmptyState -->
        <Style TargetType="controls:EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:EmptyState">
                        <StackPanel MaxWidth="460" Margin="24">
                            <Border x:Name="disc" Width="80" Height="80" CornerRadius="40" Background="{DynamicResource OrgAccentDim}" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="glyph" Text="{TemplateBinding Glyph}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <controls:Icon x:Name="icon" Kind="{TemplateBinding Icon}" Width="38" Height="38" StrokeThickness="1.5"
                                                   Brush="{DynamicResource OrgAccent}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="22" TextAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSoft}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20" />
                            <Button x:Name="act" Style="{StaticResource Button.Primary}" Content="{TemplateBinding ActionText}"
                                    Command="{TemplateBinding ActionCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="foot" Text="{TemplateBinding Footnote}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Footnote" Value=""><Setter TargetName="foot" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Icon" Value=""><Setter TargetName="icon" Property="Visibility" Value="Collapsed" /></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Glyph" Value="" /><Condition Property="Icon" Value="" /></MultiTrigger.Conditions>
                                <Setter TargetName="disc" Property="Visibility" Value="Collapsed" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:RatingBadge -->
        <Style TargetType="controls:RatingBadge">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:RatingBadge">
                        <StackPanel Orientation="Horizontal" ToolTip="Your scout's read of this fighter (not the whole truth)">
                            <Grid Width="56" Height="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Fraction, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ColumnDefinition Width="{Binding Rest, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="{StaticResource Track}" CornerRadius="3" />
                                <Border Background="{TemplateBinding Tone}" CornerRadius="3" />
                            </Grid>
                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" FontSize="13"
                                       Foreground="{TemplateBinding Tone}" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Word}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:CardWall (virtualised lines of cards) -->
        <Style TargetType="controls:CardWall">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:CardWall">
                        <ItemsControl ItemsSource="{Binding Lines, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Item">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- a section heading (drawn on top of its first line of cards) -->
                                        <DockPanel x:Name="head" Margin="2,14,0,8" Visibility="Collapsed">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Header.Title}" Style="{StaticResource Text.Title}" FontSize="17" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Header.Detail}" Style="{StaticResource Text.Caption}" Margin="12,0,0,2" VerticalAlignment="Bottom" />
                                        </DockPanel>
                                        <!-- a full-width feature (CardBanner) -->
                                        <ContentControl x:Name="banner" Focusable="False" Content="{Binding Banner.Content}" Margin="0,0,12,14" Visibility="Collapsed" HorizontalAlignment="Left"
                                                          Width="{Binding BannerWidth}" ContentTemplate="{Binding BannerTemplate}" />
                                        <!-- a line of cards -->
                                        <ItemsControl x:Name="line" ItemsSource="{Binding Cards}" Focusable="False" HorizontalAlignment="Left"
                                                      Width="{Binding Width}" ItemTemplate="{Binding CardTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="{Binding Columns}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,12,12" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="head" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasCards}" Value="False">
                                            <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBanner}" Value="True">
                                            <Setter TargetName="banner" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status line colour by CardTone (used by the fighter + action templates). -->
        <Style x:Key="Text.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- FighterCardTemplate: a contact card for walls of fighters -->
        <DataTemplate x:Key="FighterCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="146"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- face: rounded left edge of the card -->
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="champ" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#D9161A1F" CornerRadius="0,0,0,8" Padding="4,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:Icon Kind="Crown" Width="13" Height="13" Brush="{StaticResource Gold}" StrokeThickness="2" Margin="0,0,4,0" />
                            <TextBlock Text="CHAMP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9,10,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock x:Name="nick" Text="{Binding Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="deal" Text="{Binding ContractText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Text.Status}" Margin="0,1,0,0" />
                    </StackPanel>
                    <!-- the fighter last picked/opened: survives refreshes by id -->
                    <Border x:Name="sel" Grid.ColumnSpan="2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource OrgAccent}"
                            IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChampion}" Value="True"><Setter TargetName="champ" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Nickname}" Value=""><Setter TargetName="nick" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Warn"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneWarn}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Bad"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Good"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Bad"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Info"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- WorldFighterCardTemplate: a fighter from anywhere in the world (Fighters app):
             who they fight for instead of the deal, and a shortlist star. -->
        <DataTemplate x:Key="WorldFighterCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="146"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="champ" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#D9161A1F" CornerRadius="0,0,0,8" Padding="4,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:Icon Kind="Crown" Width="13" Height="13" Brush="{StaticResource Gold}" StrokeThickness="2" Margin="0,0,4,0" />
                            <TextBlock Text="CHAMP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9,30,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock x:Name="nick" Text="{Binding Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        <DockPanel Margin="0,4,0,0">
                            <Image x:Name="logo" DockPanel.Dock="Left" Source="{Binding AffiliationLogo}" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock x:Name="aff" Text="{Binding Affiliation}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Text.Status}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- shortlist star: pins the fighter to the Notes shortlist -->
                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Style="{StaticResource Button.Link}" Padding="0"
                            Command="{x:Static mvvm:AppCommands.ToggleShortlist}"
                            CommandParameter="{Binding Id}" ToolTip="Pin to your shortlist (Notes app)">
                        <controls:Icon x:Name="star" Kind="Star" Width="18" Height="18" Brush="{StaticResource TextSecondary}" />
                    </Button>
                    <Border x:Name="sel" Grid.ColumnSpan="2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource OrgAccent}"
                            IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChampion}" Value="True"><Setter TargetName="champ" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Nickname}" Value=""><Setter TargetName="nick" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasAffiliationLogo}" Value="False">
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="aff" Property="Foreground" Value="{StaticResource ToneInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMine}" Value="True"><Setter TargetName="aff" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsShortlisted}" Value="True"><Setter TargetName="star" Property="Brush" Value="{StaticResource Gold}" /><Setter TargetName="star" Property="StrokeThickness" Value="2.4" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Good"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Bad"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Info"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- FighterRowCardTemplate: compact person row with the reason they matter now -->
        <DataTemplate x:Key="FighterRowCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <DockPanel Margin="0,0,10,0">
                    <Border DockPanel.Dock="Left" Width="64" Height="72" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <controls:RatingBadge DockPanel.Dock="Right" Value="{Binding Scout}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel VerticalAlignment="Center" Margin="12,6,0,6">
                        <TextBlock x:Name="why" Text="{Binding Why}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWhy}" Value="False"><Setter TargetName="why" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ActionRowTemplate: one "needs you" item -->
        <DataTemplate x:Key="ActionRowTemplate">
            <Border x:Name="row" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Margin="0,0,0,8"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1">
                <DockPanel>
                    <Border x:Name="stripe" DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{StaticResource BorderStrong}" />
                    <Grid Margin="12,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="pic" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="glyph" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Track}" Margin="0,0,12,0" VerticalAlignment="Top">
                            <controls:Icon x:Name="icon" Kind="{Binding Icon}" Width="20" Height="20" Brush="{StaticResource TextSoft}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <TextBlock x:Name="due" DockPanel.Dock="Right" Text="{Binding Due}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="14" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,9,0,0">
                            <Button x:Name="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" CommandParameter="{Binding PrimaryParameter}"
                                    Style="{StaticResource Button.Soft}" Padding="14,5" FontSize="12.5" />
                            <Button x:Name="secondary" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" CommandParameter="{Binding SecondaryParameter}"
                                    Style="{StaticResource Button.Ghost}" Padding="12,4" FontSize="12.5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                    <Setter TargetName="pic" Property="Visibility" Value="Visible" />
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSecondary}" Value="False"><Setter TargetName="secondary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding PrimaryText}" Value=""><Setter TargetName="primary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="stripe" Property="Background" Value="{StaticResource Crimson}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneBad}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneBadDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneWarn}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneWarn}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneWarn}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneWarnDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneInfo}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneInfo}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneInfoDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneGood}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneGood}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneGoodDim}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- HeadlineCardTemplate: a story with a face -->
        <DataTemplate x:Key="HeadlineCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" Command="{Binding OpenCommand}" CommandParameter="{Binding OpenParameter}">
                <DockPanel Margin="0,0,12,0">
                    <Border DockPanel.Dock="Left" Width="72" MinHeight="80" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,9,0,10" VerticalAlignment="Center">
                        <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock x:Name="quote" Text="{Binding Quote}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,4,0,0" MaxHeight="36" TextTrimming="WordEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True"><Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Button.Chip: a small rounded link that follows a story or a letter to someone ("Kenji Morita", "AFC", "AFC 301"). -->
        <Style x:Key="Button.Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Track}" CornerRadius="{StaticResource Radius.Pill}" Padding="9,2,10,3" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button.Icon: a small square ghost button for a row's quiet actions (move up, move down, remove). -->
        <Style x:Key="Button.Icon" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToneTagTemplate: a small fact pill for anything with Text + Tone (CardTone): "Bad blood · heat 60", "Last fight on the deal". -->
        <DataTemplate x:Key="ToneTagTemplate">
            <Border x:Name="b" Background="{StaticResource Track}" CornerRadius="{StaticResource Radius.Pill}" Padding="8,2,8,3" Margin="0,0,6,6">
                <TextBlock x:Name="t" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneGoodDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneWarnDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneBadDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneInfoDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The two corners: frame and name colours for red and blue, wherever a pairing is drawn. -->
        <SolidColorBrush x:Key="CornerRed" Color="#A8453C" />
        <SolidColorBrush x:Key="CornerBlue" Color="#3C639E" />
        <SolidColorBrush x:Key="CornerRedText" Color="#E88A80" />
        <SolidColorBrush x:Key="CornerBlueText" Color="#82AEE8" />

        <!-- FormChipTemplate: one past result as a square chip ("W" / "L" / "D" / "NC") with Text + Tone + Tip (method, opponent, card). -->
        <DataTemplate x:Key="FormChipTemplate">
            <Border Width="22" Height="20" CornerRadius="4" Margin="0,0,3,0" ToolTip="{Binding Tip}"
                    Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Border>
        </DataTemplate>

        <!-- SheetLineTemplate: a labelled line (Label + Text + Tone): a small caps label, then the words, wrapping. -->
        <DataTemplate x:Key="SheetLineTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SheetLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="l" Text="{Binding Label}" Style="{StaticResource SectionLabel}" Margin="0,2,10,0" MaxWidth="110" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLabel}" Value="False"><Setter TargetName="l" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- CardList (ListBox): a virtualized column of card rows with keyboard focus (arrows move, the
             selected row carries the accent edge). Give it an ItemTemplate; Enter is the view's to handle. -->
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="edge" BorderThickness="1" BorderBrush="Transparent" CornerRadius="{StaticResource Radius.Card}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabStrip (ListBox): documents open side by side, one selected (the Card Desk's events).
             Give it an ItemTemplate; the selected tab carries an accent underline. -->
        <Style x:Key="TabStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}" Padding="12,6,14,7" Margin="0,0,6,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- StoryCardTemplate: StoryCardModel as a fixed-height wall card (News). Click = the person
             (else the event, else the promotion); the chips follow the story anywhere it leads. -->
        <DataTemplate x:Key="StoryCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="156" Command="{Binding OpenCommand}" CommandParameter="{Binding OpenParameter}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="96" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Grid>
                            <Image x:Name="face" Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image x:Name="logo" Source="{Binding Face.Image}" Margin="18" Visibility="Collapsed" VerticalAlignment="Center" />
                            <controls:Icon x:Name="wire" Kind="Newspaper" Width="34" Height="34" Brush="{StaticResource TextSecondary}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="12,0,10,10" Height="22" ClipToBounds="True">
                        <Button x:Name="who" Style="{StaticResource Button.Chip}" ToolTip="Open the profile"
                                Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding FighterId}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="People" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding FighterName}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="org" Style="{StaticResource Button.Chip}" Content="{Binding PromotionLabel}" ToolTip="Open the promotion's page"
                                Command="{x:Static mvvm:AppCommands.OpenOrg}" CommandParameter="{Binding PromotionId}" />
                        <Button x:Name="ev" Style="{StaticResource Button.Chip}" ToolTip="Open the event page"
                                Command="{x:Static mvvm:AppCommands.OpenEvent}" CommandParameter="{Binding EventId}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="Calendar" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding EventName}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Margin="12,10,12,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon x:Name="kind" Kind="{Binding Icon}" Width="13" Height="13" Brush="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,4,0,0" MaxHeight="40" TextTrimming="WordEllipsis" />
                        <TextBlock x:Name="quote" Text="{Binding Quote}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,3,0,0" MaxHeight="36" TextTrimming="WordEllipsis" />
                        <TextBlock x:Name="body" Text="{Binding Body}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" MaxHeight="36" TextTrimming="WordEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PictureIsLogo}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNoPicture}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="wire" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasQuote}" Value="False">
                    <Setter TargetName="quote" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="body" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFighter}" Value="False"><Setter TargetName="who" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasPromotion}" Value="False"><Setter TargetName="org" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasEvent}" Value="False"><Setter TargetName="ev" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True">
                    <Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="kind" Property="Brush" Value="{DynamicResource OrgAccent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LeadStoryTemplate: the same StoryCardModel as the big feature at the top of a wall (CardWall.BannerTemplate). -->
        <DataTemplate x:Key="LeadStoryTemplate">
            <Border Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="200" MinHeight="200" CornerRadius="10,0,0,10" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Grid>
                            <Image x:Name="face" Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image x:Name="logo" Source="{Binding Face.Image}" Margin="40" Visibility="Collapsed" />
                            <controls:Icon x:Name="wire" Kind="Newspaper" Width="64" Height="64" StrokeThickness="1.3" Brush="{StaticResource TextSecondary}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,18,24,18" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Crimson}" Padding="8,1" Margin="0,0,10,0">
                                <TextBlock Text="LEAD STORY" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Display}" FontSize="26" Margin="0,8,0,0" />
                        <TextBlock x:Name="body" Text="{Binding Body}" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSoft}" Margin="0,8,0,0" LineHeight="20" />
                        <DockPanel x:Name="quote" Margin="0,10,0,0">
                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="{DynamicResource OrgAccent}" Margin="0,2,14,2" />
                            <TextBlock Text="{Binding Quote}" Style="{StaticResource Text.Quote}" />
                        </DockPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="who" Style="{StaticResource Button.Soft}" Margin="0,0,8,6" FontSize="12.5" Padding="12,5"
                                    Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding FighterId}">
                                <TextBlock><Run Text="{Binding FighterName, Mode=OneWay}" /><Run Text="'s profile ▸" /></TextBlock>
                            </Button>
                            <Button x:Name="ev" Style="{StaticResource Button.Ghost}" Margin="0,0,8,6" FontSize="12.5" Padding="12,4"
                                    Command="{x:Static mvvm:AppCommands.OpenEvent}" CommandParameter="{Binding EventId}">
                                <TextBlock><Run Text="{Binding EventName, Mode=OneWay}" /><Run Text=" ▸" /></TextBlock>
                            </Button>
                            <Button x:Name="org" Style="{StaticResource Button.Ghost}" Margin="0,0,8,6" FontSize="12.5" Padding="12,4"
                                    Command="{x:Static mvvm:AppCommands.OpenOrg}" CommandParameter="{Binding PromotionId}">
                                <TextBlock><Run Text="{Binding PromotionLabel, Mode=OneWay}" /><Run Text=" page ▸" /></TextBlock>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PictureIsLogo}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNoPicture}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="wire" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasBody}" Value="False"><Setter TargetName="body" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasFighter}" Value="False"><Setter TargetName="who" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasPromotion}" Value="False"><Setter TargetName="org" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasEvent}" Value="False"><Setter TargetName="ev" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True"><Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Avatar (ContentControl, Content = anything with Picture/HasPicture/Icon): a round face, or a desk's line icon on a disc. Size with Width/Height. -->
        <Style x:Key="Avatar" TargetType="ContentControl">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse Fill="{StaticResource Track}" />
                            <controls:Icon x:Name="icon" Kind="{Binding Content.Icon, RelativeSource={RelativeSource TemplatedParent}}" Brush="{StaticResource TextSoft}"
                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:Scale.Half}}"
                                           Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:Scale.Half}}" />
                            <Ellipse x:Name="face" Visibility="Collapsed">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Content.Picture, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content.HasPicture, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="face" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LetterRowTemplate: LetterModel in a mail list — sender's face or desk, subject, the opening line, and a "needs you" tag. -->
        <DataTemplate x:Key="LetterRowTemplate">
            <Grid Margin="10,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top">
                    <ContentControl Style="{StaticResource Avatar}" Content="{Binding}" Margin="6,0,0,0" />
                    <Ellipse x:Name="dot" Width="9" Height="9" Fill="{DynamicResource OrgAccent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                        <TextBlock x:Name="from" Text="{Binding Sender}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" />
                    </DockPanel>
                    <TextBlock x:Name="subject" Text="{Binding Subject}" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="WordEllipsis" Margin="0,2,0,0" />
                    <Border x:Name="needs" Style="{StaticResource Chip}" Background="{DynamicResource OrgAccentDim}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" Padding="8,1">
                        <TextBlock Style="{StaticResource Chip.Text}" Foreground="{DynamicResource OrgAccent}" FontWeight="SemiBold" FontSize="11.5">
                            <Run Text="{Binding NeedsTag, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unread}" Value="True">
                    <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="from" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="from" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="subject" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsDecision}" Value="True"><Setter TargetName="needs" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LetterListItem (ListBoxItem): a letter in the list — rounded, the open one marked in the org accent. -->
        <Style x:Key="LetterListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius.Card}" Margin="6,0,6,2" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardFill}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- JourneyStripTemplate: ItemsControl.ItemTemplate for JourneyStop items in a one-row UniformGrid -->
        <DataTemplate x:Key="JourneyStripTemplate">
            <StackPanel>
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="left" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Border x:Name="right" Grid.Column="2" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Ellipse x:Name="dot" Grid.Column="1" Width="14" Height="14" Fill="{StaticResource SurfaceSunken}" Stroke="{StaticResource BorderStrong}" StrokeThickness="2" />
                </Grid>
                <TextBlock x:Name="label" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="left" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="right" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="right" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="dot" Property="Width" Value="20" />
                    <Setter TargetName="dot" Property="Height" Value="20" />
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Bg}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="StrokeThickness" Value="5" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="label" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Result strip (the shell's "what just happened" line above the taskbar) ===== -->
        <!-- Rest colour = Surface; the flash is a dim gold that fades back to it when a new result lands. -->
        <Color x:Key="ResultStripRestColor">#1E232B</Color>
        <Color x:Key="ResultStripFlashColor">#6B5520</Color>
        <Style x:Key="ResultStrip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="12,3,6,3" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Text" Value="⚠" />
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
