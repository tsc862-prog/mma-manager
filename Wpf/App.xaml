        <Geometry x:Key="Icon.ChevronLeft">M15,5 L8,12 L15,19</Geometry>
        <Geometry x:Key="Icon.ChevronRight">M9,5 L16,12 L9,19</Geometry>

        <!-- Tokens: space and shape -->
        <Thickness x:Key="Space.Screen">16</Thickness>
        <Thickness x:Key="Space.Panel">18,16,18,18</Thickness>
        <Thickness x:Key="Space.Stack">0,0,0,10</Thickness>
        <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
        <CornerRadius x:Key="Radius.Card">8</CornerRadius>
        <CornerRadius x:Key="Radius.Pill">11</CornerRadius>
        <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>

        <!-- Tokens: type -->
        <Style x:Key="Text.Kicker" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Text.Note: a wrapping caption that collapses when it has nothing to say (a hint under a button). -->
        <Style x:Key="Text.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Text.Stat: one big number with a caption under it (a trade, a cost) — two or three side by side
             say more than a table row. Colour it with a Tone brush when it goes up or down. -->
        <Style x:Key="Text.Stat" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.Quote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <!-- Surfaces -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="Padding" Value="{StaticResource Space.Panel}" />
        </Style>
        <!-- HeroPanel (ContentControl): the top band of a screen, washed from the left in the org accent. -->
        <Style x:Key="HeroPanel" TargetType="ContentControl">
            <Setter Property="Padding" Value="24,20,24,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource PanelFill}" BorderBrush="{DynamicResource OrgAccentDim}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True">
                            <Grid>
                                <Border Background="{DynamicResource OrgAccentDim}" CornerRadius="{StaticResource Radius.Panel}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                            <GradientStop Color="#C0000000" Offset="0" />
                                            <GradientStop Color="#30000000" Offset="0.45" />
                                            <GradientStop Color="#00000000" Offset="0.8" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Padding" Value="20,12,20,12" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Hero parts that tighten in a short window (controls:Adaptive.IsCompact on the screen root). -->
        <Style x:Key="HeroLogo" TargetType="Border">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Width" Value="56" />
                    <Setter Property="Height" Value="56" />
                    <Setter Property="Margin" Value="0,0,14,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroName" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroQuote" TargetType="TextBlock" BasedOn="{StaticResource Text.Quote}">
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="LineHeight" Value="19" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HeroDetail" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroGap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Margin" Value="0,6,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- THE MOMENT: one poster-like card over the dimmed desktop (Views/MomentView.xaml). -->
        <SolidColorBrush x:Key="MomentScrim" Color="#E60A0C10" />
        <Style x:Key="MomentCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D222A" Offset="0" />
                        <GradientStop Color="#13161B" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Text.MomentKicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Kicker}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="13" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The one huge line ("AND NEW."): announcer words, never a stat. -->
        <Style x:Key="Text.Moment" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
            <Setter Property="FontSize" Value="92" />
            <Setter Property="LineHeight" Value="94" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="-4,2,0,4" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="60" />
                    <Setter Property="LineHeight" Value="62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.MomentName" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="FontSize" Value="26" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="20" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A gap between moment sections that closes up on a short screen. -->
        <Style x:Key="MomentGap" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,22,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="Margin" Value="0,10,0,0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- THE BRIEFING (Views/BriefingView.xaml): why the clock stopped as one headline card
             (the moment's poster language, smaller), then the digest and the calendar. -->
        <Style x:Key="Text.BriefingKicker" TargetType="TextBlock" BasedOn="{StaticResource Text.MomentKicker}">
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="12" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.BriefingHeadline" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="LineHeight" Value="40" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="-1,8,0,0" />
            <Style.Triggers>
                <Trigger Property="controls:Adaptive.IsCompact" Value="True">
                    <Setter Property="FontSize" Value="28" />
                    <Setter Property="LineHeight" Value="31" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.BriefingLede" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <!-- A small "done" pill on a headline whose fix has been made. -->
        <Style x:Key="BriefingPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToneGoodDim}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="10,3,11,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="Chip.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- ================= People and brands (owners, staff, sponsors, media partners) =================
             The ONE way a non-fighter face and a partner's logo are drawn. Content = the EXACT game name
             (OwnerName, a staff Name, a deal's Partner); controls:CorporateArt does the lookup.
             Sizes: faces 40-64 in rows, 64-96 on cards; marks 24-40 tall in rows, larger on offer cards. -->
        <!-- PersonFace (ContentControl): a round head-and-shoulders on a soft disc; initials when there is no portrait. -->
        <LinearGradientBrush x:Key="FaceDisc" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#454E5B" Offset="0" />
            <GradientStop Color="#272D36" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PersonFace" TargetType="ContentControl">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ToolTip="{TemplateBinding Content}">
                            <Ellipse Fill="{StaticResource FaceDisc}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:CorporateArt.FaceOf}}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="{StaticResource BorderStrong}" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- BrandMark (ContentControl): the partner's logo fitted into the box; the name on a quiet tile when there is no logo. -->
        <Style x:Key="BrandMark" TargetType="ContentControl">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ToolTip="{TemplateBinding Content}">
                            <Image x:Name="logo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:CorporateArt.LogoOf}}" />
                            <Border x:Name="tile" Visibility="Collapsed" CornerRadius="5" Background="{StaticResource SurfaceAlt}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="5,2">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="96" TextWrapping="Wrap"
                                               TextAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSoft}" />
                                </Viewbox>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static controls:CorporateArt.HasLogo}}" Value="False">
                                <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="tile" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- PersonCardTemplate: a PersonCard (an owner, a founder) — the face, a kicker, the name, one line about them. -->
        <DataTemplate x:Key="PersonCardTemplate">
            <DockPanel>
                <ContentControl DockPanel.Dock="Left" Style="{StaticResource PersonFace}" Content="{Binding Name}" Width="64" Height="64" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" FontSize="10.5" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <!-- StaffCardTemplate: a StaffRow (hired or on the market) — face, role, name, where they came from, quality and pay.
             Use inside a CardList so selection shows as the accent edge. -->
        <DataTemplate x:Key="StaffCardTemplate">
            <Border Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Padding="10,8">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource PersonFace}" Content="{Binding Name}" Width="48" Height="48" Margin="0,0,12,0" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource TextSoft}">
                            <Run Text="{Binding Salary, Mode=OneWay}" /><Run Text="/mo" Foreground="{StaticResource TextMuted}" />
                        </TextBlock>
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="7,1" ToolTip="Quality: how strong their effect is">
                            <TextBlock Style="{StaticResource Chip.Text}" FontSize="11.5" FontWeight="SemiBold">
                                <Run Text="Quality " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding Quality, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Role}" Style="{StaticResource Text.Kicker}" FontSize="10" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Background}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="WordEllipsis"
                                   ToolTip="{Binding Background}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!-- One promise to keep on a profile (a PromiseRow): a quiet card, red-edged while AtRisk. -->
        <Style x:Key="PromiseCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AtRisk}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ToneBadDim}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ToneBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons -->
        <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource OrgAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
            <Setter Property="Foreground" Value="#15181D" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                <Setter TargetName="b" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <!-- Button.Danger: the confirming button of a destructive question (shut it down, close it) — outlined in the bad tone, never filled. -->
        <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Foreground" Value="{StaticResource ToneBad}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToneBad}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- the implicit TextBlock style would paint a string label white: carry the button's own colour through -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Button.Soft" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Background" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OrgAccentDim}" />
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Button.Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter x:Name="c" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Button.Quiet: a secondary action that should not draw the eye (shut a platform down…): faint text, brighter on hover. -->
        <Style x:Key="Button.Quiet" TargetType="Button" BasedOn="{StaticResource Button.Link}">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- PlatformTradeTemplate: a PlatformTradeView — what a streaming giant's offer costs while our own
             platform runs: three numbers (the platform's net, the deal's expected pay, the difference), a
             sentence on each side of them, and a plain warning when our record would miss the deal's terms. -->
        <DataTemplate x:Key="PlatformTradeTemplate">
            <Border Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="12,10,12,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Kicker}" Foreground="{StaticResource ToneWarn}" TextTrimming="CharacterEllipsis">
                        <Run Text="THE TRADE  ·  SIGNING CLOSES " /><Run Text="{Binding Platform, Mode=OneWay}" />
                    </TextBlock>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock x:Name="net" Text="{Binding PlatformNet}" Style="{StaticResource Text.Stat}" Foreground="{StaticResource ToneGood}" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="None" TextWrapping="Wrap">
                                <Run Text="{Binding Platform, Mode=OneWay}" /><Run Text=" nets a quarter" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="{Binding OfferPays}" Style="{StaticResource Text.Stat}" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="None" TextWrapping="Wrap">
                                <Run Text="{Binding Partner, Mode=OneWay}" /><Run Text=" should pay a quarter" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="gain" Text="{Binding Gain}" Style="{StaticResource Text.Stat}" Foreground="{StaticResource ToneGood}" />
                            <TextBlock Text="a quarter if you sign" Style="{StaticResource Text.Caption}" TextTrimming="None" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Lede}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CloseLine}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                    <Border Background="{StaticResource ToneBadDim}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <controls:Icon DockPanel.Dock="Left" Kind="Warning" Width="18" Height="18" Brush="{StaticResource ToneBad}"
                                           VerticalAlignment="Top" Margin="0,1,10,0" />
                            <StackPanel>
                                <TextBlock Text="YOUR RECORD WOULD MISS THEIR TERMS" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource ToneBad}" />
                                <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PlatformUp}" Value="False">
                    <Setter TargetName="net" Property="Foreground" Value="{StaticResource ToneBad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GainUp}" Value="False">
                    <Setter TargetName="gain" Property="Foreground" Value="{StaticResource ToneBad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- OfferCardTemplate: an OfferRow (a sponsor or a network on the table) — the partner's mark large,
             who and what, the money and the term, their conditions, Sign / Pass. The host's DataContext
             carries AcceptOfferCommand / DeclineOfferCommand (Finance and the Media desk both do). -->
        <DataTemplate x:Key="OfferCardTemplate">
            <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="14,12" Margin="0,0,0,8">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource BrandMark}" Content="{Binding Partner}"
                                    Width="104" Height="60" VerticalAlignment="Top" Margin="0,2,16,0" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding SignLabel}" Style="{StaticResource Button.Primary}" Padding="18,5" FontSize="12.5" Margin="0,0,8,0"
                                Command="{Binding DataContext.AcceptOfferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button x:Name="pass" Content="Pass" Style="{StaticResource Button.Ghost}" Padding="14,4" FontSize="12.5"
                                Command="{Binding DataContext.DeclineOfferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneWarn}" Margin="10,2,0,0">
                                <Run Text="lapses " /><Run Text="{Binding Expires, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Partner}" Style="{StaticResource Text.Heading}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="0,1,0,0" />
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold">
                            <Run Text="{Binding Fee, Mode=OneWay}" Foreground="{StaticResource Positive}" FontFamily="Consolas" />
                            <Run Text="  ·  " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding Term, Mode=OneWay}" Foreground="{StaticResource TextSoft}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Terms}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <!-- a streaming giant while our own platform runs: what signing gives up, before we answer -->
                        <ContentControl Content="{Binding Trade}" ContentTemplate="{StaticResource PlatformTradeTemplate}" Focusable="False"
                                        Visibility="{Binding HasTrade, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMedia}" Value="True">
                    <Setter TargetName="pass" Property="ToolTip" Value="They only ask once — a passed network won't call again until it's back on the market" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- DealRowTemplate: a signed deal (SponsorRow / MediaRow: PartnerName, Line, Fee, Left, Strikes, Terms) —
             the partner's mark, who and the one line on them, the money and what's left. Hover for every term. -->
        <DataTemplate x:Key="DealRowTemplate">
            <Border BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1" Padding="2,7" Background="Transparent" ToolTip="{Binding Terms}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource BrandMark}" Content="{Binding PartnerName}" Width="72" Height="40" Margin="0,0,12,0" />
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="96">
                        <TextBlock Text="{Binding Fee}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource Positive}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Strikes}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneBad}" FontWeight="SemiBold" Margin="0,0,8,0"
                                       Visibility="{Binding HasStrikes, Converter={StaticResource BoolToVis}}" ToolTip="Strikes: missed terms. At the limit they walk." />
                            <TextBlock Text="{Binding Left}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PartnerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- BriefingItemTemplate: BriefingItem — a face (or a toned line icon), a kicker, one sentence,
             a line of detail and a link on the right. The digest and "also on your desk" both use it. -->
        <DataTemplate x:Key="BriefingItemTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="slot" Width="38" Height="38" VerticalAlignment="Top" Margin="0,1,12,0">
                    <Ellipse x:Name="disc" Fill="{StaticResource Track}" />
                    <controls:Icon x:Name="icon" Kind="{Binding Icon}" Width="18" Height="18" Brush="{StaticResource TextSoft}" />
                    <Ellipse x:Name="face" Visibility="Collapsed" Stroke="{StaticResource PanelEdge}">
                        <Ellipse.Fill><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                    </Ellipse>
                    <ContentControl x:Name="brand" Style="{StaticResource BrandMark}" Content="{Binding Brand}" Width="56" Height="38" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" FontSize="10.5" Margin="0,0,0,1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <TextBlock x:Name="detail" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="act" Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Command}"
                        Style="{StaticResource Button.Link}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Visible" />
                    <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBrand}" Value="True">
                    <Setter TargetName="brand" Property="Visibility" Value="Visible" />
                    <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="disc" Property="Visibility" Value="Collapsed" />
                    <!-- a logo is wider than a face: the slot grows so a pill-shaped mark is still legible -->
                    <Setter TargetName="slot" Property="Width" Value="56" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kicker}" Value=""><Setter TargetName="kicker" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasDetail}" Value="False"><Setter TargetName="detail" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasAction}" Value="False"><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="disc" Property="Fill" Value="{StaticResource ToneBadDim}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneBad}" /><Setter TargetName="face" Property="Stroke" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="disc" Property="Fill" Value="{StaticResource ToneWarnDim}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneWarn}" /><Setter TargetName="face" Property="Stroke" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="disc" Property="Fill" Value="{StaticResource ToneGoodDim}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="disc" Property="Fill" Value="{StaticResource ToneInfoDim}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A borderless clickable surface (a whole card that opens something). -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (RadioButtons in a Segmented border): "Cards | Table", "Everyone | Ready | Injured". -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <!-- Siblings in one panel, no GroupName (see the style guide at the top: named groups crash). -->
        <Style x:Key="SegmentedOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FAME (the World Map's fame layers; models in ViewModels/WorldMapViewModel.cs, colours from Fame.Heat) -->
        <!-- One legend stop: a heat swatch over its word. -->
        <DataTemplate x:Key="FameLegendStopTemplate">
            <StackPanel Margin="0,0,3,0" Width="78">
                <Border Height="10" Background="{Binding Brush}" CornerRadius="2" />
                <TextBlock Text="{Binding Word}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <!-- A city where the name carries, as a heat-coloured chip (the host binds the click). -->
        <Style x:Key="HotSpotChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{Binding HeatBrush}" CornerRadius="6" Padding="10,5" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon x:Name="home" Kind="Home" Width="14" Height="14" Brush="{Binding InkBrush}" StrokeThickness="2"
                                               Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Text="{Binding City}" FontWeight="SemiBold" Foreground="{Binding InkBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="where" Text="{Binding Where}" FontSize="11" Foreground="{Binding InkBrush}" Opacity="0.8" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Fame}" FontWeight="Bold" FontSize="14" Foreground="{Binding InkBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHome}" Value="True"><Setter TargetName="home" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Where}" Value=""><Setter TargetName="where" Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A breadcrumb hop (World > Asia > Japan): gold link, the last hop plain text (no disabled-button grey box). -->
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,0"><ContentPresenter VerticalAlignment="Center" /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The HOME pill on a place card's heat strip (the fame subject's home town is in this place). -->
        <Style x:Key="HomePill" TargetType="Border">
            <Setter Property="Background" Value="#CC12151A" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- CardsTableToggle (ToggleButton): the small "Cards | Table" switch for a list that is cards by default;
             IsChecked = the dense sortable table. Bind IsChecked to the screen's Show…Table (a session-long VM flag). -->
        <Style x:Key="CardsTableToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Cards, or the dense sortable table" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Style="{StaticResource Segmented}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="cards" CornerRadius="5" Padding="9,2" Background="{StaticResource CardHover}">
                                    <TextBlock x:Name="cardsText" Text="Cards" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="table" CornerRadius="5" Padding="9,2" Background="Transparent">
                                    <TextBlock x:Name="tableText" Text="Table" Foreground="{StaticResource TextSoft}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cards" Property="Background" Value="Transparent" />
                                <Setter TargetName="cardsText" Property="Foreground" Value="{StaticResource TextSoft}" />
                                <Setter TargetName="cardsText" Property="FontWeight" Value="Normal" />
                                <Setter TargetName="table" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="tableText" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="tableText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MapListToggle (ToggleButton): "Map | List" for a screen whose picture leads (the World Map);
             IsChecked = the List (the place cards). Same look as CardsTableToggle. -->
        <Style x:Key="MapListToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="The drawn map, or the place cards as a list" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Style="{StaticResource Segmented}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="map" CornerRadius="5" Padding="9,2" Background="{StaticResource CardHover}">
                                    <TextBlock x:Name="mapText" Text="Map" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="list" CornerRadius="5" Padding="9,2" Background="Transparent">
                                    <TextBlock x:Name="listText" Text="List" Foreground="{StaticResource TextSoft}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="map" Property="Background" Value="Transparent" />
                                <Setter TargetName="mapText" Property="Foreground" Value="{StaticResource TextSoft}" />
                                <Setter TargetName="mapText" Property="FontWeight" Value="Normal" />
                                <Setter TargetName="list" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="listText" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="listText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MapHoverCard (Border): the card that follows the pointer on a drawn map (a city's or a country's facts). -->
        <Style x:Key="MapHoverCard" TargetType="Border">
            <Setter Property="Background" Value="#151A21" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,9,14,10" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The sea around a zoomed map and the frame it sits in. -->
        <SolidColorBrush x:Key="MapSea" Color="#0B1117" />

        <!-- SearchBox (TextBox): rounded field with a search icon; Tag = the placeholder text. -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OrgAccent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="17">
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon Kind="Search" Width="16" Height="16" Brush="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FilterChip (ToggleButton or RadioButton): a pill filter that lights up in the org accent when on ("On my shortlist", "Needs a decision · 3"). -->
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}" Padding="12,5" MinHeight="30">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChip.Radio" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}" />

        <!-- FilterChip.Compact (ToggleButton): the same pill, smaller, for a narrow rail with many filters ("Needs a fight · 12"). -->
        <Style x:Key="FilterChip.Compact" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Pill}" Padding="8,2,8,3" MinHeight="22">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ChipList (ListBox): a wrapping row of one-choice pills bound to SelectedItem
             (News kinds, Inbox folders). Items draw with their ToString or an ItemTemplate. -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Pill}" Padding="12,5" Margin="0,0,6,6" MinHeight="30">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field: a labelled picker in a filter row ("Division [Every division ▾]"). -->
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,14,6" />
            <Setter Property="MinWidth" Value="170" />
        </Style>

        <!-- controls:SectionHeader -->
        <Style TargetType="controls:SectionHeader">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SectionHeader">
                        <DockPanel>
                            <Button x:Name="act" DockPanel.Dock="Right" Style="{StaticResource Button.Link}" VerticalAlignment="Top"
                                    Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionParameter}" Margin="8,0,-4,0" />
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="17" />
                                <TextBlock x:Name="hint" Text="{TemplateBinding Hint}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Hint" Value=""><Setter TargetName="hint" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:EmptyState -->
        <Style TargetType="controls:EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:EmptyState">
                        <StackPanel MaxWidth="460" Margin="24">
                            <Border x:Name="disc" Width="80" Height="80" CornerRadius="40" Background="{DynamicResource OrgAccentDim}" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="glyph" Text="{TemplateBinding Glyph}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <controls:Icon x:Name="icon" Kind="{TemplateBinding Icon}" Width="38" Height="38" StrokeThickness="1.5"
                                                   Brush="{DynamicResource OrgAccent}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Title}" FontSize="22" TextAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="{TemplateBinding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSoft}" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20" />
                            <Button x:Name="act" Style="{StaticResource Button.Primary}" Content="{TemplateBinding ActionText}"
                                    Command="{TemplateBinding ActionCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="foot" Text="{TemplateBinding Footnote}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActionText" Value=""><Setter TargetName="act" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Footnote" Value=""><Setter TargetName="foot" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Icon" Value=""><Setter TargetName="icon" Property="Visibility" Value="Collapsed" /></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Glyph" Value="" /><Condition Property="Icon" Value="" /></MultiTrigger.Conditions>
                                <Setter TargetName="disc" Property="Visibility" Value="Collapsed" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:DrawMeter: drawing power (popularity, a public fact) -->
        <Style TargetType="controls:DrawMeter">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DrawMeter">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <controls:DrawBars x:Name="bars" Width="22" Height="11" VerticalAlignment="Center"
                                               Level="{Binding Level, RelativeSource={RelativeSource TemplatedParent}}"
                                               Fill="{StaticResource DrawInk}" Track="{StaticResource DrawTrack}" />
                            <TextBlock x:Name="word" Text="{TemplateBinding Word}" Margin="7,0,0,0" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="num" Text="{TemplateBinding NumberText}" Margin="7,0,0,0" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource DrawInk}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsStar" Value="True">
                                <Setter TargetName="word" Property="Foreground" Value="{StaticResource Gold}" />
                                <Setter TargetName="word" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="bars" Property="Fill" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsQuiet" Value="True">
                                <Setter TargetName="word" Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Setter TargetName="num" Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="NumberText" Value=""><Setter TargetName="num" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:RatingBadge -->
        <Style TargetType="controls:RatingBadge">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:RatingBadge">
                        <StackPanel Orientation="Horizontal" ToolTip="Your scout's read of this fighter (not the whole truth)">
                            <Grid Width="56" Height="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Fraction, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ColumnDefinition Width="{Binding Rest, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="{StaticResource Track}" CornerRadius="3" />
                                <Border Background="{TemplateBinding Tone}" CornerRadius="3" />
                            </Grid>
                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" FontSize="13"
                                       Foreground="{TemplateBinding Tone}" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Word}" FontSize="12" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- controls:CardWall (virtualised lines of cards) -->
        <Style TargetType="controls:CardWall">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:CardWall">
                        <ItemsControl ItemsSource="{Binding Lines, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Item">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" CanContentScroll="True">
                                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- a section heading (drawn on top of its first line of cards) -->
                                        <DockPanel x:Name="head" Margin="2,14,0,8" Visibility="Collapsed">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Header.Title}" Style="{StaticResource Text.Title}" FontSize="17" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{Binding Header.Detail}" Style="{StaticResource Text.Caption}" Margin="12,0,0,2" VerticalAlignment="Bottom" />
                                        </DockPanel>
                                        <!-- a full-width feature (CardBanner) -->
                                        <ContentControl x:Name="banner" Focusable="False" Content="{Binding Banner.Content}" Margin="0,0,12,14" Visibility="Collapsed" HorizontalAlignment="Left"
                                                          Width="{Binding BannerWidth}" ContentTemplate="{Binding BannerTemplate}" />
                                        <!-- a line of cards -->
                                        <ItemsControl x:Name="line" ItemsSource="{Binding Cards}" Focusable="False" HorizontalAlignment="Left"
                                                      Width="{Binding Width}" ItemTemplate="{Binding CardTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="{Binding Columns}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,12,12" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="head" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasCards}" Value="False">
                                            <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBanner}" Value="True">
                                            <Setter TargetName="banner" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="line" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status line colour by CardTone (used by the fighter + action templates). -->
        <Style x:Key="Text.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>

        <!-- FighterCardTemplate: a contact card for walls of fighters -->
        <DataTemplate x:Key="FighterCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="164"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- face: rounded left edge of the card -->
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="champ" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#D9161A1F" CornerRadius="0,0,0,8" Padding="4,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:Icon Kind="Crown" Width="13" Height="13" Brush="{StaticResource Gold}" StrokeThickness="2" Margin="0,0,4,0" />
                            <TextBlock Text="CHAMP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9,10,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock x:Name="nick" Text="{Binding Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <controls:DrawMeter x:Name="draw" Value="{Binding Popularity}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="deal" Text="{Binding ContractText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Text.Status}" Margin="0,1,0,0" />
                    </StackPanel>
                    <!-- the fighter last picked/opened: survives refreshes by id -->
                    <Border x:Name="sel" Grid.ColumnSpan="2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource OrgAccent}"
                            IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChampion}" Value="True"><Setter TargetName="champ" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Nickname}" Value=""><Setter TargetName="nick" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ShowsDraw}" Value="False"><Setter TargetName="draw" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Warn"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneWarn}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding ContractTone}" Value="Bad"><Setter TargetName="deal" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="deal" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Good"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Bad"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Info"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- WorldFighterCardTemplate: a fighter from anywhere in the world (Fighters app):
             who they fight for instead of the deal, and a shortlist star. -->
        <DataTemplate x:Key="WorldFighterCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="164"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="champ" Visibility="Collapsed" VerticalAlignment="Bottom" Background="#D9161A1F" CornerRadius="0,0,0,8" Padding="4,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:Icon Kind="Crown" Width="13" Height="13" Brush="{StaticResource Gold}" StrokeThickness="2" Margin="0,0,4,0" />
                            <TextBlock Text="CHAMP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,9,30,8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock x:Name="nick" Text="{Binding Nickname}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        <DockPanel Margin="0,4,0,0">
                            <Image x:Name="logo" DockPanel.Dock="Left" Source="{Binding AffiliationLogo}" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock x:Name="aff" Text="{Binding Affiliation}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <controls:DrawMeter x:Name="draw" Value="{Binding Popularity}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Text.Status}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- shortlist star: pins the fighter to the Notes shortlist -->
                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Style="{StaticResource Button.Link}" Padding="0"
                            Command="{x:Static mvvm:AppCommands.ToggleShortlist}"
                            CommandParameter="{Binding Id}" ToolTip="Pin to your shortlist (Notes app)">
                        <controls:Icon x:Name="star" Kind="Star" Width="18" Height="18" Brush="{StaticResource TextSecondary}" />
                    </Button>
                    <Border x:Name="sel" Grid.ColumnSpan="2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource OrgAccent}"
                            IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChampion}" Value="True"><Setter TargetName="champ" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Nickname}" Value=""><Setter TargetName="nick" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding ShowsDraw}" Value="False"><Setter TargetName="draw" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasAffiliationLogo}" Value="False">
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="aff" Property="Foreground" Value="{StaticResource ToneInfo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMine}" Value="True"><Setter TargetName="aff" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsShortlisted}" Value="True"><Setter TargetName="star" Property="Brush" Value="{StaticResource Gold}" /><Setter TargetName="star" Property="StrokeThickness" Value="2.4" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Good"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Bad"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Info"><Setter TargetName="status" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- FighterRowCardTemplate: compact person row with the reason they matter now -->
        <DataTemplate x:Key="FighterRowCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <DockPanel Margin="0,0,10,0">
                    <Border DockPanel.Dock="Left" Width="64" Height="72" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <controls:RatingBadge DockPanel.Dock="Right" Value="{Binding Scout}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel VerticalAlignment="Center" Margin="12,6,0,6">
                        <TextBlock x:Name="why" Text="{Binding Why}" Style="{StaticResource Text.Kicker}" Foreground="{DynamicResource OrgAccent}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWhy}" Value="False"><Setter TargetName="why" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ActionRowTemplate: one "needs you" item -->
        <DataTemplate x:Key="ActionRowTemplate">
            <Border x:Name="row" Background="{StaticResource CardFill}" CornerRadius="{StaticResource Radius.Card}" Margin="0,0,0,8"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1">
                <DockPanel>
                    <Border x:Name="stripe" DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{StaticResource BorderStrong}" />
                    <Grid Margin="12,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="pic" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="glyph" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Track}" Margin="0,0,12,0" VerticalAlignment="Top">
                            <controls:Icon x:Name="icon" Kind="{Binding Icon}" Width="20" Height="20" Brush="{StaticResource TextSoft}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <TextBlock x:Name="due" DockPanel.Dock="Right" Text="{Binding Due}" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="14" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,9,0,0">
                            <Button x:Name="primary" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" CommandParameter="{Binding PrimaryParameter}"
                                    Style="{StaticResource Button.Soft}" Padding="14,5" FontSize="12.5" />
                            <Button x:Name="secondary" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" CommandParameter="{Binding SecondaryParameter}"
                                    Style="{StaticResource Button.Ghost}" Padding="12,4" FontSize="12.5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                    <Setter TargetName="pic" Property="Visibility" Value="Visible" />
                    <Setter TargetName="glyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSecondary}" Value="False"><Setter TargetName="secondary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding PrimaryText}" Value=""><Setter TargetName="primary" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="stripe" Property="Background" Value="{StaticResource Crimson}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneBad}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneBad}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneBadDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneWarn}" /><Setter TargetName="due" Property="Foreground" Value="{StaticResource ToneWarn}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneWarn}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneWarnDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneInfo}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneInfo}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneInfoDim}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="stripe" Property="Background" Value="{StaticResource ToneGood}" /><Setter TargetName="icon" Property="Brush" Value="{StaticResource ToneGood}" /><Setter TargetName="glyph" Property="Background" Value="{StaticResource ToneGoodDim}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- HeadlineCardTemplate: a story with a face -->
        <DataTemplate x:Key="HeadlineCardTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" Command="{Binding OpenCommand}" CommandParameter="{Binding OpenParameter}">
                <DockPanel Margin="0,0,12,0">
                    <Border DockPanel.Dock="Left" Width="72" MinHeight="80" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Picture}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,9,0,10" VerticalAlignment="Center">
                        <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock x:Name="quote" Text="{Binding Quote}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,4,0,0" MaxHeight="36" TextTrimming="WordEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True"><Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Button.Chip: a small rounded link that follows a story or a letter to someone ("Kenji Morita", "AFC", "AFC 301"). -->
        <Style x:Key="Button.Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Track}" CornerRadius="{StaticResource Radius.Pill}" Padding="9,2,10,3" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button.Icon: a small square ghost button for a row's quiet actions (move up, move down, remove). -->
        <Style x:Key="Button.Icon" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToneTagTemplate: a small fact pill for anything with Text + Tone (CardTone): "Bad blood · heat 60", "Last fight on the deal". -->
        <DataTemplate x:Key="ToneTagTemplate">
            <Border x:Name="b" Background="{StaticResource Track}" CornerRadius="{StaticResource Radius.Pill}" Padding="8,2,8,3" Margin="0,0,6,6">
                <TextBlock x:Name="t" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneGoodDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneGood}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneWarnDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneBadDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter TargetName="b" Property="Background" Value="{StaticResource ToneInfoDim}" /><Setter TargetName="t" Property="Foreground" Value="{StaticResource ToneInfo}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The two corners: frame and name colours for red and blue, wherever a pairing is drawn. -->
        <SolidColorBrush x:Key="CornerRed" Color="#A8453C" />
        <SolidColorBrush x:Key="CornerBlue" Color="#3C639E" />
        <SolidColorBrush x:Key="CornerRedText" Color="#E88A80" />
        <SolidColorBrush x:Key="CornerBlueText" Color="#82AEE8" />

        <!-- FormChipTemplate: one past result as a square chip ("W" / "L" / "D" / "NC") with Text + Tone + Tip (method, opponent, card). -->
        <DataTemplate x:Key="FormChipTemplate">
            <Border Width="22" Height="20" CornerRadius="4" Margin="0,0,3,0" ToolTip="{Binding Tip}"
                    Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Border>
        </DataTemplate>

        <!-- SheetLineTemplate: a labelled line (Label + Text + Tone): a small caps label, then the words, wrapping. -->
        <DataTemplate x:Key="SheetLineTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SheetLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="l" Text="{Binding Label}" Style="{StaticResource SectionLabel}" Margin="0,2,10,0" MaxWidth="110" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLabel}" Value="False"><Setter TargetName="l" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- CardList (ListBox): a virtualized column of card rows with keyboard focus (arrows move, the
             selected row carries the accent edge). Give it an ItemTemplate; Enter is the view's to handle. -->
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="edge" BorderThickness="1" BorderBrush="Transparent" CornerRadius="{StaticResource Radius.Card}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabStrip (ListBox): documents open side by side, one selected (the Card Desk's events).
             Give it an ItemTemplate; the selected tab carries an accent underline. -->
        <Style x:Key="TabStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}" Padding="12,6,14,7" Margin="0,0,6,6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- StoryCardTemplate: StoryCardModel as a fixed-height wall card (News). Click = the person
             (else the event, else the promotion); the chips follow the story anywhere it leads. -->
        <DataTemplate x:Key="StoryCardTemplate">
            <Button Style="{StaticResource CardButton}" Height="156" Command="{Binding OpenCommand}" CommandParameter="{Binding OpenParameter}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="96" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Grid>
                            <Image x:Name="face" Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image x:Name="logo" Source="{Binding Face.Image}" Margin="18" Visibility="Collapsed" VerticalAlignment="Center" />
                            <controls:Icon x:Name="wire" Kind="Newspaper" Width="34" Height="34" Brush="{StaticResource TextSecondary}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="12,0,10,10" Height="22" ClipToBounds="True">
                        <Button x:Name="who" Style="{StaticResource Button.Chip}" ToolTip="Open the profile"
                                Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding FighterId}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="People" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding FighterName}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="org" Style="{StaticResource Button.Chip}" Content="{Binding PromotionLabel}" ToolTip="Open the promotion's page"
                                Command="{x:Static mvvm:AppCommands.OpenOrg}" CommandParameter="{Binding PromotionId}" />
                        <Button x:Name="ev" Style="{StaticResource Button.Chip}" ToolTip="Open the event page"
                                Command="{x:Static mvvm:AppCommands.OpenEvent}" CommandParameter="{Binding EventId}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="Calendar" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding EventName}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Margin="12,10,12,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon x:Name="kind" Kind="{Binding Icon}" Width="13" Height="13" Brush="{StaticResource TextSecondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,4,0,0" MaxHeight="40" TextTrimming="WordEllipsis" />
                        <TextBlock x:Name="quote" Text="{Binding Quote}" Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,3,0,0" MaxHeight="36" TextTrimming="WordEllipsis" />
                        <TextBlock x:Name="body" Text="{Binding Body}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" MaxHeight="36" TextTrimming="WordEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PictureIsLogo}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNoPicture}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="wire" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasQuote}" Value="False">
                    <Setter TargetName="quote" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="body" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFighter}" Value="False"><Setter TargetName="who" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasPromotion}" Value="False"><Setter TargetName="org" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasEvent}" Value="False"><Setter TargetName="ev" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True">
                    <Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="kind" Property="Brush" Value="{DynamicResource OrgAccent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LeadStoryTemplate: the same StoryCardModel as the big feature at the top of a wall (CardWall.BannerTemplate). -->
        <DataTemplate x:Key="LeadStoryTemplate">
            <Border Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="200" MinHeight="200" CornerRadius="10,0,0,10" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Grid>
                            <Image x:Name="face" Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image x:Name="logo" Source="{Binding Face.Image}" Margin="40" Visibility="Collapsed" />
                            <controls:Icon x:Name="wire" Kind="Newspaper" Width="64" Height="64" StrokeThickness="1.3" Brush="{StaticResource TextSecondary}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,18,24,18" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="{StaticResource Radius.Pill}" Background="{StaticResource Crimson}" Padding="8,1" Margin="0,0,10,0">
                                <TextBlock Text="LEAD STORY" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Display}" FontSize="26" Margin="0,8,0,0" />
                        <TextBlock x:Name="body" Text="{Binding Body}" Style="{StaticResource Text.Body}" Foreground="{StaticResource TextSoft}" Margin="0,8,0,0" LineHeight="20" />
                        <DockPanel x:Name="quote" Margin="0,10,0,0">
                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Background="{DynamicResource OrgAccent}" Margin="0,2,14,2" />
                            <TextBlock Text="{Binding Quote}" Style="{StaticResource Text.Quote}" />
                        </DockPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="who" Style="{StaticResource Button.Soft}" Margin="0,0,8,6" FontSize="12.5" Padding="12,5"
                                    Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding FighterId}">
                                <TextBlock><Run Text="{Binding FighterName, Mode=OneWay}" /><Run Text="'s profile ▸" /></TextBlock>
                            </Button>
                            <Button x:Name="ev" Style="{StaticResource Button.Ghost}" Margin="0,0,8,6" FontSize="12.5" Padding="12,4"
                                    Command="{x:Static mvvm:AppCommands.OpenEvent}" CommandParameter="{Binding EventId}">
                                <TextBlock><Run Text="{Binding EventName, Mode=OneWay}" /><Run Text=" ▸" /></TextBlock>
                            </Button>
                            <Button x:Name="org" Style="{StaticResource Button.Ghost}" Margin="0,0,8,6" FontSize="12.5" Padding="12,4"
                                    Command="{x:Static mvvm:AppCommands.OpenOrg}" CommandParameter="{Binding PromotionId}">
                                <TextBlock><Run Text="{Binding PromotionLabel, Mode=OneWay}" /><Run Text=" page ▸" /></TextBlock>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PictureIsLogo}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNoPicture}" Value="True">
                    <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="logo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="wire" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasQuote}" Value="False"><Setter TargetName="quote" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasBody}" Value="False"><Setter TargetName="body" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasFighter}" Value="False"><Setter TargetName="who" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasPromotion}" Value="False"><Setter TargetName="org" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasEvent}" Value="False"><Setter TargetName="ev" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding AboutPlayer}" Value="True"><Setter TargetName="kicker" Property="Foreground" Value="{DynamicResource OrgAccent}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Avatar (ContentControl, Content = anything with Picture/HasPicture/Icon): a round face, or a desk's line icon on a disc. Size with Width/Height. -->
        <Style x:Key="Avatar" TargetType="ContentControl">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse x:Name="disc" Fill="{StaticResource Track}" />
                            <controls:Icon x:Name="icon" Kind="{Binding Content.Icon, RelativeSource={RelativeSource TemplatedParent}}" Brush="{StaticResource TextSoft}"
                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:Scale.Half}}"
                                           Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:Scale.Half}}" />
                            <Ellipse x:Name="face" Visibility="Collapsed">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Content.Picture, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" AlignmentY="Top" /></Ellipse.Fill>
                            </Ellipse>
                            <!-- a partner writing in (Content.Brand = its exact name): the logo, unclipped -->
                            <ContentControl x:Name="brand" Style="{StaticResource BrandMark}" Content="{Binding Content.Brand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Content.HasPicture, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="face" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Content.HasBrand, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="brand" Property="Visibility" Value="Visible" />
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="face" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="disc" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LetterRowTemplate: LetterModel in a mail list — sender's face or desk, subject, the opening line, and a "needs you" tag. -->
        <DataTemplate x:Key="LetterRowTemplate">
            <Grid Margin="10,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top">
                    <ContentControl Style="{StaticResource Avatar}" Content="{Binding}" Margin="6,0,0,0" />
                    <Ellipse x:Name="dot" Width="9" Height="9" Fill="{DynamicResource OrgAccent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                        <TextBlock x:Name="from" Text="{Binding Sender}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" />
                    </DockPanel>
                    <TextBlock x:Name="subject" Text="{Binding Subject}" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="WordEllipsis" Margin="0,2,0,0" />
                    <Border x:Name="needs" Style="{StaticResource Chip}" Background="{DynamicResource OrgAccentDim}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" Padding="8,1">
                        <TextBlock Style="{StaticResource Chip.Text}" Foreground="{DynamicResource OrgAccent}" FontWeight="SemiBold" FontSize="11.5">
                            <Run Text="{Binding NeedsTag, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unread}" Value="True">
                    <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="from" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="from" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="subject" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NeedsDecision}" Value="True"><Setter TargetName="needs" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LetterListItem (ListBoxItem): a letter in the list — rounded, the open one marked in the org accent. -->
        <Style x:Key="LetterListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{StaticResource Radius.Card}" Margin="6,0,6,2" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardFill}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- JourneyStripTemplate: ItemsControl.ItemTemplate for JourneyStop items in a one-row UniformGrid -->
        <DataTemplate x:Key="JourneyStripTemplate">
            <StackPanel>
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="left" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Border x:Name="right" Grid.Column="2" Height="3" Background="{StaticResource Track}" VerticalAlignment="Center" />
                    <Ellipse x:Name="dot" Grid.Column="1" Width="14" Height="14" Fill="{StaticResource SurfaceSunken}" Stroke="{StaticResource BorderStrong}" StrokeThickness="2" />
                </Grid>
                <TextBlock x:Name="label" Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter TargetName="left" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter TargetName="right" Property="Visibility" Value="Hidden" /></DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="right" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Current}" Value="True">
                    <Setter TargetName="dot" Property="Width" Value="20" />
                    <Setter TargetName="dot" Property="Height" Value="20" />
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Bg}" />
                    <Setter TargetName="dot" Property="Stroke" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="dot" Property="StrokeThickness" Value="5" />
                    <Setter TargetName="left" Property="Background" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="label" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Result strip (the shell's "what just happened" line above the taskbar) ===== -->
        <!-- Rest colour = Surface; the flash is a dim gold that fades back to it when a new result lands. -->
        <Color x:Key="ResultStripRestColor">#1E232B</Color>
        <Color x:Key="ResultStripFlashColor">#6B5520</Color>
        <Style x:Key="ResultStrip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="12,3,6,3" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasStatus}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Negative}" />
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultStripGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsAlert}" Value="True">
                    <Setter Property="Text" Value="⚠" />
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= THE TABLE (NegotiationWindow) =================
             Talks are promoter and fighter: his photo on the left, the paperwork in the
             middle (your slip, the rival's paper beside it), what he says on the right.
             Paper is the one light surface in the app: a physical object on a dark table.
               TablePaper / TablePaperCool   your slip (warm) / a rival's letterhead (cool)
               TableInk / TableInkSoft       typed text on paper / its labels
               TablePencil                   his number, pencilled in your slip's margin
               Slip (Border), Slip.Label, Slip.Value, Slip.Note, Slip.Field (TextBox), Slip.Check
               Slip.Promise (CheckBox, fades when it can't be offered), Slip.Small (ink note under it),
               Slip.Pick (RadioButton: one number on a small paper picker)
               SlipChipView (DataTemplate for a SlipChip: "−$5,500" green, "+$4,500" red, "no belt" grey) + TablePencilGreen
             Rule (owner, 2026-11-15): numbers and short labels on the paper, sentences in tooltips.
               Stamp (Border) + Stamp.Text   rubber stamp on paper ("CAME BACK ONCE")
               LeanSegment (Border) + LeanSegment.Text: one third of the leaning bar, lit when its Tag is bound to true
             ===================================================================== -->
        <SolidColorBrush x:Key="TablePaper" Color="#ECE5D3" />
        <SolidColorBrush x:Key="TablePaperCool" Color="#DCE2E8" />
        <SolidColorBrush x:Key="TableInk" Color="#1D2127" />
        <SolidColorBrush x:Key="TableInkSoft" Color="#5E5A50" />
        <SolidColorBrush x:Key="TableRule" Color="#B3AA96" />
        <SolidColorBrush x:Key="TablePencil" Color="#A8423B" />

        <Style x:Key="Slip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TablePaper}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="18,16,18,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Slip.Kicker" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TableInkSoft}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Slip.Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TableInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Slip.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TableInkSoft}" />
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>
        <Style x:Key="Slip.Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TableInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Slip.Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{StaticResource TablePencil}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="10,0,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Slip.Field" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TableInk}" />
            <Setter Property="CaretBrush" Value="{StaticResource TableInk}" />
            <Setter Property="SelectionBrush" Value="#C9A54A" />
            <Setter Property="Background" Value="#F6F1E4" />
            <Setter Property="BorderBrush" Value="{StaticResource TableRule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1.5" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2,2,0,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TableInk}" />
                                <Setter TargetName="b" Property="Background" Value="#FBF8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Slip.Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TableInk}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <!-- (the app's implicit TextBlock style is light-on-dark: give the label paper ink) -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#1D2127" FontSize="12" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A promise (or the matching right) written on the slip: bold ink label, greyed out
             (never hidden) when it can't be offered. -->
        <Style x:Key="Slip.Promise" TargetType="CheckBox" BasedOn="{StaticResource Slip.Check}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#1D2127" FontSize="12.5" FontWeight="SemiBold" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- What a promise means to him, or why he won't take it: small ink under its toggle. -->
        <Style x:Key="Slip.Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TableInkSoft}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="21,1,0,0" />
        </Style>
        <!-- One number on a small picker drawn on the slip (the activity promise's 2 / 3 / 4). -->
        <Style x:Key="Slip.Pick" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="box" Width="24" Height="20" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{StaticResource TableRule}" Background="#F6F1E4">
                            <TextBlock x:Name="num" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1D2127" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#1D2127" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#1D2127" />
                                <Setter TargetName="num" Property="Foreground" Value="#ECE5D3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#1D2127" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A small chip on paper (a SlipChip): a money effect or a short reason, by Tone
             ("Good" = cheaper for you, green pencil; "Bad" = dearer, red pencil; "Muted" = grey). -->
        <SolidColorBrush x:Key="TablePencilGreen" Color="#2F7A4A" />
        <DataTemplate x:Key="SlipChipView">
            <Border x:Name="chip" CornerRadius="9" Padding="7,1,7,2" BorderThickness="1" Background="Transparent"
                    BorderBrush="{StaticResource TableRule}">
                <TextBlock x:Name="txt" Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TableInkSoft}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Good">
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource TablePencilGreen}" />
                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource TablePencilGreen}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource TablePencil}" />
                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource TablePencil}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasText}" Value="False">
                    <Setter TargetName="chip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Stamp" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource TablePencil}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style x:Key="Stamp.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TablePencil}" />
        </Style>
        <Style x:Key="LeanSegment" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Track}" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OrgAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LeanSegment.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Foreground" Value="#15181D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== ORIGINS: the 1993 houses and the bracket ===================== -->
        <!-- A house rule in plain words: a small accent bullet and wrapped text. -->
        <DataTemplate x:Key="RuleLineTemplate">
            <DockPanel Margin="0,0,0,5">
                <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource OrgAccent}" VerticalAlignment="Top" Margin="0,7,9,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
            </DockPanel>
        </DataTemplate>
        <!-- The seed number on a field card or a bracket line. -->
        <Style x:Key="SeedBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SeedBadge.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        </Style>
        <!-- One man in a tournament field (FieldEntry): face, seed, what he is, why he's in or out. -->
        <DataTemplate x:Key="FieldEntryTemplate">
            <Button Style="{StaticResource CardButton}" Width="292" Height="96" Margin="0,0,10,10"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Border x:Name="seed" Style="{StaticResource SeedBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Background="#E6161A1F">
                        <TextBlock Text="{Binding Seed}" Style="{StaticResource SeedBadge.Text}" Foreground="{StaticResource Gold}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,7,8,6">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Craft, Mode=OneWay}" Foreground="{StaticResource TextSoft}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{Binding Record, Mode=OneWay}" /><Run Text="  ·  scouts: " /><Run Text="{Binding Read, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Name="note" Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="0,2,0,0" ToolTip="{Binding Note}" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Seed}" Value=""><Setter TargetName="seed" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasNote}" Value="False"><Setter TargetName="note" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- One corner of a bracket bout (BracketCorner): seed, face, name; the winner bright, the loser dimmed. -->
        <DataTemplate x:Key="BracketCornerTemplate">
            <Button x:Name="row" Style="{StaticResource Button.Link}" HorizontalContentAlignment="Stretch" Padding="0"
                    Command="{x:Static mvvm:AppCommands.OpenFighter}" CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <DockPanel Margin="0,2">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SeedBadge}" Height="20" MinWidth="22" Margin="0,0,7,0">
                        <TextBlock Text="{Binding Seed}" Style="{StaticResource SeedBadge.Text}" FontSize="10.5" />
                    </Border>
                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Background="{StaticResource SurfaceSunken}" Margin="0,0,8,0">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                    </Border>
                    <TextBlock x:Name="tag" DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="10.5" Foreground="{StaticResource ToneWarn}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock x:Name="name" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5" Foreground="{StaticResource TextMuted}" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Won}" Value="True">
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTag}" Value="False"><Setter TargetName="tag" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <!-- an empty slot: nobody to open -->
                <DataTrigger Binding="{Binding Id}" Value="0">
                    <Setter TargetName="row" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="name" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- A bracket bout: two corners, how it ended, and who went through when it wasn't simply the winner. -->
        <DataTemplate x:Key="BracketBoutTemplate">
            <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="9,6" Margin="0,6" VerticalAlignment="Center">
                <StackPanel>
                    <ContentPresenter Content="{Binding Red}" ContentTemplate="{StaticResource BracketCornerTemplate}" />
                    <ContentPresenter Content="{Binding Blue}" ContentTemplate="{StaticResource BracketCornerTemplate}" />
                    <TextBlock Text="{Binding How}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Aside}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneWarn}" TextWrapping="Wrap"
                               Visibility="{Binding HasAside, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- A chapter of the sport's story (ChapterCard): who it was about, the headline the world read, the
             telling, and what it opened. The Briefing and The Story So Far both use it. A chapter the player's
             house wrote is edged in its accent. -->
        <Style x:Key="ChapterCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsYours}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ChapterCardTemplate">
            <Border Style="{StaticResource ChapterCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="pic" Width="72" Height="72" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top" Margin="0,2,14,0"
                            Background="{StaticResource SurfaceSunken}">
                        <Image x:Name="img" Source="{Binding Picture}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock x:Name="yours" DockPanel.Dock="Right" Text="{Binding YoursText}" Style="{StaticResource Text.Kicker}" FontSize="10.5"
                                       Foreground="{DynamicResource OrgAccent}" Margin="10,0,0,0" />
                            <TextBlock Style="{StaticResource Text.Kicker}" FontSize="10.5" Foreground="{StaticResource Gold}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Heading}" FontSize="16" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Body}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0" />
                        <TextBlock x:Name="who" Text="{Binding Who}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource TextSoft}" Margin="0,6,0,0" />
                        <TextBlock x:Name="opened" Text="{Binding Opened}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock x:Name="note" Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontStyle="Italic" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPicture}" Value="False"><Setter TargetName="pic" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding PictureIsLogo}" Value="True"><Setter TargetName="img" Property="Stretch" Value="Uniform" /><Setter TargetName="img" Property="Margin" Value="6" /></DataTrigger>
                <DataTrigger Binding="{Binding IsYours}" Value="False"><Setter TargetName="yours" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasWho}" Value="False"><Setter TargetName="who" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasOpened}" Value="False"><Setter TargetName="opened" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasNote}" Value="False"><Setter TargetName="note" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- A reform of the house rules (ReformCard, HQ): what it does and buys, and Adopt (it asks first), or
             why not yet. The Adopt button runs the ItemsControl's DataContext.AdoptReformCommand. -->
        <DataTemplate x:Key="ReformCardTemplate">
            <Border x:Name="card" Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="kicker" Text="{Binding Kicker}" Style="{StaticResource Text.Kicker}" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="14.5" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ItemsControl x:Name="buys" ItemsSource="{Binding Buys}" ItemTemplate="{StaticResource RuleLineTemplate}" Focusable="False" Margin="0,6,0,0" />
                    <TextBlock x:Name="why" Text="{Binding Refusal}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource ToneWarn}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <Button x:Name="adopt" Content="Adopt it…" Style="{StaticResource Button.Soft}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,5" FontSize="12.5"
                            Command="{Binding DataContext.AdoptReformCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Chapter}" ToolTip="Asks first: a reform can't be undone" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanAdopt}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource OrgAccent}" />
                    <Setter TargetName="kicker" Property="Foreground" Value="{StaticResource ToneGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanAdopt}" Value="False"><Setter TargetName="adopt" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasRefusal}" Value="False"><Setter TargetName="why" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasBuys}" Value="False"><Setter TargetName="buys" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================================================================== RINGSIDE
             The observer's screens (an Origins world with no house of the player's): Ringside, the founding
             window and the open tryout.
               RingsideStopBanner        Border: why the clock stopped while watching (Tag=True: a big moment).
               FoundCard                 Border: the standing call to found a promotion (gold edge).
               RingsideHouseTemplate     RingsideHouse: logo, owner face, where, what its nights are, public standing.
               RingsideNightTemplate     RingsideNight: a past or coming night as one card line (opens the event).
               RingsideSceneTemplate     RingsideScene: one national scene, when it woke and what it holds.
               FoundingCityTemplate      FoundingCityRow: a city in the founding list (refused ones greyed, reason as tooltip).
               TryoutManTemplate         TryoutManCard: a man the open tryout signed (face, age, division, scouts' read).
               TryoutNote                Border: the sim's reason no tryout is on offer (warm, quiet).
               FoundingLineToggle        ToggleButton: one weight line in the founding picker (gold when it opens;
                                         a locked line keeps the gold and shows no hover).
               FoundingLineTemplate      FoundingLine: name, and what it is (first split / your purse can staff it / beyond).
               FoundingLineGroupTemplate FoundingLineGroup: a ladder chapter's title over its lines, in the sport's order.
             ===================================================================== -->
        <Style x:Key="RingsideStopBanner" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToneInfoDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToneInfo}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ToneWarnDim}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FoundCard" TargetType="Border">
            <Setter Property="Background" Value="#211D14" />
            <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <DataTemplate x:Key="RingsideHouseTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,10" Command="{x:Static mvvm:AppCommands.OpenOrg}"
                    CommandParameter="{Binding Id}" ToolTip="Open the promotion's page">
                <Grid Margin="12,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="68" Height="68" CornerRadius="10" Background="#14171C" VerticalAlignment="Top">
                        <Image Source="{Binding Logo}" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <DockPanel>
                            <Border x:Name="trend" DockPanel.Dock="Right" Background="{StaticResource ToneGoodDim}" CornerRadius="{StaticResource Radius.Pill}" Padding="8,1" VerticalAlignment="Center">
                                <TextBlock x:Name="trendText" Text="{Binding Trend}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ToneGood}" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" FontSize="16.5" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ContentControl x:Name="owner" Style="{StaticResource PersonFace}" Content="{Binding OwnerName}" Width="24" Height="24" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Byline}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />

                        </StackPanel>
                        <TextBlock Text="{Binding Night}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" LineHeight="18" />
                        <TextBlock Text="{Binding Standing}" Style="{StaticResource Text.Caption}" Margin="0,5,0,0" />
                        <TextBlock x:Name="champ" Text="{Binding Champion}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Gold}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasTrend}" Value="False"><Setter TargetName="trend" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding TrendTone}" Value="Warn">
                    <Setter TargetName="trend" Property="Background" Value="{StaticResource ToneWarnDim}" />
                    <Setter TargetName="trendText" Property="Foreground" Value="{StaticResource ToneWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasOwner}" Value="False"><Setter TargetName="owner" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding HasChampion}" Value="False"><Setter TargetName="champ" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="RingsideNightTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,0,6" Command="{x:Static mvvm:AppCommands.OpenEvent}"
                    CommandParameter="{Binding Id}" ToolTip="Open the night">
                <DockPanel Margin="10,8">
                    <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" FontSize="13.5" />
                        <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" FontSize="11.5" />
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RingsideSceneTemplate">
            <Border Background="{StaticResource CardFill}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="11,7" Margin="0,0,0,6">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="tag" DockPanel.Dock="Right" Background="{StaticResource ToneWarnDim}" CornerRadius="{StaticResource Radius.Pill}" Padding="7,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.Heading}" FontSize="13.5">
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Since, Mode=OneWay}" FontSize="11.5" FontWeight="Normal" Foreground="{StaticResource TextMuted}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="11.5" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SecondCentre}" Value="False"><Setter TargetName="tag" Property="Visibility" Value="Collapsed" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="FoundingCityTemplate">
            <DockPanel x:Name="row" Margin="2,4" ToolTip="{Binding Refusal}" ToolTipService.ShowOnDisabled="True">
                <TextBlock x:Name="mark" DockPanel.Dock="Right" Text="{Binding Tag}" Style="{StaticResource Text.Caption}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="name" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Caption}" FontSize="11.5" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Open}" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="TryoutManTemplate">
            <Button Style="{StaticResource CardButton}" Margin="0,0,10,10" Width="290" Command="{x:Static mvvm:AppCommands.OpenFighter}"
                    CommandParameter="{Binding Id}" ToolTip="Open the profile">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="70" Height="84" CornerRadius="8,0,0,8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}">
                        <Image Source="{Binding Face.Image}" Stretch="UniformToFill" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,8,8,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" />
                        <controls:RatingBadge Value="{Binding Scout}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <Style x:Key="TryoutNote" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToneWarnDim}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FoundingLineToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{StaticResource Track}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1.5"
                                CornerRadius="{StaticResource Radius.Card}" Padding="10,6" Margin="0,0,8,8" Width="168">
                            <DockPanel>
                                <TextBlock x:Name="tick" DockPanel.Dock="Left" Text="○" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextMuted}" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextSecondary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2414" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                                <Setter TargetName="tick" Property="Text" Value="●" />
                                <Setter TargetName="tick" Property="Foreground" Value="{StaticResource Gold}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="tick" Property="Text" Value="■" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FoundingLineTemplate">
            <ToggleButton Style="{StaticResource FoundingLineToggle}" IsChecked="{Binding On}" IsEnabled="{Binding CanToggle}"
                          ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    <TextBlock x:Name="note" Text="{Binding Note}" Style="{StaticResource Text.Caption}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ToggleButton>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Suggested}" Value="True"><Setter TargetName="note" Property="Foreground" Value="{StaticResource Gold}" /></DataTrigger>
                <DataTrigger Binding="{Binding Beyond}" Value="True"><Setter TargetName="note" Property="Foreground" Value="{StaticResource ToneBad}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="FoundingLineGroupTemplate">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" FontSize="11.5" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource FoundingLineTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

    </Application.Resources>
</Application>
