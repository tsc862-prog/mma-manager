<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MmaManager.Wpf</RootNamespace>
    <AssemblyName>MmaManager.Wpf</AssemblyName>
  </PropertyGroup>

  <!-- The player-facing UI (Windows-only, WPF). A viewer bound on top of the
       headless sim: it references everything and is referenced by nothing. -->
  <ItemGroup>
    <ProjectReference Include="..\Core.Model\Core.Model.csproj" />
    <ProjectReference Include="..\Core.Sim\Core.Sim.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
  </ItemGroup>

  <!-- Bundled fighter art. Assets\Painted is the AI-painted pack (approved
       identities shipped by the separate FighterArt project at E:/FighterArt via
       sync/syncassets.py; face + body per life stage). Loaders degrade gracefully
       when a folder is absent. -->
  <ItemGroup>
    <Content Include="Assets\Faces\**\*.*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Faces')" />
    <Content Include="Assets\Painted\**\*.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Painted')" />
    <!-- Grey "no portrait yet" placeholders (per weight class × sex, face+body),
         used for anonymous LocalTalent fighters. Kept separate from the pack so
         they never enter the identity pool. See Wpf\Art\PlaceholderLibrary.cs -->
    <Content Include="Assets\Placeholders\**\*.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Placeholders')" />
    <!-- pack metadata, written by E:/FighterArt/sync/syncassets.py: manifest.json is
         the source of truth (identities, tags, cultures); tags.json is the
         legacy sidecar kept for packs without a manifest -->
    <Content Include="Assets\Painted\manifest.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Painted\manifest.json')" />
    <Content Include="Assets\Painted\tags.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Assets\Painted\tags.json')" />
  </ItemGroup>

</Project>
