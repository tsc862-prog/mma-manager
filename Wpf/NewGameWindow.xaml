<Window x:Class="MmaManager.Wpf.NewGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Game" Width="900" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16191E" ShowInTaskbar="False">
    <Border x:Name="Root" Background="{StaticResource Bg}" Padding="22,18">
        <StackPanel>
            <TextBlock Text="START A NEW CAREER" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <TextBlock Text="Build a fight promotion from nothing, take the keys to an established one, or go back to 1993 and the night the sport began."
                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14" />

            <!-- ============ Found a new promotion ============ -->
            <RadioButton x:Name="FoundMode" IsChecked="True" Foreground="{StaticResource TextPrimary}" Checked="OnModeChanged">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Found a new promotion" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Zero to hero: a small bankroll, the fighters nobody signed, and everything to prove."
                               Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                </StackPanel>
            </RadioButton>

            <Border x:Name="FoundPanel" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="14,10" Margin="22,8,0,14"
                    IsEnabled="{Binding IsChecked, ElementName=FoundMode}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Promotion name" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Text="New Wave Fighting" Margin="0,0,14,8" />
                    <TextBlock Grid.Column="2" Text="Abbreviation" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" />
                    <TextBox x:Name="AbbrevBox" Grid.Column="3" Text="NWF" MaxLength="5" CharacterCasing="Upper" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Text="Home region" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" />
                    <ComboBox x:Name="RegionBox" Grid.Row="1" Grid.Column="1" Margin="0,0,14,8" SelectionChanged="OnRegionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Starting scale" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" />
                    <ComboBox x:Name="ScaleBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" SelectionChanged="OnScaleChanged" />

                    <TextBlock Grid.Row="2" Text="Home town" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" />
                    <ComboBox x:Name="CityBox" Grid.Row="2" Grid.Column="1" Margin="0,0,14,8"
                              ToolTip="Where your fans are: the town you draw best in, and the default stop on every card" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                               Text="The capital is the biggest market — a smaller town is a quieter start."
                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock x:Name="ScaleBlurb" Grid.Row="3" Grid.ColumnSpan="4"
                               Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- ============ Take over an existing promotion ============ -->
            <RadioButton x:Name="TakeoverMode" Foreground="{StaticResource TextPrimary}" Checked="OnModeChanged">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Take over an existing promotion" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Skip the climb and run one of the world's established organizations."
                               Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                </StackPanel>
            </RadioButton>

            <Border x:Name="TakeoverPanel" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="6" Margin="22,8,0,14"
                    IsEnabled="{Binding IsChecked, ElementName=TakeoverMode}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="TakeoverBox" BorderThickness="0" Background="Transparent" MaxHeight="380"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <!-- whose house: the owner's face (initials when there is no portrait yet) -->
                                    <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0">
                                        <ContentControl Style="{StaticResource PersonFace}" Content="{Binding OwnerName}" Width="30" Height="30"
                                                        Visibility="{Binding HasOwner, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- the house you'd be taking: who you'd answer to, and its story -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceSunken}" CornerRadius="{StaticResource Radius.Card}" Padding="14,12" Margin="8,0,0,0"
                            DataContext="{Binding SelectedItem, ElementName=TakeoverBox}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="356">
                            <StackPanel>
                                <ContentControl Content="{Binding OwnerCard}" ContentTemplate="{StaticResource PersonCardTemplate}" Focusable="False" Margin="0,0,0,12"
                                                Visibility="{Binding HasOwner, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="THE HOUSE" Style="{StaticResource Text.Kicker}" FontSize="10.5" Visibility="{Binding HasLore, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Lore}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,0"
                                           Visibility="{Binding HasLore, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Origins: the birth of the sport ============ -->
            <RadioButton x:Name="OriginsMode" Foreground="{StaticResource TextPrimary}" Checked="OnModeChanged" Unchecked="OnModeChanged">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Origins: 1 January 1993" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="The sport has no name yet. Three tiny promotions on three continents, no weight classes, no television deals, no rulebook anyone agrees on. Run one of them, or watch from ringside and found your own."
                               Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>

            <Border x:Name="OriginsPanel" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="22,8,0,14" Visibility="Collapsed">
                <StackPanel>
                    <!-- the three houses -->
                    <ListBox x:Name="HouseBox" BorderThickness="0" Background="Transparent" SelectionChanged="OnHouseChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{StaticResource SurfaceSunken}" Margin="0,0,9,0">
                                        <Image Source="{Binding FounderFace}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Place}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- or no house at all: watch from ringside, found your own later -->
                    <ToggleButton x:Name="RingsideTile" Margin="2,8,2,0" Checked="OnRingsideChanged" Unchecked="OnRingsideChanged" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="b" Background="{StaticResource SurfaceSunken}" BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Card}" Padding="12,9">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="#211D14" BorderBrush="{StaticResource Gold}" BorderThickness="1" Margin="0,0,11,0">
                                            <TextBlock Text="🔔" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Or watch from ringside" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="No company yet: all three houses are someone else's. Found your own whenever you're ready."
                                                       Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}" />
                                        <Setter TargetName="b" Property="Background" Value="#211D14" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- watching: what it means, and the three houses you would be watching -->
                    <Grid x:Name="RingsideDetail" Margin="2,12,2,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Watch from ringside" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"
                                       Text="You start with no company. Take a seat on 1 January 1993 and watch the sport take shape: the three houses run their nights, the story turns its chapters, the first names get made. When you're ready, and there is no deadline, found your own promotion in any city with a scene and room for one. You open with a newcomer's bank, an empty roster and one free open tryout of local men." />
                            <TextBlock Text="While you watch, you see what the public sees: nobody scouts for you yet, and there is no inbox until you have a house."
                                       Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" x:Name="RingsideFaces" Margin="18,2,0,0" VerticalAlignment="Top" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="96" Margin="6,0,0,0">
                                        <Border Width="84" Height="84" CornerRadius="42" ClipToBounds="True" Background="{StaticResource SurfaceSunken}" HorizontalAlignment="Center">
                                            <Image Source="{Binding FounderFace}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding FounderName}" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- the chosen house: who, where, what they think this is, its rules, its bank -->
                    <Grid x:Name="HouseDetail" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Width="150" Height="150" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceSunken}"
                                    ToolTip="{Binding FounderBio}" ToolTipService.ShowDuration="60000">
                                <Image Source="{Binding FounderFace}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding FounderName}" FontWeight="SemiBold" FontSize="13.5" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding FounderLine}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            <TextBlock Text="{Binding FounderLead}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,5,0,0" ToolTip="{Binding FounderBio}" ToolTipService.ShowDuration="60000" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding Logo}" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="{Binding Place, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Since, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Room, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Niche}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding Lore}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="THE HOUSE RULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource RuleLineTemplate}" Focusable="False" />
                            <TextBlock Margin="0,6,0,0" FontSize="12.5">
                                <Run Text="Opening bank " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding Bank, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Seed + go ============ -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="World seed" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                <TextBox x:Name="SeedBox" Grid.Column="1" VerticalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0"
                           Foreground="{StaticResource Negative}" TextWrapping="Wrap" />
                <Button Grid.Column="3" Content="Cancel" IsCancel="True" MinWidth="80" />
                <Button Grid.Column="4" Content="Start" IsDefault="True" MinWidth="100" FontWeight="SemiBold"
                        Foreground="{StaticResource Gold}" Click="OnStart" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
