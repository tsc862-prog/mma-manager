<Window x:Class="MmaManager.Wpf.FoundPromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Found your promotion" Width="1120" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16191E" ShowInTaskbar="False">
    <!-- FOUND YOUR PROMOTION (Origins, from ringside): a name, a home city from the ones the sim allows today and what
         each means, the rules the era leaves to him there, and what he opens with, all said before the doors open.
         DataContext = FoundingViewModel. A refusal comes back in the sim's words under the button. -->
    <Border x:Name="Root" Background="{StaticResource Bg}" BorderThickness="0,3,0,0" BorderBrush="{StaticResource Gold}" Padding="22,16,22,16">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="FOUND YOUR PROMOTION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                <TextBlock Text="Open the doors" Style="{StaticResource Text.Display}" FontSize="28" />
                <TextBlock Text="A name, a home and the house rules. The money and the standing are a newcomer's; the fighters are yours to find."
                           Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Commit -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Open the doors…" Command="{Binding FoundCommand}" Style="{StaticResource Button.Primary}"
                        IsDefault="True" Padding="18,8" FontSize="14" Margin="10,0,0,0"
                        ToolTip="Asks once more first: there is no going back to ringside" />
                <Button DockPanel.Dock="Right" Content="Not yet" IsCancel="True" MinWidth="96" Padding="12,8" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BlockReason}" Style="{StaticResource Text.Note}" Foreground="{StaticResource ToneWarn}" FontSize="12.5" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Note}" Foreground="{StaticResource ToneBad}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="290" />
                </Grid.ColumnDefinitions>

                <!-- Name and home -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Name" Style="{StaticResource Text.Kicker}" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="0,3,0,10" MaxLength="40" />
                        <TextBlock Text="Abbreviation" Style="{StaticResource Text.Kicker}" />
                        <DockPanel Margin="0,3,0,12">
                            <TextBox Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" Width="96" FontSize="14" MaxLength="5" CharacterCasing="Upper" />
                            <TextBlock Text="suggested from the name; type your own" Style="{StaticResource Text.Caption}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="Home city" Style="{StaticResource Text.Kicker}" Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ElsewhereLine}" Style="{StaticResource Text.Note}" FontSize="11" Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" ItemTemplate="{StaticResource FoundingCityTemplate}"
                             Background="{StaticResource SurfaceSunken}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>

                <!-- The city, and its rules -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding CityTitle}" Style="{StaticResource Text.Title}" FontSize="22" />
                        <TextBlock Text="{Binding CityMarket}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CityScene}" Style="{StaticResource Text.Note}" Foreground="{StaticResource TextSoft}" FontSize="12.5" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding CityNeighbours}" Style="{StaticResource Text.Note}" Foreground="{StaticResource TextSoft}" FontSize="12.5" Margin="0,3,0,0" />
                        <Border Background="{StaticResource ToneWarnDim}" CornerRadius="{StaticResource Radius.Card}" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding CityClosed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CityRefusal}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource ToneWarn}" />
                        </Border>

                        <TextBlock Text="THE HOUSE RULES HERE" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource Gold}" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding RuleNotes}" ItemTemplate="{StaticResource RuleLineTemplate}" Focusable="False" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="A bout" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,8"
                                       Visibility="{Binding HasMinuteChoice, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MinuteChoices}" SelectedItem="{Binding Minutes}" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"
                                      Visibility="{Binding HasMinuteChoice, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Row="1" Text="Hands" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,8"
                                       Visibility="{Binding HasGloveChoice, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GloveChoices}" SelectedItem="{Binding Gloves}" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"
                                      Visibility="{Binding HasGloveChoice, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Row="2" Text="Where" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,8"
                                       Visibility="{Binding HasEnclosureChoice, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EnclosureChoices}" SelectedItem="{Binding Enclosure}" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"
                                      Visibility="{Binding HasEnclosureChoice, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- What he opens with, said plainly before he commits -->
                <Border Grid.Column="4" Style="{StaticResource FoundCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="WHAT YOU OPEN WITH" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource Gold}" />
                        <TextBlock Text="{Binding Bank}" Style="{StaticResource Text.Display}" FontSize="30" Foreground="{StaticResource Gold}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Secondary}">
                            <Run Text="in the bank  ·  prestige " /><Run Text="{Binding Prestige, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </TextBlock>
                        <TextBlock Text="{Binding StartLine}" Style="{StaticResource Text.Secondary}" LineHeight="18" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Divisions}" Style="{StaticResource Text.Secondary}" LineHeight="18" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LateLine}" Style="{StaticResource Text.Secondary}" LineHeight="18" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
