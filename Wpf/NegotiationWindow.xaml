<Window x:Class="MmaManager.Wpf.NegotiationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Negotiating Room" Width="1060" Height="700" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
    <Window.Resources>
        <!-- A reaction bullet colored by how the term landed -->
        <Style x:Key="FeelDot" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="●" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Feel}" Value="Close">
                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feel}" Value="Sore">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom bar: leave quietly -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Leave the room" IsCancel="True" MinWidth="120" />
                <TextBlock Text="Nothing is committed until the paper is signed."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Left: who, the room's temperature, the transcript ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="84" Height="84" CornerRadius="6" Background="{StaticResource SurfaceAlt}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" VerticalAlignment="Top">
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StanceLine}" FontStyle="Italic" Foreground="#D6DADF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AskWhy}" Style="{StaticResource BondLineText}" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding BondLine}" Style="{StaticResource BondLineText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Mood + patience -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mood" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding Mood, Mode=OneWay}" Maximum="100" Height="9" Margin="0,3">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MoodLabel}" Value="Testy">
                                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MoodLabel}" Value="Insulted">
                                                <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MoodLabel}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Patience" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatienceText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource Gold}" ToolTip="Rounds of goodwill left before they walk" />
                        </Grid>

                        <TextBlock Text="THE TALKS" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    </StackPanel>

                    <!-- Transcript -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="TranscriptScroll">
                        <ItemsControl ItemsSource="{Binding Transcript}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,7" FontSize="12">
                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=":  " /><Run Text="{Binding Line, Mode=OneWay}" />
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#D6DADF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="You">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Good">
                                                        <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Info">
                                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Right: the deal on the table ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="THE DEAL ON THE TABLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

                        <Grid IsEnabled="{Binding CanTalk}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="YOUR OFFER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="THEIR POSITION" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Purse / fight  $" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OfferPurse, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TheirPurse}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Win bonus  $" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OfferWinBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TheirWinBonus}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Signing bonus  $" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OfferSigningBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding TheirSigning}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Fights" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OfferFights, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding TheirFights}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Perf. bonus  $" VerticalAlignment="Center"
                                       ToolTip="Discretionary Fight/Finish-of-the-Night money — counts toward the deal's worth" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OfferPerfBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Margin="0,2" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="PPV points" VerticalAlignment="Center"
                                       ToolTip="A slice of pay-per-view buys — big-league money that sweetens any offer" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OfferPpvPoints, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding CanTalk}">
                            <CheckBox Content="Exclusive" IsChecked="{Binding OfferExclusive}" VerticalAlignment="Center"
                                      ToolTip="Ties them to your cards only — a non-exclusive deal runs ~20% cheaper" />
                            <CheckBox Content="Champion's clause" IsChecked="{Binding OfferChampionsClause}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="A title win auto-extends the deal — a leash they charge ~8% extra to wear" />
                        </StackPanel>

                        <TextBlock Text="{Binding OfferTotalLine}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="🤝 Table the offer" Command="{Binding TableOfferCommand}" Padding="16,4" FontWeight="Bold"
                                    Foreground="{StaticResource Gold}" BorderBrush="{StaticResource Gold}" />
                            <Button Content="Split the difference" Command="{Binding SplitCommand}" Margin="8,0,0,0"
                                    ToolTip="Halve the gap on every money lever (doesn't table it yet)" />
                            <Button Content="Meet their terms" Command="{Binding MeetTermsCommand}" Margin="8,0,0,0"
                                    ToolTip="Give them their current position — closes the deal on the spot" />
                            <Button Content="Walk away" Command="{Binding WalkAwayCommand}" Margin="8,0,0,0"
                                    Foreground="{StaticResource Negative}"
                                    ToolTip="Leave the table on good terms — you can reopen talks any time" />
                        </StackPanel>

                        <TextBlock Text="HOW IT LANDED" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                    </StackPanel>

                    <!-- Per-term reactions to the last tabled offer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Reactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Style="{StaticResource FeelDot}" />
                                        <TextBlock Text="{Binding Term}" FontWeight="SemiBold" FontSize="12" Width="120" />
                                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
