<Window x:Class="MmaManager.Wpf.NegotiationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MmaManager.Wpf.Controls"
        Title="The Table" Width="1320" Height="820" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
    <!-- Owner, 2026-11-15: read at a glance. Numbers and short labels on the paper;
         the sentences behind them are tooltips. -->
    <Window.Resources>
        <!-- A reaction bullet colored by how the term landed -->
        <Style x:Key="FeelDot" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="●" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,3,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Positive}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Feel}" Value="Close">
                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Feel}" Value="Sore">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One promise: ONE line. The toggle (and the activity picker) on the left, what it does
             to his number (or why he won't take it) as a chip on the right; the words on hover. -->
        <DataTemplate x:Key="SlipPromiseRow">
            <DockPanel Margin="0,7,0,0" Background="Transparent" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True">
                <ContentPresenter DockPanel.Dock="Right" Content="{Binding Chip}" ContentTemplate="{StaticResource SlipChipView}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsEnabled="{Binding Allowed}"
                              Style="{StaticResource Slip.Promise}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Picks}" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasPicks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Style>
                            <!-- Faint until the promise is written in (picking a number writes it in) -->
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="PromisedFights" Content="{Binding Text}" IsChecked="{Binding IsChecked}"
                                             IsEnabled="{Binding Allowed}" Style="{StaticResource Slip.Pick}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom bar: leave quietly -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Leave the table" IsCancel="True" Style="{StaticResource Button.Ghost}"
                        ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Get up for now — he remembers where you left it'}" />
                <TextBlock Text="Nothing is committed until the paper is signed." Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Leave and come back: he remembers where you left it.'}" />
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ HIM: the photo, who he is, how he's sitting ============ -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="330">
                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10,10,0,0" ClipToBounds="True">
                            <Image Source="{Binding Portrait}" Stretch="UniformToFill" VerticalAlignment="Top" />
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="170" CornerRadius="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#001B2028" Offset="0" />
                                    <GradientStop Color="#C01B2028" Offset="0.55" />
                                    <GradientStop Color="#FF1B2028" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,10">
                            <TextBlock Text="{Binding Occasion}" Style="{StaticResource Text.MomentKicker}" FontSize="12" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="26" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Nickname}" Style="{StaticResource Text.Note}" FontStyle="Italic" Foreground="{StaticResource TextSoft}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource Chip.Text}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="AT THE TABLE" Style="{StaticResource Text.Kicker}" Margin="0,10,0,6" />
                            <TextBlock Text="{Binding Stance}" Style="{StaticResource Text.Heading}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Chip}" Margin="0" VerticalAlignment="Center"
                                        Background="{Binding MoodTone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                                    <TextBlock Style="{StaticResource Chip.Text}" FontWeight="SemiBold"
                                               Foreground="{Binding MoodTone, Converter={StaticResource ToneBrush}}">
                                        <Run Text="Mood: " /><Run Text="{Binding MoodLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                            ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Rounds of goodwill left before he walks out'}">
                                    <TextBlock Text="Patience" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding PatienceDots}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse x:Name="dot" Width="9" Height="9" Margin="0,0,4,0" Stroke="{StaticResource Gold}" StrokeThickness="1.3" Fill="{StaticResource Gold}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="False">
                                                        <Setter TargetName="dot" Property="Fill" Value="Transparent" />
                                                        <Setter TargetName="dot" Property="Stroke" Value="{StaticResource TextMuted}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding BondLine}" Style="{StaticResource BondLineText}" Margin="0,10,0,0" />

                            <!-- What drives his number: three at most on the surface, the rest on hover -->
                            <TextBlock Text="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='WHAT DRIVES HIS NUMBER'}" Style="{StaticResource Text.Kicker}" Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding ReasonsShown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{DynamicResource OrgAccent}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ReasonsMoreText}" FontSize="11.5" Foreground="{DynamicResource OrgAccent}" Margin="13,0,0,0"
                                       Cursor="Help" ToolTip="{Binding ReasonsMoreTip}"
                                       Visibility="{Binding HasMoreReasons, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding AskShort}" Style="{StaticResource Text.Note}" Margin="0,6,0,0" Cursor="Help" ToolTip="{Binding AskWhy}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ THE PAPERWORK: your slip, their paper, the promises ============ -->
            <DockPanel Grid.Column="2">
            <!-- What you can do: always in view, under the paperwork -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                    <StackPanel>
                    <WrapPanel>
                        <Button Content="Table the offer" Command="{Binding TableOfferCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"
                                ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Slide the slip across and hear his answer'}" />
                        <Button Content="Split the difference" Command="{Binding SplitCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                ToolTip="Halve the gap on every money line (doesn't table it yet)" />
                        <Button Content="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Meet his number'}" Command="{Binding MeetTermsCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Write in his current number and table it — he signs on the spot'}" />
                        <Button Content="{Binding PutInWritingText}" Command="{Binding PutInWritingCommand}" Style="{StaticResource Button.Soft}" Margin="0,0,8,8"
                                Visibility="{Binding CanPutInWriting, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Lodge this slip as your final offer: he weighs it against their paper, they get one chance to come back, and you hear within the week. Asks first.'}" />
                        <Button Content="{Binding MatchText}" Command="{Binding MatchCommand}" Style="{StaticResource Button.Soft}" Margin="0,0,8,8"
                                Visibility="{Binding CanMatch, Converter={StaticResource BoolToVis}}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Re-sign him now on their length and bonuses, at the purse that beats their paper by his lights. Asks first.'}" />
                        <Button Content="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Let him go'}" Command="{Binding LetGoCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                Foreground="{StaticResource Negative}"
                                Visibility="{Binding CanLetGo, Converter={StaticResource BoolToVis}}"
                                ToolTip="Answer their paper with no — asks first" />
                        <Button Content="Walk away" Command="{Binding WalkAwayCommand}" Style="{StaticResource Button.Link}" Margin="4,0,8,8"
                                Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                ToolTip="Leave on good terms — the door stays open" />
                    </WrapPanel>
                    <!-- Why "Match it" is off: the bank, in plain words -->
                    <TextBlock Text="{Binding MatchBlocked}" Style="{StaticResource Text.Note}" Foreground="{StaticResource ToneBad}" Margin="0,0,0,4" />
                    </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="2,0,0,10">
                        <!-- How the table works: one "?" instead of a paragraph -->
                        <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BorderStrong}"
                                Cursor="Help" Background="Transparent" Margin="0,0,4,0"
                                ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='How it works: write your terms on the slip and table them. His number is pencilled beside each line; every round you bargain in good faith it comes down a little, and a lowball costs you his mood and patience.'}">
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="THE PAPERWORK" Style="{StaticResource Text.Kicker}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                        <!-- Your slip: what you write, his number pencilled beside it -->
                        <Border Style="{StaticResource Slip}" Padding="16,12,16,10" Margin="0,2,0,8">
                            <StackPanel IsEnabled="{Binding CanTalk}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="5" Background="#14171C" Margin="8,0,0,0">
                                        <Image Source="{Binding PlayerLogo}" Stretch="Uniform" Margin="3" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="YOUR OFFER" Style="{StaticResource Slip.Kicker}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Slip.Title}" ToolTip="{Binding SlipTitle}" />
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Height="1" Fill="{StaticResource TableRule}" Margin="0,8,0,0" />

                                <TextBlock Text="PURSE A FIGHT" Style="{StaticResource Slip.Label}" />
                                <DockPanel>
                                    <TextBlock Text="$" Style="{StaticResource Slip.Value}" VerticalAlignment="Center" Margin="0,0,4,0" Width="9" /><TextBox Width="110" Style="{StaticResource Slip.Field}" Text="{Binding OfferPurse, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                                    <TextBlock Style="{StaticResource Slip.Note}"><Run Text="wants " /><Run Text="{Binding HisPurse, Mode=OneWay}" /></TextBlock>
                                </DockPanel>

                                <TextBlock Text="WIN BONUS" Style="{StaticResource Slip.Label}" />
                                <DockPanel>
                                    <TextBlock Text="$" Style="{StaticResource Slip.Value}" VerticalAlignment="Center" Margin="0,0,4,0" Width="9" /><TextBox Width="110" Style="{StaticResource Slip.Field}" Text="{Binding OfferWinBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                                    <TextBlock Style="{StaticResource Slip.Note}"><Run Text="wants " /><Run Text="{Binding HisWinBonus, Mode=OneWay}" /></TextBlock>
                                </DockPanel>

                                <TextBlock Text="SIGNING BONUS" Style="{StaticResource Slip.Label}" />
                                <DockPanel>
                                    <TextBlock Text="$" Style="{StaticResource Slip.Value}" VerticalAlignment="Center" Margin="0,0,4,0" Width="9" /><TextBox Width="110" Style="{StaticResource Slip.Field}" Text="{Binding OfferSigningBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                                    <TextBlock Style="{StaticResource Slip.Note}" Text="{Binding HisSigning}" />
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Slip.Label}"><Run Text="FIGHTS " /><Run Text="{Binding HisFights, Mode=OneWay}" Foreground="{StaticResource TablePencil}" FontStyle="Italic" FontWeight="Normal" /></TextBlock>
                                        <TextBox Style="{StaticResource Slip.Field}" FontSize="14" Text="{Binding OfferFights, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PERF. BONUS" Style="{StaticResource Slip.Label}"
                                                   ToolTip="Performance bonus: discretionary Fight/Finish-of-the-Night money, on top of the house bonus" />
                                        <TextBox Style="{StaticResource Slip.Field}" FontSize="14" Text="{Binding OfferPerfBonus, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PPV POINTS" Style="{StaticResource Slip.Label}"
                                                   ToolTip="A slice of pay-per-view buys — worth what your pay-per-views actually take" />
                                        <TextBox Style="{StaticResource Slip.Field}" FontSize="14" Text="{Binding OfferPpvPoints, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Exclusive and the champion's clause: what each does to his number, as chips -->
                                <DockPanel Margin="0,10,0,0" Background="Transparent"
                                           ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Ties him to your cards only. The chip is what it adds to his number on this slip; a non-exclusive deal runs cheaper.'}">
                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding ExclusiveChip}" ContentTemplate="{StaticResource SlipChipView}" VerticalAlignment="Center" />
                                    <CheckBox Content="Exclusive" IsChecked="{Binding OfferExclusive}" Style="{StaticResource Slip.Promise}" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0" Background="Transparent"
                                           ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='A title win auto-extends the deal: a leash he charges extra to wear. The chip is what it adds to his number on this slip.'}">
                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding ClauseChip}" ContentTemplate="{StaticResource SlipChipView}" VerticalAlignment="Center" />
                                    <CheckBox Content="Champion's clause" IsChecked="{Binding OfferChampionsClause}" Style="{StaticResource Slip.Promise}" />
                                </DockPanel>

                                <Rectangle Height="1" Fill="{StaticResource TableRule}" Margin="0,10,0,5" />
                                <TextBlock Text="{Binding OfferTotalLine}" FontSize="11.5" Foreground="{StaticResource TableInkSoft}" TextTrimming="CharacterEllipsis"
                                           Background="Transparent" ToolTip="{Binding OfferTotalTip}" />
                            </StackPanel>
                        </Border>

                        <!-- Which way he leans, when there's paper from a rival -->
                        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,4,0,0"
                                Visibility="{Binding HasLeaning, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='WHICH WAY HE LEANS'}" Style="{StaticResource Text.Kicker}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource LeanSegment}" Tag="{Binding LeansTheirs}" CornerRadius="11,0,0,11">
                                        <TextBlock Style="{StaticResource LeanSegment.Text}">
                                            <Run Text="TO " /><Run Text="{Binding RivalAbbr, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource LeanSegment}" Tag="{Binding LeansTorn}">
                                        <TextBlock Text="TORN" Style="{StaticResource LeanSegment.Text}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource LeanSegment}" Tag="{Binding LeansYours}" CornerRadius="0,11,11,0" Margin="0">
                                        <TextBlock Text="TO YOU" Style="{StaticResource LeanSegment.Text}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LeaningWords}" Style="{StaticResource Text.Secondary}" FontSize="11.5" Margin="0,6,0,0"
                                           MaxHeight="34" TextTrimming="WordEllipsis" Background="Transparent" ToolTip="{Binding LeaningWords}" />
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <!-- Their paper: the rival's letterhead, as he showed it to you (compact) -->
                            <Border Style="{StaticResource Slip}" Background="{StaticResource TablePaperCool}" Padding="16,12,16,12" Margin="0,6,0,0"
                                    VerticalAlignment="Top" Visibility="{Binding HasRival, Converter={StaticResource BoolToVis}}">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="1.2" />
                                </Border.RenderTransform>
                                <Grid>
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="5" Background="#14171C" Margin="0,0,10,0">
                                                <Image Source="{Binding RivalLogo}" Stretch="Uniform" Margin="3" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RivalName}" Style="{StaticResource Slip.Title}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding RivalName}" />
                                                <TextBlock Text="{Binding RivalTier}" Style="{StaticResource Slip.Kicker}" FontWeight="Normal" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Stamp}" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding RivalImproved, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="They have already come back once, answering your offer in writing, and won't go again.">
                                                <TextBlock Text="RAISED · FINAL" Style="{StaticResource Stamp.Text}" FontSize="10.5" />
                                            </Border>
                                            <TextBlock Text="{Binding RivalKicker}" Style="{StaticResource Slip.Kicker}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Rectangle Height="1" Fill="#9AA6B2" Margin="0,5,0,0" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="PURSE A FIGHT" Style="{StaticResource Slip.Label}" />
                                                <TextBlock Text="{Binding RivalPurse}" Style="{StaticResource Slip.Value}" FontSize="18" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="FIGHTS" Style="{StaticResource Slip.Label}" />
                                                <TextBlock Style="{StaticResource Slip.Value}" FontSize="18" ToolTip="{Binding RivalExclusive}">
                                                    <Run Text="{Binding RivalFights, Mode=OneWay}" /><Run Text="{Binding RivalExclusiveShort, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TableInkSoft}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="WIN BONUS" Style="{StaticResource Slip.Label}" />
                                                <TextBlock Text="{Binding RivalWinBonus}" Style="{StaticResource Slip.Value}" FontSize="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="SIGNING BONUS" Style="{StaticResource Slip.Label}" />
                                                <TextBlock Text="{Binding RivalSigning}" Style="{StaticResource Slip.Value}" FontSize="14" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Style="{StaticResource Stamp}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding RivalDeadline}" Style="{StaticResource Stamp.Text}" FontSize="11" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Promises & rights: their own card, one line each -->
                            <Border Style="{StaticResource Slip}" Padding="16,11,16,12" Margin="0,10,0,0">
                                <StackPanel IsEnabled="{Binding CanTalk}">
                                    <DockPanel Background="Transparent" Cursor="Help" ToolTip="{Binding PromisesHelp}">
                                        <TextBlock DockPanel.Dock="Right" Text="?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TableInkSoft}" VerticalAlignment="Center" />
                                        <TextBlock Text="PROMISES &amp; RIGHTS" Style="{StaticResource Slip.Kicker}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding WaryShort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TablePencil}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" Background="Transparent" Cursor="Help" ToolTip="{Binding WaryLine}"
                                               Visibility="{Binding HasWaryLine, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding OpenPromisesShort}" FontSize="11.5" Foreground="{StaticResource TableInkSoft}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" Background="Transparent" Cursor="Help" ToolTip="{Binding OpenPromisesLine}"
                                               Visibility="{Binding HasOpenPromises, Converter={StaticResource BoolToVis}}" />
                                    <Rectangle Height="1" Fill="{StaticResource TableRule}" Margin="0,7,0,0" />
                                    <ContentControl Content="{Binding TitlePromise}" ContentTemplate="{StaticResource SlipPromiseRow}" Focusable="False" />
                                    <ContentControl Content="{Binding HomePromise}" ContentTemplate="{StaticResource SlipPromiseRow}" Focusable="False" />
                                    <ContentControl Content="{Binding ActivityPromise}" ContentTemplate="{StaticResource SlipPromiseRow}" Focusable="False" />
                                    <DockPanel Margin="0,7,0,0" Background="Transparent" ToolTip="{Binding MatchingRightTip}">
                                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding MatchingRightChip}" ContentTemplate="{StaticResource SlipChipView}" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="held now" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TableInkSoft}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasMatchingRightHeld, Converter={StaticResource BoolToVis}}" />
                                        <CheckBox Content="Matching right" IsChecked="{Binding OfferMatchingRight}" Style="{StaticResource Slip.Promise}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- No other paper: he's only talking to you (title and one line) -->
                            <Border Margin="0,10,0,0" VerticalAlignment="Top" CornerRadius="{StaticResource Radius.Card}"
                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="14,10"
                                    Background="{StaticResource PanelFill}" Visibility="{Binding NoRival, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='Take too long and that can change: a promotion that wants him can put an offer in his hand while you talk, and he’ll show it to you here.'}">
                                <DockPanel>
                                    <controls:Icon DockPanel.Dock="Left" Kind="Envelope" Width="26" Height="26" Brush="{StaticResource TextMuted}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="No other paper on the table" Style="{StaticResource Text.Heading}" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="{Binding FirstName, Mode=OneWay}" /><Run Text="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter=' is only talking to you, for now.', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Your final offer, in writing -->
                            <Border Margin="0,10,0,0" CornerRadius="{StaticResource Radius.Card}" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                    Background="{StaticResource ToneWarnDim}" Padding="12,9"
                                    Visibility="{Binding HasFinal, Converter={StaticResource BoolToVis}}" ToolTip="{Binding FinalNote}">
                                <DockPanel>
                                    <controls:Icon DockPanel.Dock="Left" Kind="Document" Width="24" Height="24" Brush="{StaticResource Gold}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="YOUR FINAL OFFER, IN WRITING" Style="{StaticResource Text.Kicker}" Foreground="{StaticResource Gold}" />
                                        <TextBlock Text="{Binding FinalLine}" Style="{StaticResource Text.Heading}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding FinalShort}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- The answer to the last thing you did with the paperwork -->
                    <Border Margin="0,10,0,0" CornerRadius="{StaticResource Radius.Card}" Padding="12,9" BorderThickness="1"
                            BorderBrush="{Binding StatusTone, Converter={StaticResource ToneBrush}}"
                            Background="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=Dim}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" FontSize="13" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </DockPanel>

            <!-- ============ THE TALK: what he says, in his own words ============ -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='IN HIS OWN WORDS'}" Style="{StaticResource Text.Kicker}" />
                        <Border BorderBrush="{DynamicResource OrgAccent}" BorderThickness="3,0,0,0" Padding="12,2,0,2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding HisLine}" Style="{StaticResource Text.Quote}" FontSize="16.5" LineHeight="24" />
                        </Border>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="HOW IT LANDED" Style="{StaticResource Text.Kicker}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Reactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FeelDot}" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                                <Run Text="{Binding Term, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " Foreground="{StaticResource TextMuted}" /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextSoft}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Note}" Margin="0,14,0,0" Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"
                                   Text="Table an offer to hear him out." Background="Transparent"
                                   ToolTip="{Binding IsWoman, Converter={StaticResource Pronouns}, ConverterParameter='He’ll tell you how each term lands. Every exchange is kept here.'}" />
                        <TextBlock Text="THE TALKS SO FAR" Style="{StaticResource Text.Kicker}" Margin="0,16,0,6"
                                   Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="TranscriptScroll" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Transcript}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="bubble" Margin="0,0,24,7" Padding="10,7" CornerRadius="8" Background="{StaticResource CardFill}" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock x:Name="who" Text="{Binding Who}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock x:Name="line" Text="{Binding Line}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="You">
                                            <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="bubble" Property="Margin" Value="24,0,0,7" />
                                            <Setter TargetName="bubble" Property="Background" Value="{DynamicResource OrgAccentDim}" />
                                            <Setter TargetName="line" Property="Foreground" Value="{StaticResource TextSoft}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Good">
                                            <Setter TargetName="bubble" Property="Background" Value="{StaticResource ToneGoodDim}" />
                                            <Setter TargetName="line" Property="Foreground" Value="{StaticResource Positive}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Info">
                                            <Setter TargetName="bubble" Property="Background" Value="Transparent" />
                                            <Setter TargetName="bubble" Property="Margin" Value="0,0,0,7" />
                                            <Setter TargetName="who" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="line" Property="Foreground" Value="{StaticResource Gold}" />
                                            <Setter TargetName="line" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
