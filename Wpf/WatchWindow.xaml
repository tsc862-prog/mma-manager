<Window x:Class="MmaManager.Wpf.WatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MmaManager.Wpf.Views"
        Title="Fight Night" Width="1480" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Header}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Leave the arena" IsCancel="True" MinWidth="120" />
                <TextBlock Text="The results are in the books either way — watching is for the drama."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <views:WatchView />
    </DockPanel>
</Window>
