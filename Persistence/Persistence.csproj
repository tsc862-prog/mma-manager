<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MmaManager.Persistence</RootNamespace>
    <AssemblyName>MmaManager.Persistence</AssemblyName>
  </PropertyGroup>

  <!-- Save/load of the World graph to a SQLite database. References the model only
       (the sim never leaks in here). The reader refuses any version but the current
       one: there are no migrations. Microsoft.Data.Sqlite bundles the native SQLite
       engine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Model\Core.Model.csproj" />
  </ItemGroup>

</Project>
